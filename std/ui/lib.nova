//! Reactivity, and views that update themselves: a signal holds a value,
//! and the effects and memos that read it run again when it changes.
//!
//! It is not in the prelude: a module that uses it imports it, with
//! `import ui` for every name, or `import ui::{signal, effect}` for some.
//! `import ui::html` brings the element builders, `div`, `button`, `text` and
//! the rest, which make the `View`s that `mount` puts into the page and
//! `render_to_string` writes as HTML. A server writes a view with
//! `render_hydratable`, and its client, a WASM build of the same view,
//! adopts that HTML with `hydrate`.
//!
//! `set` runs the effects that read a signal before it returns, each once,
//! and only after every memo it reads is current. A memo computes when it is
//! made, then again when it is read after something it read changed. An
//! effect, a memo, a `root`, and each `mount` own the effects and memos made
//! while they run: running again or being disposed disposes those first,
//! then runs the cleanups `on_cleanup` added, the last added first.
//!
//! The state behind all of this is the thread's, or the page's on WASM, and
//! lives as long as it does. A value read from a signal is the signal's own:
//! changing a record read from one changes the signal without telling
//! anyone, and `set` or `update` is how to tell. A `Signal`'s fields are
//! reachable, as every record's are: its `val` is the value, written without
//! telling anyone, and its `src` holds `std/ui`'s own records, which a
//! program must leave alone.
//!
//! A signal, an effect that reads it, and a view rendered to HTML:
//!
//! ```
//! import ui
//! import ui::html::{div, dyn_text, text}
//!
//! let count = signal(1)
//! let seen = signal(0)
//! effect(|| seen.set(count.value() * 10))
//! count.set(2)
//! assert_eq(seen.value(), 20)
//!
//! let html = render_to_string(|| div([], [text("count: "), dyn_text(|| "${count.value()}")]))
//! assert_eq(html, "<div>count: 2</div>")
//! ```

// The design (spec
// docs/superpowers/specs/2026-10-17-phase-4-3-std-ui-reactivity-and-views-design.md
// §4 to §7). Every computation, root and render is an `Owner`, every signal
// has a `Source`, and both are records, so each refers to the other: a
// source to the computations that read it, a computation to the sources it
// read on its last run. `set` marks what reads the signal dirty and what is
// downstream of that "check"; a queue of effects then runs, each first
// bringing the memos it read up to date, and running only if one of them
// ran or it is dirty itself.

// An owner's kinds.
const ROOT: Int = 0

const EFFECT: Int = 1

const MEMO: Int = 2

// A computation's states: current, maybe stale, and stale.
const CLEAN: Int = 0

const CHECK: Int = 1

const DIRTY: Int = 2

// The effect runs one flush may make before it is taken for a loop.
const SETTLE: Int = 100000

// An effect, a memo, a root, or a region's render.
record Owner {
    id: Int,
    kind: Int,
    state: Int,
    disposed: Bool,
    // The owner that made it, and how many times it has run.
    parent: Option<Owner>,
    runs: Int,
    // What a computation runs: for a memo, it also stores the value.
    run: fn(),
    // What it owns: what it made on its last run, and its cleanups.
    children: Vec<Owner>,
    cleanups: Vec<fn()>,
    // What it read on its last run.
    sources: Vec<Source>,
    // A memo's own source, which its readers subscribe to.
    out: Option<Source>,
}

// What a signal's readers subscribe to.
record Source {
    id: Int,
    observers: Vec<Owner>,
    // The memo whose value this is.
    memo: Option<Owner>,
}

// An `on_mount` callback waiting for its nodes, the owner it was added in,
// and that owner's run then: when the owner is disposed or has run again,
// its nodes are gone before they were in the page.
record Mounted { owner: Option<Owner>, run: Int, f: fn() }

// The state of the thread's or the page's reactivity (spec §4): what is
// running and who owns what it makes, the effects waiting to run, and the
// roots `mount` keeps.
record UiState {
    next_id: Int,
    listener: Option<Owner>,
    owner: Option<Owner>,
    queue: Vec<Owner>,
    batch: Int,
    flushing: Bool,
    roots: Vec<Owner>,
    // How many builds of nodes are in progress, and how many string
    // renders: `on_mount` waits for the one and is dropped by the other.
    building: Int,
    rendering: Int,
    mounted: Vec<Mounted>,
}

fn load_state<T>() -> T { ui_state_load() }

fn store_state<T>(state: T) { ui_state_store(state) }

// The state, made the first time it is asked for.
fn ui() -> UiState {
    if !ui_state_present() {
        store_state(
            UiState {
                next_id: 1,
                listener: None,
                owner: None,
                queue: Vec::new(),
                batch: 0,
                flushing: false,
                roots: Vec::new(),
                building: 0,
                rendering: 0,
                mounted: Vec::new(),
            },
        )
    }
    load_state()
}

fn new_id() -> Int {
    let mut s = ui()
    let id = s.next_id
    s.next_id = id + 1
    id
}

fn new_owner(kind: Int, run: fn()) -> Owner {
    Owner {
        id: new_id(),
        kind: kind,
        state: CLEAN,
        disposed: false,
        parent: None,
        runs: 0,
        run: run,
        children: Vec::new(),
        cleanups: Vec::new(),
        sources: Vec::new(),
        out: None,
    }
}

// Element `i` of `v`, which is in range.
fn at<T>(v: Vec<T>, i: Int) -> T {
    match v.get(i) {
        Some(x) => x
        None => panic("std/ui: an index out of range")
    }
}

// Make `o` a child of the current owner, if there is one. Made under an
// owner already disposed, `o` is disposed too, and never runs.
fn adopt(o: Owner) {
    match ui().owner {
        Some(p) => {
            let mut m = o
            m.parent = Some(p)
            if p.disposed {
                m.disposed = true
            } else {
                let mut kids = p.children
                kids.push(o)
            }
        }
        None => {}
    }
}

// Run `f` with `owner` and `listener` current, then put back what was.
fn with_context<T>(owner: Option<Owner>, listener: Option<Owner>, f: fn() -> T) -> T {
    let mut s = ui()
    let was_owner = s.owner
    let was_listener = s.listener
    s.owner = owner
    s.listener = listener
    let out = f()
    s.owner = was_owner
    s.listener = was_listener
    out
}

// Run `f` with no listener: what it reads subscribes nothing.
fn untracked<T>(f: fn() -> T) -> T { with_context(ui().owner, None, f) }

// Subscribe the current listener to `src`, once, unless it is disposed.
fn track(src: Source) {
    match ui().listener {
        Some(l) => {
            if l.disposed { return }
            let mut i = 0
            while i < l.sources.len() {
                if at(l.sources, i).id == src.id { return }
                i = i + 1
            }
            let mut read = l.sources
            read.push(src)
            let mut obs = src.observers
            obs.push(l)
        }
        None => {}
    }
}

// Mark `o` at least `state`; the first mark queues an effect, and marks a
// memo's readers "check".
fn mark(o: Owner, state: Int) {
    if o.disposed || o.state >= state { return }
    let was = o.state
    let mut m = o
    m.state = state
    if was != CLEAN { return }
    if o.kind == EFFECT {
        let mut q = ui().queue
        q.push(o)
    } else if o.kind == MEMO {
        match o.out {
            Some(src) => mark_all(src, CHECK)
            None => {}
        }
    }
}

fn mark_all(src: Source, state: Int) {
    let mut i = 0
    while i < src.observers.len() {
        mark(at(src.observers, i), state)
        i = i + 1
    }
}

// Run the queue, unless a batch or another flush will.
fn flush() {
    let mut s = ui()
    if s.flushing || s.batch > 0 { return }
    s.flushing = true
    let mut runs = 0
    let mut i = 0
    while i < s.queue.len() {
        let o = at(s.queue, i)
        i = i + 1
        if !o.disposed && o.state != CLEAN {
            runs = runs + 1
            if runs > SETTLE { panic("std/ui: effects did not settle") }
            run_top(o)
        }
    }
    s.queue = Vec::new()
    s.flushing = false
}

// Bring queued effect `o` up to date after its owners: an owner that is
// stale runs first, from the top down, and may dispose of `o`, which then
// does not run. So a child never runs with inputs its parent's next run
// would not give it, whatever order a batch's `set`s queued them in.
fn run_top(o: Owner) {
    let mut stale = Vec::new()
    let mut up = Some(o)
    let mut done = false
    while !done {
        match up {
            Some(x) => {
                if x.state != CLEAN { stale.push(x) }
                up = x.parent
            }
            None => done = true
        }
    }
    let mut i = stale.len() - 1
    while i >= 0 {
        refresh(at(stale, i))
        i = i - 1
    }
}

// Bring `o` up to date: a "check" first brings the memos it read up to
// date, and it runs only if one of them ran or it is dirty.
fn refresh(o: Owner) {
    if o.disposed { return }
    if o.state == CHECK {
        let mut i = 0
        while i < o.sources.len() && o.state == CHECK {
            match at(o.sources, i).memo {
                Some(m) => refresh(m)
                None => {}
            }
            i = i + 1
        }
    }
    if o.state == DIRTY {
        run_owner(o)
    } else {
        let mut m = o
        m.state = CLEAN
    }
}

// Run computation `o`: mark it clean, so that nothing its last run's
// cleanups read runs it again, dispose of what that run made, then run it as
// the listener and the owner. A memo that ran makes its readers dirty, since
// every value counts as a change.
fn run_owner(o: Owner) {
    let mut m = o
    m.state = CLEAN
    m.runs = o.runs + 1
    clean(o)
    let f = o.run
    with_context(Some(o), Some(o), f)
    if o.kind == MEMO {
        match o.out {
            Some(src) => mark_all(src, DIRTY)
            None => {}
        }
    }
}

// Drop `o`'s subscriptions, so that nothing its cleanups set runs it again;
// then dispose of what it owns, last made first, and run its cleanups, last
// added first. Each list is replaced by a new one before it is walked, so
// that what runs meanwhile can neither add to it nor take from it, and so
// that nothing keeps what it held: `Vec::clear` would keep its storage.
fn clean(o: Owner) {
    let mut m = o
    let read = o.sources
    m.sources = Vec::new()
    let mut k = 0
    while k < read.len() {
        drop_observer(at(read, k), o.id)
        k = k + 1
    }
    let kids = o.children
    m.children = Vec::new()
    let mut i = kids.len() - 1
    while i >= 0 {
        dispose(at(kids, i))
        i = i - 1
    }
    let ups = o.cleanups
    m.cleanups = Vec::new()
    let mut j = ups.len() - 1
    while j >= 0 {
        let f = at(ups, j)
        with_context(None, None, f)
        j = j - 1
    }
}

// Mark `o` disposed, so that it never runs again, then clean it.
fn dispose(o: Owner) {
    let mut m = o
    m.disposed = true
    clean(o)
}

// Take the computation `id` out of `src`'s observers, keeping their order,
// into a new list, so that the old one keeps nothing.
fn drop_observer(src: Source, id: Int) {
    let obs = src.observers
    let mut kept = Vec::new()
    let mut i = 0
    while i < obs.len() {
        let x = at(obs, i)
        if x.id != id { kept.push(x) }
        i = i + 1
    }
    if kept.len() < obs.len() {
        let mut m = src
        m.observers = kept
    }
}

/// A value that effects and memos read, and run again when it changes.
pub record Signal<T> { src: Source, val: T }

impl<T> Signal<T> {
    /// The value. Read in an effect or a memo, it subscribes that
    /// computation, which runs again when the value changes.
    pub fn value(self) -> T {
        match self.src.memo {
            Some(m) => { if m.state != CLEAN { batch(|| refresh(m)) } }
            None => {}
        }
        track(self.src)
        self.val
    }

    /// Stores `new_value` and runs what reads the signal: before returning,
    /// or inside `batch` or an effect, once that returns. It does so every
    /// time, even for an equal value. Calling it on a memo's signal panics.
    pub fn set(self, new_value: T) {
        match self.src.memo {
            Some(m) => panic("std/ui: set() on a memo")
            None => {}
        }
        let mut me = self
        me.val = new_value
        mark_all(self.src, DIRTY)
        flush()
    }

    /// Sets the value to `f` of the current one, which it reads without
    /// subscribing.
    pub fn update(self, f: fn(T) -> T) { self.set(f(self.val)) }
}

/// A new signal holding `initial`.
pub fn signal<T>(initial: T) -> Signal<T> {
    Signal { src: Source { id: new_id(), observers: Vec::new(), memo: None }, val: initial }
}

/// Runs `f` now, and again each time a signal it read on its last run
/// changes. The current owner owns it; made under an owner already
/// disposed, it never runs.
pub fn effect(f: fn()) {
    let o = new_owner(EFFECT, f)
    adopt(o)
    if !o.disposed { batch(|| run_owner(o)) }
}

/// A signal whose value is `f`'s: `f` runs now, then again when it is read
/// after a signal it read changed. Its `set` panics.
pub fn memo<T>(f: fn() -> T) -> Signal<T> {
    let mut o = new_owner(MEMO, || {})
    adopt(o)
    let first = with_context(Some(o), Some(o), f)
    let src = Source { id: new_id(), observers: Vec::new(), memo: Some(o) }
    let s = Signal { src: src, val: first }
    o.run = || {
        let mut t = s
        t.val = f()
    }
    o.out = Some(src)
    s
}

/// Adds `f` to the current owner's cleanups: it runs when the owner runs
/// again or is disposed, and at once when the owner is disposed already.
/// Outside an owner it never runs.
pub fn on_cleanup(f: fn()) {
    match ui().owner {
        Some(o) => {
            if o.disposed {
                with_context(None, None, f)
            } else {
                let mut ups = o.cleanups
                ups.push(f)
            }
        }
        None => {}
    }
}

/// Runs `f` once its nodes are in the page: after the `mount` or the
/// `hydrate`, or the `show` or `for_each` render, that is building, or at
/// once when none is.
/// It runs untracked, with the owner it was added in, which owns what it
/// makes. It never runs under `render_to_string`, nor when its render is
/// disposed, or the effect that added it runs again, before its nodes are in
/// the page.
pub fn on_mount(f: fn()) {
    let s = ui()
    if s.rendering > 0 { return }
    if s.building > 0 {
        let run = match s.owner {
            Some(o) => o.runs
            None => 0
        }
        let mut waiting = s.mounted
        waiting.push(Mounted { owner: s.owner, run: run, f: f })
    } else {
        untracked(f)
    }
}

// Run the `on_mount` callbacks from `start` on, in order, each with the owner
// it was added in, so that what it makes is disposed with its render; skip
// those whose owner is disposed or has run since; and drop them, keeping the
// rest in a new list, so that the old one keeps nothing.
fn run_mounted(start: Int) {
    let mut s = ui()
    let waiting = s.mounted
    let mut kept = Vec::new()
    let mut later = Vec::new()
    let mut i = 0
    while i < waiting.len() {
        if i < start { kept.push(at(waiting, i)) } else { later.push(at(waiting, i)) }
        i = i + 1
    }
    s.mounted = kept
    let mut j = 0
    while j < later.len() {
        let m = at(later, j)
        let live = match m.owner {
            Some(o) => !o.disposed && o.runs == m.run
            None => true
        }
        if live { with_context(m.owner, None, m.f) }
        j = j + 1
    }
}

/// Runs `f` with a new owner, which no other owns, and gives `f` the
/// function that disposes of it, in a `batch`; returns what `f` returns.
pub fn root<T>(f: fn(fn()) -> T) -> T {
    let o = new_owner(ROOT, || {})
    with_context(Some(o), None, || f(|| batch(|| dispose(o))))
}

/// Runs `f`, and the effects its `set`s queue once it returns, each once.
pub fn batch(f: fn()) {
    let mut s = ui()
    s.batch = s.batch + 1
    f()
    s.batch = s.batch - 1
    flush()
}

/// What a page shows: an element, text, or a part that changes. The
/// builders of `std/ui/html` make them.
pub type View =
    /// An element: its tag, its attributes, and its children.
    | Element(String, [Attr], [View])
    /// Text.
    | Text(String)
    /// Text read again when the signals it read change.
    | DynText(fn() -> String)
    /// Views that change as a whole: `show`'s and `for_each`'s.
    | Region(fn() -> [View])

/// An attribute of an element, a property, or an event's handler.
pub type Attr =
    /// An attribute's name and value.
    | Static(String, String)
    /// An attribute whose value is read again when its signals change.
    | Dynamic(String, fn() -> String)
    /// A property, such as an input's `value`.
    | Property(String, String)
    /// A property whose value is read again when its signals change.
    | DynProperty(String, fn() -> String)
    /// A handler for events of a kind, given the target's `value`.
    | On(String, fn(String))

// `f` with no listener, for the views `show` and `for_each` build: what
// those read is theirs, not the region's.
fn view_of(f: fn() -> View) -> View { untracked(f) }

/// `then()`'s view while `when` holds, and nothing otherwise. It is built
/// again each time `when` is set to true, even when it already was.
pub fn show(when: Signal<Bool>, then: fn() -> View) -> View {
    Region(
        || {
            if when.value() {
                [view_of(then)]
            } else {
                let none: [View] = []
                none
            }
        },
    )
}

/// `render` of each item, in order. The whole list is built again each
/// time `items` changes.
pub fn for_each<T>(items: Signal<[T]>, render: fn(T) -> View) -> View {
    Region(
        || {
            let xs = items.value()
            let mut out = [Text(""); xs.len()]
            let mut i = 0
            while i < xs.len() {
                let x = xs[i]
                out[i] = view_of(|| render(x))
                i = i + 1
            }
            out
        },
    )
}

// A name `std/ui` writes into markup, checked: ASCII letters, digits and
// `-`, starting with a letter.
fn check_name(name: String, what: String) {
    let cs = name.chars()
    let mut ok = cs.len() > 0
    let mut i = 0
    while ok && i < cs.len() {
        let c = cs[i]
        let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        let digit = c >= '0' && c <= '9'
        ok = letter || (i > 0 && (digit || c == '-'))
        i = i + 1
    }
    if !ok { panic("std/ui: \"${name}\" is not ${what}") }
}

// An attribute's or a property's name, checked as `what`. Three parse their
// value as HTML, which `std/ui` never inserts: `innerHTML` and `outerHTML`,
// and `srcdoc`, an iframe's whole document. They are refused as either, and
// without regard to case, as HTML reads an attribute's name.
fn check_attr(name: String, what: String) {
    check_name(name, what)
    let n = name.to_lower()
    if n == "innerhtml" || n == "outerhtml" || n == "srcdoc" {
        panic("std/ui: \"${name}\" parses HTML, which std/ui does not insert")
    }
}

// The names of element `tag` and of its attributes and properties, which
// both renderers check before they write any of them.
fn check_element(tag: String, attrs: [Attr]) {
    check_name(tag, "a tag name")
    let mut i = 0
    while i < attrs.len() {
        match attrs[i] {
            Static(name, value) => check_attr(name, "an attribute name")
            Dynamic(name, f) => check_attr(name, "an attribute name")
            Property(name, value) => check_attr(name, "a property name")
            DynProperty(name, f) => check_attr(name, "a property name")
            On(kind, f) => {}
        }
        i = i + 1
    }
}

// The elements written with no closing tag and no children.
fn is_void(tag: String) -> Bool { tag == "input" || tag == "img" || tag == "br" || tag == "hr" }

// `text` with `&`, `<` and `>` escaped, and `"` too in an attribute; with
// `marks`, a carriage return too, which the browser's parser would turn
// into a line feed.
fn escape(text: String, attribute: Bool, marks: Bool) -> String {
    let cs = text.chars()
    let mut parts = Vec::new()
    let mut i = 0
    while i < cs.len() {
        let c = cs[i]
        if c == '&' {
            parts.push("&amp;")
        } else if c == '<' {
            parts.push("&lt;")
        } else if c == '>' {
            parts.push("&gt;")
        } else if attribute && c == '"' {
            parts.push("&quot;")
        } else if marks && c == '\r' {
            parts.push("&#13;")
        } else {
            parts.push("${c}")
        }
        i = i + 1
    }
    joined(parts)
}

fn joined(parts: Vec<String>) -> String {
    let mut all = [""; parts.len()]
    let mut i = 0
    while i < parts.len() {
        all[i] = at(parts, i)
        i = i + 1
    }
    "".join(all)
}

// Whether `v` is text, fixed or dynamic.
fn is_text(v: View) -> Bool {
    match v {
        Text(t) => true
        DynText(f) => true
        _ => false
    }
}

// Write `v` as HTML into `out`. With `marks`, as `render_hydratable` writes
// it (spec docs/superpowers/specs/2026-10-19-phase-4-6-ssr-hydration-and-ssg-design.md
// §3): a region between `<!--[-->` and `<!--]-->`, and a carriage return as
// `&#13;`.
fn write_view(v: View, out: Vec<String>, marks: Bool) {
    let mut o = out
    match v {
        Element(tag, attrs, children) => {
            check_element(tag, attrs)
            o.push("<${tag}")
            let mut i = 0
            while i < attrs.len() {
                write_attr(attrs[i], out, marks)
                i = i + 1
            }
            o.push(">")
            if !is_void(tag) {
                write_views(children, out, marks)
                o.push("</${tag}>")
            }
        }
        Text(t) => o.push(escape(t, false, marks))
        DynText(f) => o.push(escape(f(), false, marks))
        Region(f) => {
            if marks { o.push("<!--[-->") }
            write_views(f(), out, marks)
            if marks { o.push("<!--]-->") }
        }
    }
}

// Write `views`, siblings, into `out`; with `marks`, `<!--|-->` between two
// texts side by side, so that the browser's parse keeps them apart.
fn write_views(views: [View], out: Vec<String>, marks: Bool) {
    let mut o = out
    let mut after_text = false
    let mut i = 0
    while i < views.len() {
        let text = is_text(views[i])
        if marks && after_text && text { o.push("<!--|-->") }
        write_view(views[i], out, marks)
        after_text = text
        i = i + 1
    }
}

fn write_attr(a: Attr, out: Vec<String>, marks: Bool) {
    let mut o = out
    match a {
        Static(name, value) => o.push(" ${name}=\"${escape(value, true, marks)}\"")
        Dynamic(name, f) => o.push(" ${name}=\"${escape(f(), true, marks)}\"")
        Property(name, value) => o.push(" ${name}=\"${escape(value, true, marks)}\"")
        DynProperty(name, f) => o.push(" ${name}=\"${escape(f(), true, marks)}\"")
        On(kind, f) => {}
    }
}

// `f`'s view as HTML, written with `marks` or without, as the two renderers
// write it.
fn render(f: fn() -> View, marks: Bool) -> String {
    let out = Vec::new()
    batch(
        || {
            let mut s = ui()
            s.rendering = s.rendering + 1
            root(
                |dispose: fn()| {
                    write_view(f(), out, marks)
                    dispose()
                },
            )
            s.rendering = s.rendering - 1
        },
    )
    joined(out)
}

/// `f`'s view as HTML. `f` runs in a new owner, which is disposed once the
/// HTML is written; text and attributes are read once, handlers are left
/// out, and `on_mount` never runs. Text and attribute values are escaped,
/// the text of a `script` or `style` element too. It is a batch: what its
/// `set`s run, such as a region `mount` built, runs once it is done.
pub fn render_to_string(f: fn() -> View) -> String { render(f, false) }

/// `f`'s view as HTML for `hydrate` to adopt in the page: what
/// `render_to_string` writes, with three additions, so that the browser's
/// parse of it has each node `mount` would build. A `show` or a `for_each`
/// is written between the comments `<!--[-->` and `<!--]-->`. Two texts side
/// by side, among an element's children or a region's views, are separated
/// by `<!--|-->`; an empty text still writes nothing, but keeps its
/// separators. And a carriage return, in text or in an attribute's value, is
/// written `&#13;`, since the browser's parser turns a raw one into a line
/// feed. No marker can come from a program's text, which is escaped.
///
/// A server writes it into the page, and the client hydrates the same view:
///
/// ```
/// import ui
/// import ui::html::{div, dyn_text, li, text, ul}
///
/// let items = signal(["a", "b"])
/// let list = || ul([], [for_each(items, |s: String| li([], [text(s)]))])
/// let html = render_hydratable(|| div([], [text("count: "), dyn_text(|| "2"), list()]))
/// assert_eq(html, "<div>count: <!--|-->2<ul><!--[--><li>a</li><li>b</li><!--]--></ul></div>")
/// // A carriage return, which `render_to_string` writes as it is.
/// assert_eq(render_hydratable(|| text("a\rb")), "a&#13;b")
/// ```
pub fn render_hydratable(f: fn() -> View) -> String { render(f, true) }

/// Builds `f`'s view into the first element of the page `selector` matches,
/// after its children, and keeps it up to date. It panics when no element
/// matches, and natively, where there is no page.
pub fn mount(selector: String, f: fn() -> View) {
    let parent = match backend_query(selector) {
        Some(p) => p
        None => panic("std/ui: mount: no element matches \"${selector}\"")
    }
    let o = new_owner(ROOT, || {})
    let mut s = ui()
    let mut kept = s.roots
    kept.push(o)
    let start = s.mounted.len()
    s.building = s.building + 1
    with_context(Some(o), None, || build(f(), parent, None))
    s.building = s.building - 1
    run_mounted(start)
}

/// Adopts the HTML `render_hydratable` wrote for the same view into the
/// first element of the page `selector` matches, and keeps it up to date:
/// the server's nodes stay in the page, and the effects and handlers `mount`
/// would give its own nodes start on them. `on_mount` callbacks run once
/// that is done. The server writes `render_hydratable(App)` into the page's
/// root, and the client, a WASM build of the same `App`, calls
/// `hydrate("#app", App)`.
///
/// It walks `f()`'s view against the root's nodes in order: an element must
/// have the view's tag, and a text its text, once the text nodes a browser's
/// parser split it into, as Chromium splits one longer than 65,536
/// characters, are joined into the first; attributes are not compared. At
/// the first difference, it writes `nova: hydration mismatch: expected …,
/// found …; building the view again` with `console.error`, disposes of what
/// it began, removes the root's children, and builds the view there as
/// `mount` does, calling `f` again. A root with no child, or only
/// whitespace, as a page served without the server's HTML has, gets the view
/// built the same way, with no report: its whitespace is removed first. It
/// panics when no element matches, and natively, where there is no page.
///
/// What a server writes for a view, which `hydrate("#app", app)` then adopts
/// in the page, the button's handler added and the count's text followed:
///
/// ```
/// import ui
/// import ui::html::{button, div, dyn_text, on_click, text}
///
/// let count = signal(2)
/// let add = on_click(|| count.update(|n: Int| n + 1))
/// let app = || div([], [text("count: "), dyn_text(|| "${count.value()}"), button([add], [text("+")])])
/// assert_eq(render_hydratable(app), "<div>count: <!--|-->2<button>+</button></div>")
/// ```
pub fn hydrate(selector: String, f: fn() -> View) { hydrate_into(root_of("hydrate", selector), f) }

/// `hydrate` for a view of the server's data. The data is the JSON text of
/// the `<script type="application/json" id="nova-data">` the server wrote
/// just after the root: the root's next element, when it is a `script` with
/// that `id` and that `type`. An element of the view with the id `nova-data`
/// is never the data. `hydrate_with` makes a `T` of that text with
/// `T::from_json`, and hydrates `f` of it, the view the server rendered with
/// `render_hydratable`. When the page holds no data from the server, as
/// under `nova dev`, it uses `fallback` instead, as `hydrate` would: an
/// empty root gets `f(fallback)`'s view built, and a root the server filled
/// is walked with it. It panics when the data's text does not parse, or
/// `from_json` refuses it, and as `hydrate` does.
///
/// The server renders the view of a value, and writes the value beside it:
///
/// ```
/// import ui
/// import ui::html::{li, text, ul}
///
/// fn names(xs: [String]) -> View { ul([], [for_each(signal(xs), |s: String| li([], [text(s)]))]) }
///
/// fn main() {
///     let data = ["Ada", "Grace"]
///     let html = render_hydratable(|| names(data))
///     assert_eq(html, "<ul><!--[--><li>Ada</li><li>Grace</li><!--]--></ul>")
///     // The page holds the HTML, and after its root the data as JSON,
///     // escaped, in its `nova-data`. The client calls
///     // `hydrate_with("#app", none, names)`, where `none` is an empty
///     // `[String]`: a page with no data, as `nova dev` serves, shows an
///     // empty list.
///     let none: [String] = []
///     assert_eq(render_hydratable(|| names(none)), "<ul><!--[--><!--]--></ul>")
/// }
/// ```
pub fn hydrate_with<T: FromJson>(selector: String, fallback: T, f: fn(T) -> View) {
    let parent = root_of("hydrate_with", selector)
    let data = match backend_data(parent) {
        Some(text) => {
            match parse(text) {
                Ok(v) => {
                    match T::from_json(v) {
                        Ok(d) => d
                        Err(e) => {
                            panic("std/ui: hydrate_with: the page's data does not parse: ${e.msg}")
                        }
                    }
                }
                Err(e) => panic("std/ui: hydrate_with: the page's data does not parse: ${e.msg}")
            }
        }
        None => fallback
    }
    hydrate_into(parent, || f(data))
}

// The first element `selector` matches, the root of `name`'s call, which
// panics, naming the function, when none does.
fn root_of(name: String, selector: String) -> Node {
    match backend_query(selector) {
        Some(p) => p
        None => panic("std/ui: ${name}: no element matches \"${selector}\"")
    }
}

// `hydrate` into `parent` (spec
// docs/superpowers/specs/2026-10-19-phase-4-6-ssr-hydration-and-ssg-design.md
// §4). The walk has a root owner, kept as `mount` keeps one; on a mismatch
// it is disposed and dropped, the root emptied, and the view built afresh
// under a new one. A blank root is emptied too, so the view is not built
// after its whitespace. `on_mount` callbacks wait for the walk, or the
// build, and those the disposed owner queued never run.
fn hydrate_into(parent: Node, f: fn() -> View) {
    let mut s = ui()
    let start = s.mounted.len()
    if !blank(parent) {
        let o = new_owner(ROOT, || {})
        let mut kept = s.roots
        kept.push(o)
        let w = Walk { failed: false, message: "" }
        s.building = s.building + 1
        with_context(
            Some(o),
            None,
            || {
                let c = Cursor { parent: parent, at: backend_first_child(parent) }
                walk_view(f(), false, w, c)
                left_over(w, c)
            },
        )
        s.building = s.building - 1
        if !w.failed {
            run_mounted(start)
            return
        }
        backend_report("nova: hydration mismatch: ${w.message}; building the view again")
        batch(|| dispose(o))
        let mut live = Vec::new()
        let mut i = 0
        while i < s.roots.len() {
            let r = at(s.roots, i)
            if r.id != o.id { live.push(r) }
            i = i + 1
        }
        s.roots = live
    }
    let mut emptied = false
    while !emptied {
        match backend_first_child(parent) {
            Some(n) => backend_remove(n)
            None => emptied = true
        }
    }
    let o = new_owner(ROOT, || {})
    let mut kept = s.roots
    kept.push(o)
    s.building = s.building + 1
    with_context(Some(o), None, || build(f(), parent, None))
    s.building = s.building - 1
    run_mounted(start)
}

// Put `node` into `parent`, before `before` or last.
fn put(parent: Node, node: Node, before: Option<Node>) {
    match before {
        Some(b) => backend_insert_before(parent, node, b)
        None => backend_append(parent, node)
    }
}

// Build `v`'s nodes into `parent`, before `before` or last, with an effect
// for each part that changes.
fn build(v: View, parent: Node, before: Option<Node>) {
    match v {
        Element(tag, attrs, children) => {
            check_element(tag, attrs)
            let el = backend_element(tag)
            let mut i = 0
            while i < attrs.len() {
                build_attr(attrs[i], el)
                i = i + 1
            }
            if !is_void(tag) {
                let mut j = 0
                while j < children.len() {
                    build(children[j], el, None)
                    j = j + 1
                }
            }
            put(parent, el, before)
        }
        Text(t) => put(parent, backend_text(t), before)
        DynText(f) => {
            let n = backend_text("")
            effect(|| backend_set_text(n, f()))
            put(parent, n, before)
        }
        Region(f) => {
            let start = backend_text("")
            let end = backend_text("")
            put(parent, start, before)
            put(parent, end, before)
            effect(|| build_region(f, parent, start, end))
        }
    }
}

// A region's render: what `f` gives, read as the effect running this, so
// that its signals are the region's, built before `end` once the nodes
// between the markers are removed. Each render has its own owner, which the
// effect owns, so running again disposes of the last render first: its
// effects, its handlers, and its `on_mount` callbacks not yet run. An
// `on_mount` in the render waits for its nodes, and for the outer build's
// when there is one.
fn build_region(f: fn() -> [View], parent: Node, start: Node, end: Node) {
    let mut s = ui()
    let outer = s.building > 0
    let begin = s.mounted.len()
    s.building = s.building + 1
    let render = new_owner(ROOT, || {})
    adopt(render)
    let views = with_context(Some(render), s.listener, f)
    let mut done = false
    while !done {
        match backend_next_sibling(start) {
            Some(n) => { if backend_is_same(n, end) { done = true } else { backend_remove(n) } }
            None => done = true
        }
    }
    with_context(
        Some(render),
        None,
        || {
            let mut i = 0
            while i < views.len() {
                build(views[i], parent, Some(end))
                i = i + 1
            }
        },
    )
    s.building = s.building - 1
    if !outer { run_mounted(begin) }
}

fn build_attr(a: Attr, el: Node) {
    match a {
        Static(name, value) => backend_set_attr(el, name, value)
        Dynamic(name, f) => effect(|| backend_set_attr(el, name, f()))
        Property(name, value) => backend_set_prop(el, name, value)
        DynProperty(name, f) => effect(|| backend_set_prop(el, name, f()))
        On(kind, f) => {
            let stop = backend_listen(el, kind, |v: String| untracked(|| batch(|| f(v))))
            on_cleanup(stop)
        }
    }
}

// Hydration's walk (spec
// docs/superpowers/specs/2026-10-19-phase-4-6-ssr-hydration-and-ssg-design.md
// §4.2, §4.3): a cursor steps through the server's nodes in the order
// `build` would make them, and each view adopts the nodes it would have
// built, with the effects and handlers `build` would give them. The first
// difference is kept in the walk, which stops there.

// A walk, and its first difference.
record Walk { failed: Bool, message: String }

// Where a walk is among `parent`'s children: at a node, or past the last.
record Cursor { parent: Node, at: Option<Node> }

// What the walk found for an effect: a dynamic text's node, and the text
// its first run read; or a region's end marker.
record Found { node: Option<Node>, text: String }

// Whether `node` holds nothing to adopt: no child, or only text that is
// all whitespace, as HTML reads it.
fn blank(node: Node) -> Bool {
    let mut child = backend_first_child(node)
    let mut done = false
    while !done {
        match child {
            Some(n) => {
                if backend_kind(n) != "#text" { return false }
                let cs = backend_text_of(n).chars()
                let mut i = 0
                while i < cs.len() {
                    let c = cs[i]
                    let space = c == ' ' || c == '\t' || c == '\n' || c == '\r'
                    if !space && "${c}" != "\u{c}" { return false }
                    i = i + 1
                }
                child = backend_next_sibling(n)
            }
            None => done = true
        }
    }
    true
}

// Step `c` to the next node.
fn advance(c: Cursor) {
    let mut m = c
    m.at = match c.at {
        Some(n) => backend_next_sibling(n)
        None => None
    }
}

// Whether `node` is the comment `<!--${data}-->`.
fn is_marker(node: Node, data: String) -> Bool {
    backend_kind(node) == "#comment" && backend_text_of(node) == data
}

// At most the first 40 characters of `t`.
fn clipped(t: String) -> String { if t.len() > 40 { t.slice(0, 40) } else { t } }

// What the walk found at `here`, as a mismatch names it. A separator stands
// for the text after it, which the server wrote there.
fn found(here: Option<Node>) -> String {
    match here {
        Some(n) => {
            let kind = backend_kind(n)
            if kind == "#text" { return "text \"${clipped(backend_text_of(n))}\"" }
            if kind != "#comment" { return "<${kind}>" }
            let data = backend_text_of(n)
            if data == "[" { return "a region" }
            if data == "]" { return "the end of a region" }
            if data != "|" { return "a comment" }
            match backend_next_sibling(n) {
                Some(next) => {
                    if backend_kind(next) == "#text" {
                        return "text \"${clipped(backend_text_of(next))}\""
                    }
                }
                None => {}
            }
            "text \"\""
        }
        None => "nothing"
    }
}

// Stop the walk at `c`, which is not `expected`.
fn missed(w: Walk, expected: String, c: Cursor) {
    let mut m = w
    m.failed = true
    m.message = "expected ${expected}, found ${found(c.at)}"
}

// After the views of an element or of the root, no node may be left.
fn left_over(w: Walk, c: Cursor) { if !w.failed && c.at.is_some() { missed(w, "nothing", c) } }

fn walk_views(views: [View], w: Walk, c: Cursor) {
    let mut after_text = false
    let mut i = 0
    while i < views.len() && !w.failed {
        let text = is_text(views[i])
        walk_view(views[i], after_text && text, w, c)
        after_text = text
        i = i + 1
    }
}

// Walk `v` at `c`, adopting its nodes. `joined` says a text came just before
// it and it is text too, so the separator `render_hydratable` wrote between
// them comes first.
fn walk_view(v: View, joined: Bool, w: Walk, c: Cursor) {
    match v {
        Element(tag, attrs, children) => {
            check_element(tag, attrs)
            let name = tag.to_lower()
            match c.at {
                Some(el) => {
                    if backend_kind(el) == name {
                        advance(c)
                        let mut i = 0
                        while i < attrs.len() {
                            adopt_attr(attrs[i], el)
                            i = i + 1
                        }
                        if !is_void(tag) {
                            let inner = Cursor { parent: el, at: backend_first_child(el) }
                            walk_views(children, w, inner)
                            left_over(w, inner)
                        }
                        return
                    }
                }
                None => {}
            }
            missed(w, "<${name}>", c)
        }
        Text(t) => { let _ = adopt_text(t, joined, w, c) }
        DynText(f) => {
            let got = Found { node: None, text: "" }
            effect(
                || {
                    let t = f()
                    let mut m = got
                    match got.node {
                        Some(n) => backend_set_text(n, t)
                        None => m.text = t
                    }
                },
            )
            let mut m = got
            m.node = adopt_text(got.text, joined, w, c)
        }
        Region(f) => {
            match c.at {
                Some(start) => {
                    if is_marker(start, "[") {
                        advance(c)
                        let end = Found { node: None, text: "" }
                        effect(
                            || {
                                match end.node {
                                    Some(e) => build_region(f, c.parent, start, e)
                                    None => adopt_region(f, w, c, end)
                                }
                            },
                        )
                        return
                    }
                }
                None => {}
            }
            missed(w, "a region", c)
        }
    }
}

// An attribute of an adopted element: the HTML carried a fixed one, and a
// property as an attribute, so that is set; dynamic ones get their effects,
// whose first run writes them again, and handlers are added, as `build`
// does.
fn adopt_attr(a: Attr, el: Node) {
    match a {
        Static(name, value) => {}
        _ => build_attr(a, el)
    }
}

// The node of a text view whose text is `t`: past the separator `joined`
// asks for, the text node at `c`, which must hold `t` once the nodes a
// browser split it into are joined (`whole_text`); or, where there is none
// and `t` is empty, a new empty one put there, since an empty text writes
// nothing. `None` once the walk stops.
fn adopt_text(t: String, joined: Bool, w: Walk, c: Cursor) -> Option<Node> {
    let expected = "text \"${clipped(t)}\""
    if joined {
        let separated = match c.at {
            Some(n) => is_marker(n, "|")
            None => false
        }
        if !separated {
            missed(w, expected, c)
            return None
        }
        advance(c)
    }
    match c.at {
        Some(n) => {
            if backend_kind(n) == "#text" {
                if whole_text(n, t) != t {
                    missed(w, expected, c)
                    return None
                }
                advance(c)
                return Some(n)
            }
        }
        None => {}
    }
    if t != "" {
        missed(w, expected, c)
        return None
    }
    let n = backend_text("")
    put(c.parent, n, c.at)
    Some(n)
}

// The text of the text node `n`, once each text node after it is joined to
// it while its text is a proper prefix of `t`: that node's text appended to
// `n`'s, and the node removed. A browser's parser splits a long text into
// several nodes, Chromium's at 65,536 characters, and `render_hydratable`
// never writes two texts side by side, a separator or another node always
// between them, so a text node just after another is the rest of its text.
fn whole_text(n: Node, t: String) -> String {
    let mut have = backend_text_of(n)
    let mut more = true
    while more && have != t && t.starts_with(have) {
        more = false
        match backend_next_sibling(n) {
            Some(next) => {
                if backend_kind(next) == "#text" {
                    have = "${have}${backend_text_of(next)}"
                    backend_set_text(n, have)
                    backend_remove(next)
                    more = true
                }
            }
            None => {}
        }
    }
    have
}

// A region's first run under hydration, as `build_region`'s with a walk for
// a build: its views, read as the effect running this, walked under a
// render of their own from the node after its `<!--[-->`; then its
// `<!--]-->`, which `end` keeps for the later runs, which build before it as
// under `mount`.
fn adopt_region(f: fn() -> [View], w: Walk, c: Cursor, end: Found) {
    let render = new_owner(ROOT, || {})
    adopt(render)
    let views = with_context(Some(render), ui().listener, f)
    with_context(Some(render), None, || walk_views(views, w, c))
    if w.failed { return }
    match c.at {
        Some(n) => {
            if is_marker(n, "]") {
                advance(c)
                let mut m = end
                m.node = Some(n)
                return
            }
        }
        None => {}
    }
    missed(w, "the end of a region", c)
}
