// Nova standard library — collections.
//
// Compiled as an implicit module and glob-imported into every user module, so
// these names need no `import`. A user definition of the same name shadows the
// one here (see docs/adr/0004-stdlib-compile-model.md).
//
// `Vec` grows by allocating a larger `[T]` and reassigning the field: the record
// object's address never changes and the array's only referent is that field, so
// the conservative non-moving collector needs no special handling.

pub record Vec<T> { len: Int, data: [T] }

impl<T> Vec<T> {
    // An empty vector. No storage is allocated until the first `push`.
    pub fn new() -> Vec<T> { Vec { len: 0, data: [] } }

    pub fn len(self) -> Int { self.len }

    pub fn is_empty(self) -> Bool { self.len == 0 }

    // Append `x`, growing if full.
    //
    // Growth allocates `[x; newcap]` — using the pushed element as the filler,
    // so no slot is ever uninitialized and no `Default` bound is needed — then
    // copies the existing elements back. Slot `self.len` is then already `x`,
    // so the append needs no further store on the growth path.
    pub fn push(mut self, x: T) {
        if self.len == self.data.len() {
            let newcap = if self.len == 0 { 4 } else { self.len * 2 }
            let mut grown = [x; newcap]
            for i in 0..self.len { grown[i] = self.data[i] }
            self.data = grown
        } else {
            self.data[self.len] = x
        }
        self.len = self.len + 1
    }

    pub fn pop(mut self) -> Option<T> {
        if self.len == 0 {
            None
        } else {
            let last = self.data[self.len - 1]
            self.len = self.len - 1
            Some(last)
        }
    }

    pub fn get(self, i: Int) -> Option<T> {
        if i < 0 { None } else { if i >= self.len { None } else { Some(self.data[i]) } }
    }

    pub fn set(mut self, i: Int, v: T) {
        if i < 0 { panic("Vec::set index out of range") }
        if i >= self.len { panic("Vec::set index out of range") }
        self.data[i] = v
    }

    pub fn clear(mut self) { self.len = 0 }
}

// A hash map with open addressing and linear probing.
//
// Capacity is a power of two, so a bucket index is `hash & (cap - 1)` — never
// `hash % cap`. A hash may be negative (`mix64` spans the whole `Int` range and
// `str_hash` reinterprets an unsigned FNV-1a result), and `%` inherits that
// sign while `&` with a positive mask does not. The high bits are not read at
// all: Nova's `>>` is arithmetic with no `>>>`, so a negative hash
// sign-extends. See the masking rule on `pub trait Hash` in std/core.
//
// The three arrays are allocated together on the first insert, using the
// inserted key and value as fillers, so no slot is ever uninitialized and no
// `Default` bound is needed. `state` is filled with 0, which is exactly the
// "empty" tag, so a fresh table is empty by construction. Slot states are
// `0` empty, `1` occupied, `2` tombstone.
//
// `len` counts live entries only. `used` counts occupied *plus* tombstones and
// is what the load threshold reads, so a remove-heavy workload cannot degrade
// into an all-tombstone scan.
//
// The `K: Hash + Eq` contract lives on the `impl` below, not on this record's
// generic parameters as `20-STDLIB.md` writes it. A bound on a *record*
// parameter parses but is silently dropped — `nova-hir`'s `RecordType` keeps
// only a generic count, and `nova-mir`'s `mono` checks bounds solely against a
// function's own `bounds` — so `record Map<K: Hash + Eq, V>` would advertise a
// guarantee nothing enforces. On the impl it is real: instantiating any method
// with a key that is not `Hash + Eq` is E0013 at monomorphization, which is
// pinned by `map_key_without_hash_reports_e0013` in nova-mir's lowering tests.
pub record Map<K, V> { len: Int, used: Int, keys: [K], vals: [V], state: [Int] }

impl<K: Hash + Eq, V> Map<K, V> {
    // An empty map. No storage is allocated until the first `insert`.
    pub fn new() -> Map<K, V> {
        Map { len: 0, used: 0, keys: [], vals: [], state: [] }
    }

    // Number of live entries; unaffected by tombstones.
    pub fn len(self) -> Int { self.len }

    pub fn is_empty(self) -> Bool { self.len == 0 }

    // Bucket for `k` in a table of capacity `cap` (a power of two). `cap` must
    // be positive: at `cap == 0` the mask would be `-1` and the result the raw
    // hash, so every caller checks for the unallocated table first.
    fn slot_of(self, k: K, cap: Int) -> Int { k.hash() & (cap - 1) }

    // Insert, returning the previous value for `k` if there was one.
    //
    // The probe never stops at a tombstone: it runs on to either `k` itself (a
    // replacement) or an empty slot (a genuine absence), and only then stores
    // into the *first* tombstone it passed. Stopping early would let a second
    // copy of `k` appear behind the tombstone; not reusing the tombstone at all
    // would let a churn workload grow without bound.
    pub fn insert(mut self, k: K, v: V) -> Option<V> {
        if self.state.len() == 0 {
            self.keys = [k; 8]
            self.vals = [v; 8]
            self.state = [0; 8]
        } else {
            // Grow above 3/4 load, counting tombstones.
            if (self.used + 1) * 4 > self.state.len() * 3 { self.grow(k, v) }
        }
        // After that check `used + 1 <= cap * 3 / 4 < cap`, so at least one slot
        // is still empty and the scan below always terminates at `st == 0`
        // before `probes` runs out. The `panic` is unreachable.
        let cap = self.state.len()
        let mut i = self.slot_of(k, cap)
        let mut first_free = -1
        let mut probes = 0
        while probes < cap {
            let st = self.state[i]
            if st == 0 {
                let at = if first_free >= 0 { first_free } else { i }
                self.keys[at] = k
                self.vals[at] = v
                self.state[at] = 1
                self.len = self.len + 1
                // A reused tombstone was already counted in `used`.
                if first_free < 0 { self.used = self.used + 1 }
                return None
            }
            if st == 1 {
                if self.keys[i].eq(k) {
                    let old = self.vals[i]
                    self.vals[i] = v
                    return Some(old)
                }
            } else {
                if first_free < 0 { first_free = i }
            }
            i = (i + 1) & (cap - 1)
            probes = probes + 1
        }
        panic("Map::insert found no free slot")
    }

    // The slot index of a live entry for `k`, or `-1` if there is none. Shared
    // by `get` and `remove`, which differ only in what they do with the slot
    // once found — `get` reads it, `remove` writes a tombstone into it — so
    // the probe scan itself lives in exactly one place, as the module doc
    // above promises, instead of two copies that can drift.
    //
    // `cap == 0` (an unallocated table) reports absence without indexing
    // anything. Only an empty slot ends the chain; a tombstone is walked
    // past, so a key inserted past a tombstone stays reachable — removing
    // from the middle of a chain must not break the chain for keys further
    // along it.
    fn find(self, k: K) -> Int {
        let cap = self.state.len()
        if cap == 0 { return -1 }
        let mut i = self.slot_of(k, cap)
        let mut probes = 0
        while probes < cap {
            let st = self.state[i]
            if st == 0 { return -1 }
            if st == 1 {
                if self.keys[i].eq(k) { return i }
            }
            i = (i + 1) & (cap - 1)
            probes = probes + 1
        }
        // Not a bare trailing `-1`: a line starting with `-` right after a
        // `}`-closed block is absorbed as binary subtraction against the
        // `while` above (which types `Unit`), not read as a fresh statement —
        // the same trap `tests/runtime/collections.nova` binds `miss` to
        // avoid. `return` makes this an unambiguous statement.
        return -1
    }

    pub fn get(self, k: K) -> Option<V> {
        let i = self.find(k)
        if i < 0 { None } else { Some(self.vals[i]) }
    }

    pub fn contains_key(self, k: K) -> Bool {
        match self.get(k) { Some(_) => true, None => false }
    }

    // Remove `k`, leaving a tombstone so later probes still reach entries that
    // were inserted past this slot. `len` drops; `used` does not, because the
    // slot is still unusable to a probe walking through it.
    pub fn remove(mut self, k: K) -> Option<V> {
        let i = self.find(k)
        if i < 0 {
            None
        } else {
            let old = self.vals[i]
            self.state[i] = 2
            self.len = self.len - 1
            Some(old)
        }
    }

    // Double the capacity and reinsert the live entries, which is also what
    // clears the tombstones. `fk`/`fv` are fillers for the fresh arrays, so no
    // slot is uninitialized; `state`'s 0 filler makes the new table empty.
    //
    // Reached only from `insert`'s pre-check, and the reinserts cannot re-enter
    // it: `used` is reset to 0 and at most `oldcap` live entries go back in,
    // while the new threshold needs `used + 1 > newcap * 3 / 4`, i.e. more than
    // `1.5 * oldcap`. So the nesting is exactly one level deep.
    //
    // GC: this is *not* safe for the reason `Vec::push` is. `push` finishes the
    // new array before reassigning the field, so the old one stays reachable
    // through the record the whole time. Here `self.keys` is reassigned on the
    // very next line, and from then on `oldkeys` is live only in this frame's
    // locals while two more `[_; newcap]` allocations and one allocation per
    // reinsert all run — every one of them a collection point. It is safe
    // because the collector scans the stack from the allocating frame up to the
    // thread base *plus* the callee-saved registers the `setjmp` shim spills
    // there, and the ABI leaves anything live across a call in one of those two
    // places; marking is range-based, so a derived element pointer counts too.
    // That is a property of the calling convention, not of the record/buffer
    // shape, which is why this window is what makes `NOVA_GC_STRESS=1`
    // load-bearing on `tests/runtime/collections.nova` rather than
    // belt-and-braces — a missed root here loses entries silently instead of
    // crashing.
    fn grow(mut self, fk: K, fv: V) {
        let oldcap = self.state.len()
        let newcap = oldcap * 2
        let oldkeys = self.keys
        let oldvals = self.vals
        let oldstate = self.state
        self.keys = [fk; newcap]
        self.vals = [fv; newcap]
        self.state = [0; newcap]
        self.len = 0
        self.used = 0
        for j in 0..oldcap {
            if oldstate[j] == 1 {
                // Reinserting a key the fresh table cannot already hold always
                // returns `None`, so the result is discarded.
                let _ = self.insert(oldkeys[j], oldvals[j])
            }
        }
    }
}

// A hash set, backed by a `Map` with a placeholder value. Reusing `Map` keeps
// the probing, tombstone and growth logic in exactly one place.
//
// As with `Map` (see the note above it), the `T: Hash + Eq` contract lives on
// the `impl`, not on this record's generic parameter: a bound on a record
// parameter parses but is silently dropped by the current compiler.
pub record Set<T> { map: Map<T, Bool> }

impl<T: Hash + Eq> Set<T> {
    // An empty set. No storage is allocated until the first `insert`.
    pub fn new() -> Set<T> { Set { map: Map::new() } }

    // Number of elements; unaffected by tombstones (see `Map::len`).
    pub fn len(self) -> Int { self.map.len() }

    pub fn is_empty(self) -> Bool { self.map.is_empty() }

    // Add `v`, returning whether it was newly added. `Map::insert` returns
    // `Some(old)` when `v` was already a key, so "newly added" is exactly the
    // `None` case — the inverse of what `Map::insert` reports.
    pub fn insert(mut self, v: T) -> Bool {
        match self.map.insert(v, true) { Some(_) => false, None => true }
    }

    pub fn contains(self, v: T) -> Bool { self.map.contains_key(v) }

    // Remove `v`, returning whether it was present. `Map::remove` returns
    // `Some(old)` when `v` was there, so "was present" is exactly the
    // `Some` case — the inverse of what `Map::remove` reports.
    pub fn remove(mut self, v: T) -> Bool {
        match self.map.remove(v) { Some(_) => true, None => false }
    }
}
