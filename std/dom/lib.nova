//! The browser's page, from a program built for WASM: its elements and
//! text, their attributes and properties, events, the location and history,
//! timers, and `fetch`.
//!
//! It is not in the prelude: a module that uses it imports it, with
//! `import dom` for every name, or `import dom::{Element, create_element}`
//! for some. Only a WASM build has it; natively, `import dom` is E0092.
//!
//! Each `Element` holds a handle to a JS object, which a collection releases
//! once no value holds it. Collections run at the end of a turn, so a program
//! whose synchronous `main` adds no listener, timer or `fetch` never releases
//! one. A JS exception in one of these functions is a panic that names the
//! function.

// The shim's JS functions (spec
// docs/superpowers/specs/2026-10-16-phase-4-2-std-dom-and-the-shim-design.md
// §3.1, §6.2). A node is a handle, 0 for none.
extern "js" {
    fn dom_body() -> Int
    fn dom_create_element(tag: String) -> Int
    fn dom_create_text(text: String) -> Int
    fn dom_query_selector(selector: String) -> Int
    fn dom_query_selector_in(node: Int, selector: String) -> Int
    fn dom_query_all(selector: String) -> Int
    fn dom_list_len(list: Int) -> Int
    fn dom_list_item(list: Int, index: Int) -> Int
    fn dom_element_by_id(id: String) -> Int
    fn dom_tag(node: Int) -> String
    fn dom_set_attribute(node: Int, name: String, value: String)
    fn dom_has_attribute(node: Int, name: String) -> Bool
    fn dom_attribute(node: Int, name: String) -> String
    fn dom_remove_attribute(node: Int, name: String)
    fn dom_set_property(node: Int, name: String, value: String)
    fn dom_property(node: Int, name: String) -> String
    fn dom_set_property_bool(node: Int, name: String, value: Bool)
    fn dom_property_bool(node: Int, name: String) -> Bool
    fn dom_set_text(node: Int, text: String)
    fn dom_text(node: Int) -> String
    fn dom_append_child(parent: Int, child: Int)
    fn dom_insert_before(parent: Int, child: Int, before: Int)
    fn dom_remove_child(parent: Int, child: Int)
    fn dom_remove(node: Int)
    fn dom_parent(node: Int) -> Int
    fn dom_first_child(node: Int) -> Int
    fn dom_next_sibling(node: Int) -> Int
    fn dom_is_same(a: Int, b: Int) -> Bool
    fn dom_click(node: Int)
    fn dom_listen(target: Int, kind: String, entry: Int) -> Int
    fn dom_unlisten(target: Int, kind: String, listener: Int)
    fn dom_window_listen(kind: String, entry: Int) -> Int
    fn dom_window_unlisten(kind: String, listener: Int)
    fn dom_event_kind(event: Int) -> String
    fn dom_event_target(event: Int) -> Int
    fn dom_event_key(event: Int) -> String
    fn dom_event_modified(event: Int) -> Bool
    fn dom_prevent_default(event: Int)
    fn dom_stop_propagation(event: Int)
    fn dom_set_timeout(ms: Int, entry: Int) -> Int
    fn dom_set_interval(ms: Int, entry: Int) -> Int
    fn dom_clear_timeout(timer: Int)
    fn dom_clear_interval(timer: Int)
    fn dom_location_href() -> String
    fn dom_location_pathname() -> String
    fn dom_location_search() -> String
    fn dom_location_hash() -> String
    fn dom_set_location_hash(hash: String)
    fn dom_history_push(url: String)
    fn dom_history_replace(url: String)
    fn dom_history_back()
    fn dom_fetch(url: String, method: String, headers: String, body: String) -> Int
    fn dom_fetch_failed(token: Int) -> Bool
    fn dom_fetch_error(token: Int) -> String
    fn dom_fetch_status(token: Int) -> Int
    fn dom_fetch_ok(token: Int) -> Bool
    fn dom_fetch_body(token: Int) -> String
}

/// A node of the page: an element, or a text node.
///
/// Each value holds a handle to the JS object, which a collection releases
/// once no value holds it. A value built by hand panics when used, unless its
/// `box` happens to name a live handle: then it reaches that handle's object,
/// one this program's own calls made.
pub record Element { box: Int }

/// An event a listener receives.
pub record Event { box: Int }

/// A listener added with `add_event_listener` or
/// `window_add_event_listener`, which `remove` removes.
pub record Listener { target: Int, kind: String, entry: Int, js: Int }

/// A timeout or an interval, from `set_timeout` or `set_interval`, which
/// `clear` stops.
pub record Timer { slot: Entry, js: Int, repeats: Bool }

/// A header of a request.
pub record Header {
    /// The header's name, such as `"Content-Type"`.
    pub name: String,
    /// Its value.
    pub value: String,
}

/// How `fetch_with` asks: a method, headers, and a body.
pub record FetchInit {
    /// The method, such as `"GET"` or `"POST"`.
    pub method: String,
    /// The request's headers.
    pub headers: [Header],
    /// The body, or `""` for none.
    pub body: String,
}

/// A reply to a request, its body read in full.
pub record Response {
    /// The status, such as 200.
    pub status: Int,
    /// Whether the status is from 200 to 299.
    pub ok: Bool,
    /// The body, as text.
    pub body: String,
}

/// A request that got no reply: the network failed, or the request was
/// refused before it was sent.
pub record FetchError {
    /// The browser's description.
    pub message: String,
}

// An entry of std/rt's table of closures JS may call, 0 once released,
// shared by a timer and its closure.
record Entry { id: Int }

// A node for handle `h`, boxed so the collector releases it.
fn node(h: Int) -> Element { Element { box: rt_handle_box(h) } }

// A node for handle `h`, or `None` for 0.
fn maybe_node(h: Int) -> Option<Element> { if h == 0 { None } else { Some(node(h)) } }

// The handle a node holds.
fn handle_of(e: Element) -> Int { rt_handle_id(e.box) }

// The nodes of a JS array of nodes, at handle `list`, which is released
// with its box. The array's filler, the list's own box, is overwritten.
fn nodes(list: Int) -> [Element] {
    let kept = node(list)
    let n = dom_list_len(list)
    let mut out = [kept; n]
    let mut i = 0
    while i < n {
        out[i] = node(dom_list_item(handle_of(kept), i))
        i = i + 1
    }
    out
}

// `handler` as an entry of std/rt's table of closures JS may call: it boxes
// the event's handle and calls `handler`.
fn event_entry(handler: fn(Event)) -> Int {
    rt_closure_register(closure_word(|h: Int| handler(Event { box: rt_handle_box(h) })))
}

/// Calls `handler` with each event of kind `kind`, such as `"popstate"`,
/// that reaches the window, until the listener is removed. Their `target`
/// is `None`: the window is not a node.
pub fn window_add_event_listener(kind: String, handler: fn(Event)) -> Listener {
    let entry = event_entry(handler)
    let js = dom_window_listen(kind, entry)
    Listener { target: 0, kind: kind, entry: entry, js: rt_handle_box(js) }
}

/// Calls `f` once, `ms` milliseconds from now, unless the timer is cleared
/// first.
pub fn set_timeout(ms: Int, f: fn()) -> Timer {
    let mut slot = Entry { id: 0 }
    slot.id = rt_closure_register(
        closure_word(
            |unused: Int| {
                rt_closure_release(slot.id)
                slot.id = 0
                f()
            },
        ),
    )
    Timer { slot: slot, js: rt_handle_box(dom_set_timeout(ms, slot.id)), repeats: false }
}

/// Calls `f` every `ms` milliseconds until the timer is cleared.
pub fn set_interval(ms: Int, f: fn()) -> Timer {
    let slot = Entry { id: rt_closure_register(closure_word(|unused: Int| f())) }
    Timer { slot: slot, js: rt_handle_box(dom_set_interval(ms, slot.id)), repeats: true }
}

/// Sends a `GET` for `url`, relative to the page's address, and waits for
/// the whole reply.
pub async fn fetch(url: String) -> Result<Response, FetchError> {
    fetch_with(url, FetchInit::new()).await
}

/// Sends the request `init` describes to `url`, and waits for the whole
/// reply. A reply of any status is `Ok`; `Err` is a request that got none.
pub async fn fetch_with(url: String, init: FetchInit) -> Result<Response, FetchError> {
    let mut headers = ""
    let mut i = 0
    while i < init.headers.len() {
        let h = init.headers[i]
        // The shim reads `name: value` lines: a line break or a colon in the
        // wrong place would make another header, as a browser refuses.
        if h.name == ""
            || h.name.contains(":")
            || h.name.contains("\n")
            || h.name.contains("\r")
            || h.value.contains("\n")
            || h.value.contains("\r") {
            return Err(
                FetchError {
                    message: "invalid header: a name is empty or holds a colon, or a name or value holds a line break",
                },
            )
        }
        headers = "${headers}${h.name}: ${h.value}\n"
        i = i + 1
    }
    let wait = node(dom_fetch(url, init.method, headers, init.body))
    rt_task_host_future(handle_of(wait)).await
    let t = handle_of(wait)
    if dom_fetch_failed(t) {
        Err(FetchError { message: dom_fetch_error(t) })
    } else {
        Ok(Response { status: dom_fetch_status(t), ok: dom_fetch_ok(t), body: dom_fetch_body(t) })
    }
}

/// The page's address, in full.
pub fn location_href() -> String { dom_location_href() }

/// The path of the page's address, such as `"/posts/7"`.
pub fn location_pathname() -> String { dom_location_pathname() }

/// The query of the page's address, from its `?`, or `""`.
pub fn location_search() -> String { dom_location_search() }

/// The fragment of the page's address, from its `#`, or `""`.
pub fn location_hash() -> String { dom_location_hash() }

/// Moves to the fragment `hash` of the page: a new history entry, and a
/// `hashchange` event on the window, after this returns.
pub fn set_location_hash(hash: String) { dom_set_location_hash(hash) }

/// Adds a history entry for `url`, relative to the page's address, and
/// moves to it without loading it.
pub fn history_push(url: String) { dom_history_push(url) }

/// Replaces the current history entry with `url`, without loading it.
pub fn history_replace(url: String) { dom_history_replace(url) }

/// Goes back one history entry: a `popstate` event on the window follows.
pub fn history_back() { dom_history_back() }

/// The page's `<body>`.
pub fn body() -> Element { node(dom_body()) }

/// A new element named `tag`, such as `"div"`, not yet in the page.
pub fn create_element(tag: String) -> Element { node(dom_create_element(tag)) }

/// A new text node holding `text`, not yet in the page.
pub fn create_text(text: String) -> Element { node(dom_create_text(text)) }

/// The first node of the page that `selector` matches, a CSS selector.
pub fn query_selector(selector: String) -> Option<Element> {
    maybe_node(dom_query_selector(selector))
}

/// Every node of the page that `selector` matches, in the page's order.
pub fn query_selector_all(selector: String) -> [Element] { nodes(dom_query_all(selector)) }

/// The element whose `id` attribute is `id`.
pub fn element_by_id(id: String) -> Option<Element> { maybe_node(dom_element_by_id(id)) }

impl Element {
    /// The node's name in lower case: `"div"` for a `<div>`, `"#text"` for
    /// a text node.
    pub fn tag(self) -> String { dom_tag(handle_of(self)) }

    /// Sets the attribute `name` to `value`.
    pub fn set_attribute(self, name: String, value: String) {
        dom_set_attribute(handle_of(self), name, value)
    }

    /// The attribute `name`, or `None` when the element has none.
    pub fn attribute(self, name: String) -> Option<String> {
        let h = handle_of(self)
        if dom_has_attribute(h, name) { Some(dom_attribute(h, name)) } else { None }
    }

    /// Removes the attribute `name`, if the element has it.
    pub fn remove_attribute(self, name: String) { dom_remove_attribute(handle_of(self), name) }

    /// Sets the JS property `name` to the string `value`, as `value` on an
    /// `<input>`.
    pub fn set_property(self, name: String, value: String) {
        dom_set_property(handle_of(self), name, value)
    }

    /// The JS property `name` as a string: `""` when it is unset.
    pub fn property(self, name: String) -> String { dom_property(handle_of(self), name) }

    /// Sets the JS property `name` to `value`, as `checked` on a checkbox.
    pub fn set_property_bool(self, name: String, value: Bool) {
        dom_set_property_bool(handle_of(self), name, value)
    }

    /// Whether the JS property `name` is truthy.
    pub fn property_bool(self, name: String) -> Bool { dom_property_bool(handle_of(self), name) }

    /// Replaces the node's content with the text `text`.
    pub fn set_text(self, text: String) { dom_set_text(handle_of(self), text) }

    /// The text of the node and everything in it.
    pub fn text(self) -> String { dom_text(handle_of(self)) }

    /// Adds `child` as the node's last child, moving it if it is in the
    /// page already.
    pub fn append_child(self, child: Element) {
        dom_append_child(handle_of(self), handle_of(child))
    }

    /// Adds `child` before `before`, one of the node's children, or last
    /// for `None`.
    pub fn insert_before(self, child: Element, before: Option<Element>) {
        let mut b = 0
        match before {
            Some(n) => b = handle_of(n)
            None => b = 0
        }
        dom_insert_before(handle_of(self), handle_of(child), b)
    }

    /// Removes `child`, one of the node's children.
    pub fn remove_child(self, child: Element) {
        dom_remove_child(handle_of(self), handle_of(child))
    }

    /// Removes the node from its parent, if it has one.
    pub fn remove(self) { dom_remove(handle_of(self)) }

    /// The node's parent.
    pub fn parent(self) -> Option<Element> { maybe_node(dom_parent(handle_of(self))) }

    /// The node's first child.
    pub fn first_child(self) -> Option<Element> { maybe_node(dom_first_child(handle_of(self))) }

    /// The node after this one in its parent.
    pub fn next_sibling(self) -> Option<Element> { maybe_node(dom_next_sibling(handle_of(self))) }

    /// The first node inside this one that `selector` matches.
    pub fn query_selector(self, selector: String) -> Option<Element> {
        maybe_node(dom_query_selector_in(handle_of(self), selector))
    }

    /// Clicks the element, as a user would: its `click` listeners, and its
    /// ancestors', run before this returns.
    pub fn click(self) { dom_click(handle_of(self)) }

    /// Calls `handler` with each event of kind `kind`, such as `"click"`,
    /// that reaches this node, its own or one bubbling up from inside it,
    /// until the listener is removed.
    pub fn add_event_listener(self, kind: String, handler: fn(Event)) -> Listener {
        let entry = event_entry(handler)
        let js = dom_listen(handle_of(self), kind, entry)
        Listener { target: self.box, kind: kind, entry: entry, js: rt_handle_box(js) }
    }

    /// Whether `other` is the same node: two values may hold handles to
    /// one node.
    pub fn is_same(self, other: Element) -> Bool { dom_is_same(handle_of(self), handle_of(other)) }
}

impl Listener {
    /// Removes the listener: its handler runs no more. Removing it again
    /// does nothing.
    pub fn remove(mut self) {
        if self.entry == 0 { return }
        if self.target == 0 {
            dom_window_unlisten(self.kind, rt_handle_id(self.js))
        } else {
            dom_unlisten(rt_handle_id(self.target), self.kind, rt_handle_id(self.js))
        }
        rt_closure_release(self.entry)
        self.entry = 0
    }
}

impl Event {
    /// The event's kind, such as `"click"`.
    pub fn kind(self) -> String { dom_event_kind(rt_handle_id(self.box)) }

    /// The node the event happened at, or `None` for the window's events.
    pub fn target(self) -> Option<Element> { maybe_node(dom_event_target(rt_handle_id(self.box))) }

    /// The key of a keyboard event, such as `"Enter"`, or `""` for any other
    /// event.
    pub fn key(self) -> String { dom_event_key(rt_handle_id(self.box)) }

    /// Whether Ctrl, Meta, Shift or Alt was down, or a mouse button other
    /// than the main one was pressed: a click a browser opens in a new tab
    /// or window, for one. `false` for an event with neither.
    pub fn modified(self) -> Bool { dom_event_modified(rt_handle_id(self.box)) }

    /// Stops the browser's own action for the event, such as following a
    /// link.
    pub fn prevent_default(self) { dom_prevent_default(rt_handle_id(self.box)) }

    /// Stops the event from bubbling to the node's ancestors.
    pub fn stop_propagation(self) { dom_stop_propagation(rt_handle_id(self.box)) }
}

impl Timer {
    /// Stops the timer: `f` runs no more. Clearing it again, or a timeout
    /// that has run, does nothing.
    pub fn clear(self) {
        let mut slot = self.slot
        if slot.id == 0 { return }
        let h = rt_handle_id(self.js)
        if self.repeats { dom_clear_interval(h) } else { dom_clear_timeout(h) }
        rt_closure_release(slot.id)
        slot.id = 0
    }
}

impl FetchInit {
    /// A `GET` with no headers and no body.
    pub fn new() -> FetchInit {
        let headers: [Header] = []
        FetchInit { method: "GET", headers: headers, body: "" }
    }
}
