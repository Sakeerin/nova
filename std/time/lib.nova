// A point on this process's monotonic clock.
//
// `nanos` is not privacy-enforced -- no record field in this language is --
// so a program can build `Instant { nanos: -1 }` naming no real clock
// reading. `now()` is the intended and only supported way to obtain one,
// and two are meant to be compared only through `duration_since` or
// `elapsed`. Held as nanoseconds since the runtime's single process epoch,
// so a real reading is never negative and two real `Instant`s are ordered
// by subtraction.
pub record Instant { nanos: Int }

// A span of time, held in nanoseconds because all three constructors below
// are then exactly representable, and because `elapsed` is a measurement
// whose precision a coarser unit would discard.
//
// `nanos` is not privacy-enforced either, so `Duration { nanos: -1 }`
// compiles and walks straight past every saturating constructor below.
// `from_secs`/`from_millis`/`from_micros` are the intended and only
// supported way to build one. That matters concretely: a negative or
// absurd `nanos` reaching `sleep` is treated as an immediate wake -- the
// same silent no-op the saturating constructors exist to prevent.
pub record Duration { nanos: Int }

const NANOS_PER_SEC: Int = 1_000_000_000
const NANOS_PER_MILLI: Int = 1_000_000
const NANOS_PER_MICRO: Int = 1_000

// The largest argument each constructor can scale without overflowing an
// `Int` of nanoseconds, and the smallest without underflowing one -- the
// clamped result on either side is whichever extreme of `Int` that
// direction saturates to.
//
// These exist because **Nova's `Int` wraps** -- measured:
// `9223372036854775807 + 1` is `-9223372036854775808`. A wrapped duration can
// land on either sign. Too large wraps negative, and `sleep` treats a
// non-positive duration as an immediate wake, so an unclamped `from_secs`
// would turn "sleep for ages" into "do not sleep at all", silently. Too
// negative wraps positive -- measured: `Duration::from_secs(-9_223_372_037)
// .as_secs()` and `Duration::from_secs(9_223_372_037).as_secs()` both return
// `9223372036`, byte-identical -- so an unclamped low end would turn
// "wake immediately" into "sleep for roughly 292 years", the exact inversion
// clamping exists to prevent, just on the other side of zero. Clamping both
// directions yields a saturated answer instead of a wrong one -- the
// no-panic analogue of Rust's `Duration::from_secs`, which panics on the
// same overflow (Rust's version takes an unsigned argument and so has no low
// side to clamp).
const MAX_SECS: Int = 9_223_372_036
const MAX_MILLIS: Int = 9_223_372_036_854
const MAX_MICROS: Int = 9_223_372_036_854_775
const MAX_NANOS: Int = 9_223_372_036_854_775_807
const MIN_SECS: Int = -MAX_SECS
const MIN_MILLIS: Int = -MAX_MILLIS
const MIN_MICROS: Int = -MAX_MICROS
// One further from zero than `-MAX_NANOS`: `Int` is two's-complement, so its
// negative range holds one more value than its positive range, and this is
// that value -- the most-negative `Int` representable, computed rather than
// spelled out because the positive literal one larger than `MAX_NANOS` would
// itself overflow.
const MIN_NANOS: Int = -MAX_NANOS - 1

impl Instant {
    // The current reading of the monotonic clock.
    pub fn now() -> Instant {
        Instant { nanos: time_now_nanos() }
    }

    // How long since `self`. Zero if `self` is somehow in the future.
    pub fn elapsed(self) -> Duration {
        Instant::now().duration_since(self)
    }

    // The span from `earlier` to `self`, **saturating at zero** so an elapsed
    // time can never come back negative when the arguments are the wrong way
    // round.
    pub fn duration_since(self, earlier: Instant) -> Duration {
        if self.nanos <= earlier.nanos {
            Duration { nanos: 0 }
        } else {
            Duration { nanos: self.nanos - earlier.nanos }
        }
    }
}

impl Duration {
    // Whole seconds. Clamps above `MAX_SECS` and below `MIN_SECS`; see the
    // constants above.
    pub fn from_secs(s: Int) -> Duration {
        if s > MAX_SECS {
            Duration { nanos: MAX_NANOS }
        } else if s < MIN_SECS {
            Duration { nanos: MIN_NANOS }
        } else {
            Duration { nanos: s * NANOS_PER_SEC }
        }
    }

    // Whole milliseconds. Clamps above `MAX_MILLIS` and below `MIN_MILLIS`.
    pub fn from_millis(ms: Int) -> Duration {
        if ms > MAX_MILLIS {
            Duration { nanos: MAX_NANOS }
        } else if ms < MIN_MILLIS {
            Duration { nanos: MIN_NANOS }
        } else {
            Duration { nanos: ms * NANOS_PER_MILLI }
        }
    }

    // Whole microseconds. Clamps above `MAX_MICROS` and below `MIN_MICROS`.
    pub fn from_micros(us: Int) -> Duration {
        if us > MAX_MICROS {
            Duration { nanos: MAX_NANOS }
        } else if us < MIN_MICROS {
            Duration { nanos: MIN_NANOS }
        } else {
            Duration { nanos: us * NANOS_PER_MICRO }
        }
    }

    // Whole seconds, truncating. `from_millis(1500).as_secs()` is `1`.
    pub fn as_secs(self) -> Int {
        self.nanos / NANOS_PER_SEC
    }

    // Whole milliseconds, truncating. `from_micros(1).as_millis()` is `0`,
    // which `tests/runtime/time_conversions.nova` pins deliberately.
    pub fn as_millis(self) -> Int {
        self.nanos / NANOS_PER_MILLI
    }
}

// Suspend the current task for at least `d`.
//
// Parks rather than spins: this registers a deadline with the executor and is
// not polled again until that deadline passes, so a sleeping task costs no
// polls at all. Contrast `std/task`'s `yield_now`, which is re-queued
// immediately and deliberately.
//
// "At least" is exact, and platform-dependent in its granularity only. The
// executor waits with microsecond granularity on Unix and whole milliseconds
// on Windows, truncating a remaining duration the ordinary way and lifting
// only a result that truncated all the way to zero back up to one unit --
// never down to zero, not always up. So a sub-millisecond sleep on Windows
// takes about a millisecond, but a 1.5ms remainder there becomes 1ms, not
// 2ms. What makes "at least" hold regardless is the executor's own wake
// check: a task parked on a deadline is only woken once that deadline is
// `<=` the clock reading it is checked against, so a platform wait that
// returns early just re-parks on the same deadline instead of waking the
// sleeper ahead of schedule. A non-positive `d` wakes immediately rather
// than being rejected.
pub async fn sleep(d: Duration) {
    task_sleep_future_nanos(d.nanos).await
}
