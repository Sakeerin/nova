// Nova standard library — core.
//
// Compiled as an implicit module and glob-imported into every user module, so
// these names need no `import`. A user definition of the same name shadows the
// one here (see docs/adr/0004-stdlib-compile-model.md).

pub type Option<T> = | Some(T) | None

pub type Result<T, E> = | Ok(T) | Err(E)

impl<T> Option<T> {
    pub fn is_some(self) -> Bool {
        match self { Some(_) => true, None => false }
    }

    pub fn is_none(self) -> Bool { !self.is_some() }

    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self { Some(v) => Some(f(v)), None => None }
    }

    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self { Some(v) => f(v), None => None }
    }

    pub fn unwrap(self) -> T {
        match self { Some(v) => v, None => panic("called `unwrap` on a `None` value") }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self { Some(v) => v, None => default }
    }

    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self { Some(v) => Ok(v), None => Err(err) }
    }
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> Bool {
        match self { Ok(_) => true, Err(_) => false }
    }

    pub fn is_err(self) -> Bool { !self.is_ok() }

    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self { Ok(v) => Ok(f(v)), Err(e) => Err(e) }
    }

    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self { Ok(v) => Ok(v), Err(e) => Err(f(e)) }
    }

    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self { Ok(v) => f(v), Err(e) => Err(e) }
    }

    pub fn unwrap(self) -> T {
        match self { Ok(v) => v, Err(_) => panic("called `unwrap` on an `Err` value") }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self { Ok(v) => v, Err(_) => default }
    }
}

// Core traits, and their impls for the five primitive types.
//
// `Ord` cannot be written uniformly: `<` works for Int/Float/Char but not
// for Bool or String (E0013 for both). Bool is ordered with `if` alone;
// String has neither length nor indexing in Nova, so it goes through
// `str_cmp`, a compiler builtin (see `nova-resolver`'s `Builtin` enum) that
// reaches the runtime's byte-lexicographic `nova_rt_str_cmp` directly: a
// named function, resolved specially by the compiler and lowered straight to
// a runtime call — the same way `println`/`print`/`panic` reach the runtime.
// This is *not* how `==` on `String` reaches `nova_rt_str_eq`: `==` is a
// pure operator lowering (`binary_result_ty` permits `Eq`/`Ne` for
// `Ty::String`; MIR's `lower_binary` intercepts it) that introduces no name
// in any namespace, so it has no "reserved word" concern to begin with.
// `str_cmp` does, and unlike `println`/`print`/`panic` it is not meant to be
// user-visible language surface, so it is seeded only into this module's own
// scope (`Builtin::STD_CORE_ONLY`), not into every module — a user program
// may freely define its own `str_cmp` (String is not FFI-safe, and
// `nova_`-prefixed extern symbols are reserved by the compiler, so a
// user-visible `extern` was not an option either).

pub type Ordering = | Less | Equal | Greater

pub trait Display { fn fmt(self) -> String }

pub trait Debug { fn dbg(self) -> String }

pub trait Eq {
    fn eq(self, other: Self) -> Bool
    fn ne(self, other: Self) -> Bool { !self.eq(other) }
}

pub trait Ord: Eq { fn cmp(self, other: Self) -> Ordering }

pub trait Clone { fn clone(self) -> Self }

pub trait Default { fn default() -> Self }

impl Display for Int    { fn fmt(self) -> String { "${self}" } }
impl Display for Float  { fn fmt(self) -> String { "${self}" } }
impl Display for Bool   { fn fmt(self) -> String { "${self}" } }
impl Display for Char   { fn fmt(self) -> String { "${self}" } }
impl Display for String { fn fmt(self) -> String { self } }

// `Debug`'s contract is that its output is a *Nova literal* for the value, so
// `Char` and `String` are quoted where `Display` is not. Nova's lexer accepts
// `\n \t \r \\ \0 \u{…}` plus `\"` in a string literal and `\'` in a char
// literal (`nova-lexer`'s string scanner and `lex_char`); `\"` is not valid in
// a char literal, nor `\'` in a string one, so each form escapes only the
// quote that delimits it, plus the backslash.
impl Debug for Int    { fn dbg(self) -> String { "${self}" } }
impl Debug for Float  { fn dbg(self) -> String { "${self}" } }
impl Debug for Bool   { fn dbg(self) -> String { "${self}" } }
// Backslash is tested first, so the backslash that `\'` and friends introduce
// is never itself re-escaped. The escaped set is exactly what `lex_char`
// accepts, so every output here round-trips back through the lexer to `self`.
// A raw newline/tab/NUL does lex inside `'…'`, but emitting one would put a
// control character in the middle of debug output, which defeats the purpose.
impl Debug for Char {
    fn dbg(self) -> String {
        if self == '\\' { "'\\\\'" }
        else if self == '\'' { "'\\''" }
        else if self == '\n' { "'\\n'" }
        else if self == '\t' { "'\\t'" }
        else if self == '\r' { "'\\r'" }
        else if self == '\0' { "'\\0'" }
        else { "'${self}'" }
    }
}
// LIMITATION: this cannot escape, so a string containing `"` or `\` debugs to
// something that is not a valid Nova literal — `("a\"b").dbg()` is `"a"b"`.
// Escaping needs to inspect the string's contents, and Nova has no way to:
// `String` has no length, indexing, or iteration, and it is not FFI-safe
// (`require_ffi_safe` accepts only scalars), so no `extern` can reach it
// either. Closing this needs a new compiler builtin alongside `str_cmp` (a
// `str_escape` in `Builtin::STD_CORE_ONLY`, backed by a runtime
// `nova_rt_str_escape`) — deliberately deferred rather than improvised here,
// since it adds a runtime ABI symbol. `Char` above escapes correctly because
// a `Char` *can* be compared, so it needs no such inspection.
impl Debug for String { fn dbg(self) -> String { "\"${self}\"" } }

impl Eq for Int    { fn eq(self, other: Int) -> Bool { self == other } }
// Not reflexive for NaN: `NaN == NaN` is `false`, so `eq(NaN, NaN)` is
// `false` too (NaN is reachable, e.g. via `0.0 / 0.0`). See the `Ord for
// Float` impl below for the related non-total-order caveat.
impl Eq for Float  { fn eq(self, other: Float) -> Bool { self == other } }
impl Eq for Bool   { fn eq(self, other: Bool) -> Bool { self == other } }
impl Eq for Char   { fn eq(self, other: Char) -> Bool { self == other } }
impl Eq for String { fn eq(self, other: String) -> Bool { self == other } }

impl Ord for Int {
    fn cmp(self, other: Int) -> Ordering {
        if self < other { Less } else { if self == other { Equal } else { Greater } }
    }
}
impl Ord for Float {
    // Not a total order for NaN: `<` and `==` are both `false` whenever
    // either operand is NaN, so this falls through to `Greater` for any
    // comparison involving NaN — including `cmp(NaN, NaN)`, which is
    // `Greater`, not `Equal`. Ordering NaN is unspecified; do not rely on it
    // (e.g. for a future sorted collection) until addressed by design.
    fn cmp(self, other: Float) -> Ordering {
        if self < other { Less } else { if self == other { Equal } else { Greater } }
    }
}
impl Ord for Char {
    fn cmp(self, other: Char) -> Ordering {
        if self < other { Less } else { if self == other { Equal } else { Greater } }
    }
}
impl Ord for Bool {
    // `<` is not defined for Bool; false sorts before true.
    fn cmp(self, other: Bool) -> Ordering {
        if self {
            if other { Equal } else { Greater }
        } else {
            if other { Less } else { Equal }
        }
    }
}
impl Ord for String {
    // String has neither length nor indexing in Nova, so ordering comes from
    // `str_cmp`, a compiler builtin backed by the runtime's byte-lexicographic
    // compare (see the module-level note above for why not `extern`).
    fn cmp(self, other: String) -> Ordering {
        let c = str_cmp(self, other)
        if c < 0 { Less } else { if c == 0 { Equal } else { Greater } }
    }
}

impl Clone for Int    { fn clone(self) -> Int { self } }
impl Clone for Float  { fn clone(self) -> Float { self } }
impl Clone for Bool   { fn clone(self) -> Bool { self } }
impl Clone for Char   { fn clone(self) -> Char { self } }
impl Clone for String { fn clone(self) -> String { self } }

impl Default for Int    { fn default() -> Int { 0 } }
impl Default for Float  { fn default() -> Float { 0.0 } }
impl Default for Bool   { fn default() -> Bool { false } }
impl Default for Char   { fn default() -> Char { '\0' } }
impl Default for String { fn default() -> String { "" } }
