// Nova standard library — the runtime of a WASM build.
//
// Compiled only when the target is WASM (spec
// docs/superpowers/specs/2026-10-14-phase-4-0-foundations-design.md §5, and
// for the allocator, the collector and the executor,
// docs/superpowers/specs/2026-10-15-phase-4-1-the-language-on-wasm-design.md).
// Where a native build calls a `nova-runtime` function, MIR calls the
// function here of the same name with an `rt_` prefix, and each is a port of
// that one, with the same results. The few that are `pub` are for std's
// other modules, which alone see `std/rt`'s names (spec
// docs/superpowers/specs/2026-10-16-phase-4-2-std-dom-and-the-shim-design.md
// §5), so no program sees them.
//
// A runtime value is an `Int` address. A `String` or `Bytes` value is a
// 16-byte header: its length at offset 0, and at offset 8 the address of its
// bytes. An array is `{len, elems...}`, element `i` at offset `8 + 8*i`.
// Memory is read and written through the `mem_*` builtins, which only this
// target's std sees.

// The runtime's state words, at fixed addresses below the data segment
// (spec 4.0 §4.1, 4.1 §6.1, 4.2 §4.2, §5.1, 4.3 §4): Nova has no mutable
// globals. Each is named where it is used: `HEAP_META`, `STR_SEED`,
// `STR_SEED_DRAWN`, `LOG_SET`, `LOG_LEVEL`, `EXEC`, `GC_SINCE`, `GC_NEXT`,
// `GC_COUNT`, `GC_SWITCHES`, `HANDLES`, `CALLS` and `UI_STATE`, at 8 to
// 104.

// The allocator (spec 4.1 §6.2), ported from `nova-runtime`'s
// `gc/pages.rs`. Memory from the first 64 KiB boundary at or above
// `heap_base()` holds the allocator's metadata, three WASM pages; then come
// the heap's pages, also 64 KiB. A small object, 2,048 bytes or less, takes
// a slot in a page of one size class; a larger one takes a run of whole
// pages. What the collector records of a small object is in its page's
// bitmaps, and of a large one in front of it in its first page, found
// through the page table: nothing read from an object's own bytes is taken
// for either.

// The address of the allocator's metadata, or 0 before the first
// allocation. The metadata: at 0 the first heap page's number, at 8 the
// frontier's (the first page never used), at 16, 24 and 32 the collector's
// worklist, its capacity and its length, and at 40, 48 and 56 the last
// sweep's freed bytes, live objects and live bytes; at 64, 256 and 448
// three words per size class:
// the page it allocates from, the slot it looks at next, and the first of
// its other pages with a free slot; and at 1024 the page table, a word per
// page of the largest memory. A page's word is 0 outside the heap, else a
// kind and 256 times a datum: 1 free; 2 small, with its class; 3 the first
// page of a large object, with its page count; 4 a large object's later
// page, with its first page's number; 5 the collector's.
const HEAP_META: Int = 8

// Bytes allocated since the last collection.
const GC_SINCE: Int = 56

// The page size, the largest memory in pages (1 GB), and the largest
// object, which is also the largest allocation.
const PAGE: Int = 65536

const MAX_PAGES: Int = 16384

const MAX_ALLOC: Int = 1073741824

// A small page's header: its class at 0, its slot size at 8, its slot count
// at 16, and the next page of its class with a free slot at 24; then three
// bitmaps of 64 words, a bit per slot: allocated at 32, marked at 544 and
// scanned at 1056. The slots start at 1568.
const SLOTS: Int = 1568

// The metadata, made the first time it is asked for. Memory starts
// zeroed, so every page's word starts at 0.
fn heap_meta() -> Int {
    let m = mem_load64(HEAP_META)
    if m != 0 { return m }
    let at = (heap_base() + PAGE - 1) & (0 - PAGE)
    let first = at / PAGE + 3
    grow_to(first)
    mem_store64(at, first)
    mem_store64(at + 8, first)
    mem_store64(HEAP_META, at)
    at
}

// Memory of `pages` pages at least.
fn grow_to(pages: Int) {
    let have = mem_pages()
    if pages > have { if mem_grow(pages - have) < 0 { panic("out of memory") } }
}

// Page `p`'s word, and setting it.
fn page_word(m: Int, p: Int) -> Int { mem_load64(m + 1024 + 8 * p) }

fn set_page_word(m: Int, p: Int, w: Int) { mem_store64(m + 1024 + 8 * p, w) }

// The size class of `n` bytes, for `1 <= n <= 2048`: `CLASS_OF` in
// `gc/pages.rs`, whose 24 classes step by 16 to 128, then by 32, 64, 128
// and 256, each to twice the last.
fn class_of(n: Int) -> Int {
    if n <= 128 {
        (n + 15) / 16 - 1
    } else if n <= 256 {
        8 + (n - 129) / 32
    } else if n <= 512 {
        12 + (n - 257) / 64
    } else if n <= 1024 {
        16 + (n - 513) / 128
    } else {
        20 + (n - 1025) / 256
    }
}

// The slot size of class `c`: `CLASS_SIZES` in `gc/pages.rs`.
fn class_size(c: Int) -> Int {
    if c < 8 {
        16 * (c + 1)
    } else if c < 12 {
        128 + 32 * (c - 7)
    } else if c < 16 {
        256 + 64 * (c - 11)
    } else if c < 20 {
        512 + 128 * (c - 15)
    } else {
        1024 + 256 * (c - 19)
    }
}

// `n` pages in a row for the allocator: the first free run of them, else at
// the frontier, which a run of free pages just below it joins, growing the
// memory as needed.
fn take_pages(m: Int, n: Int) -> Int {
    let frontier = mem_load64(m + 8)
    let mut run = 0
    let mut p = mem_load64(m)
    while p < frontier {
        if page_word(m, p) == 1 {
            run = run + 1
            if run == n { return p + 1 - n }
        } else {
            run = 0
        }
        p = p + 1
    }
    let start = frontier - run
    if start + n > MAX_PAGES { panic("out of memory") }
    grow_to(start + n)
    mem_store64(m + 8, start + n)
    start
}

// A new page for class `c`, with every slot free.
fn new_page(m: Int, c: Int) -> Int {
    let p = take_pages(m, 1)
    let base = p * PAGE
    mem_fill(base, 0, SLOTS)
    let slot = class_size(c)
    mem_store64(base, c)
    mem_store64(base + 8, slot)
    mem_store64(base + 16, (PAGE - SLOTS) / slot)
    set_page_word(m, p, 2 + 256 * c)
    p
}

// A free slot of page `p`, class `c`, from the class's next slot on, zeroed
// and marked allocated and, if `scan`, scanned; or 0 when there is none.
fn page_take(m: Int, c: Int, p: Int, scan: Bool) -> Int {
    let base = p * PAGE
    let n = mem_load64(base + 16)
    let mut i = mem_load64(m + 256 + 8 * c)
    while i < n {
        let w = base + 32 + 8 * (i >> 6)
        let bits = mem_load64(w)
        if bits == 0 - 1 {
            i = ((i >> 6) + 1) << 6
        } else if ((bits >> (i & 63)) & 1) == 0 {
            let bit = 1 << (i & 63)
            mem_store64(w, bits | bit)
            let sw = w + 1024
            if scan {
                mem_store64(sw, mem_load64(sw) | bit)
            } else {
                mem_store64(sw, mem_load64(sw) & (bit ^ (0 - 1)))
            }
            mem_store64(m + 256 + 8 * c, i + 1)
            let slot = mem_load64(base + 8)
            let at = base + SLOTS + i * slot
            mem_fill(at, 0, slot)
            return at
        } else {
            i = i + 1
        }
    }
    mem_store64(m + 256 + 8 * c, n)
    0
}

// A slot of class `c`: from the class's page, then its other pages with a
// free slot, then a new page (`alloc_slot` in `gc/pages.rs`).
fn small_alloc(m: Int, c: Int, scan: Bool) -> Int {
    while true {
        let p = mem_load64(m + 64 + 8 * c)
        if p == 0 {
            mem_store64(m + 64 + 8 * c, new_page(m, c))
            mem_store64(m + 256 + 8 * c, 0)
        } else {
            let at = page_take(m, c, p, scan)
            if at != 0 { return at }
            let next = mem_load64(m + 448 + 8 * c)
            if next != 0 { mem_store64(m + 448 + 8 * c, mem_load64(next * PAGE + 24)) }
            mem_store64(m + 64 + 8 * c, next)
            mem_store64(m + 256 + 8 * c, 0)
        }
    }
    0
}

// A large object: a run of pages, its size at the first one's start and at
// 8 its flags (1 marked, 2 scanned), then the object, zeroed.
fn large_alloc(m: Int, n: Int, scan: Bool) -> Int {
    let pages = (n + 16 + PAGE - 1) / PAGE
    let p = take_pages(m, pages)
    let base = p * PAGE
    mem_fill(base, 0, n + 16)
    mem_store64(base, n)
    if scan { mem_store64(base + 8, 2) }
    set_page_word(m, p, 3 + 256 * pages)
    let mut k = 1
    while k < pages {
        set_page_word(m, p + k, 4 + 256 * p)
        k = k + 1
    }
    base + 16
}

// `size` bytes, zeroed, 8-aligned, traced by the collector if `scan`
// (`gc::alloc` in `nova-runtime`). Over 1 GB is refused before any page
// arithmetic. What it takes, a whole slot for a small object, counts toward
// the next collection.
fn gc_alloc(size: Int, scan: Bool) -> Int {
    if size > MAX_ALLOC { panic("out of memory") }
    let mut n = size
    if n < 8 { n = 8 }
    n = (n + 7) & -8
    let m = heap_meta()
    let mut taken = n
    let mut at = 0
    if n <= 2048 {
        let c = class_of(n)
        taken = class_size(c)
        at = small_alloc(m, c, scan)
    } else {
        at = large_alloc(m, n, scan)
    }
    mem_store64(GC_SINCE, mem_load64(GC_SINCE) + taken)
    at
}

// `nova_rt_alloc`: an object the collector traces. MIR calls it for every
// record, sum, array, closure and `async fn` state, and the shim as
// `nova_alloc`.
fn rt_alloc(size: Int) -> Int { gc_alloc(size, true) }

// A leaf: an object the collector keeps but does not trace, as a string's
// or a `Bytes`' is (spec 4.1 §6.3). The shim calls it as `nova_alloc_leaf`.
fn rt_alloc_leaf(size: Int) -> Int { gc_alloc(size, false) }

// A string's length in bytes.
fn str_len(s: Int) -> Int { mem_load64(s) }

// The address of a string's bytes. The header keeps it in the low half of
// its second word, the high half zero.
fn str_bytes(s: Int) -> Int { mem_load64(s + 8) }

// A header for `len` bytes, with the bytes inline at offset 16, as
// `nova-runtime`'s `alloc_str_object`, a leaf. Room for one byte at least,
// so an empty string's bytes are still its own.
fn rt_str_alloc(len: Int) -> Int {
    let mut room = len
    if room < 1 { room = 1 }
    let h = rt_alloc_leaf(16 + room)
    mem_store64(h, len)
    mem_store64(h + 8, h + 16)
    h
}

// `nova_rt_str_concat`.
fn rt_str_concat(a: Int, b: Int) -> Int {
    let la = str_len(a)
    let lb = str_len(b)
    let h = rt_str_alloc(la + lb)
    let at = str_bytes(h)
    mem_copy(at, str_bytes(a), la)
    mem_copy(at + la, str_bytes(b), lb)
    h
}

// `nova_rt_str_concat_n`: every string of the array `parts`, in order. A
// negative length counts as zero.
fn rt_str_concat_n(parts: Int) -> Int {
    let mut n = mem_load64(parts)
    if n < 0 { n = 0 }
    let mut total = 0
    let mut i = 0
    while i < n {
        total = total + str_len(mem_load64(parts + 8 + 8 * i))
        i = i + 1
    }
    let h = rt_str_alloc(total)
    let mut at = str_bytes(h)
    i = 0
    while i < n {
        let part = mem_load64(parts + 8 + 8 * i)
        let len = str_len(part)
        mem_copy(at, str_bytes(part), len)
        at = at + len
        i = i + 1
    }
    h
}

// `nova_rt_int_to_str`. The digits are counted and written on the negative
// side, where `i64::MIN` still has a value.
fn rt_int_to_str(v: Int) -> Int {
    let negative = v < 0
    let mut rest = v
    if !negative { rest = -v }
    let mut digits = 1
    let mut t = rest / 10
    while t != 0 {
        digits = digits + 1
        t = t / 10
    }
    let mut len = digits
    if negative { len = len + 1 }
    let h = rt_str_alloc(len)
    let start = str_bytes(h)
    let mut at = start + len
    let mut k = 0
    while k < digits {
        at = at - 1
        mem_store8(at, 48 - rest % 10)
        rest = rest / 10
        k = k + 1
    }
    if negative { mem_store8(start, 45) }
    h
}

// A copy of the string or bytes `s`: `gc_str` and `gc_bytes`, which copy.
fn str_copy(s: Int) -> Int {
    let len = str_len(s)
    let h = rt_str_alloc(len)
    mem_copy(str_bytes(h), str_bytes(s), len)
    h
}

// A new string of the ASCII bytes `b0..b4`, of which the first `n` count.
fn ascii(n: Int, b0: Int, b1: Int, b2: Int, b3: Int, b4: Int) -> Int {
    let h = rt_str_alloc(n)
    let at = str_bytes(h)
    mem_store8(at, b0)
    if n > 1 { mem_store8(at + 1, b1) }
    if n > 2 { mem_store8(at + 2, b2) }
    if n > 3 { mem_store8(at + 3, b3) }
    if n > 4 { mem_store8(at + 4, b4) }
    h
}

// `nova_rt_bool_to_str`.
fn rt_bool_to_str(v: Bool) -> Int {
    if v { ascii(4, 116, 114, 117, 101, 0) } else { ascii(5, 102, 97, 108, 115, 101) }
}

// `char::from_u32(v as u32)`, or U+FFFD where that is `None`.
fn scalar(v: Int) -> Int {
    let c = v & 4294967295
    if c > 1114111 || (c >= 55296 && c <= 57343) { 65533 } else { c }
}

// How many bytes UTF-8 takes for the scalar value `c`.
fn utf8_len(c: Int) -> Int {
    if c < 128 { 1 } else if c < 2048 { 2 } else if c < 65536 { 3 } else { 4 }
}

// Write `c` as UTF-8 at `at`, returning the address after it.
fn utf8_put(at: Int, c: Int) -> Int {
    if c < 128 {
        mem_store8(at, c)
        at + 1
    } else if c < 2048 {
        mem_store8(at, 192 | (c >> 6))
        mem_store8(at + 1, 128 | (c & 63))
        at + 2
    } else if c < 65536 {
        mem_store8(at, 224 | (c >> 12))
        mem_store8(at + 1, 128 | ((c >> 6) & 63))
        mem_store8(at + 2, 128 | (c & 63))
        at + 3
    } else {
        mem_store8(at, 240 | (c >> 18))
        mem_store8(at + 1, 128 | ((c >> 12) & 63))
        mem_store8(at + 2, 128 | ((c >> 6) & 63))
        mem_store8(at + 3, 128 | (c & 63))
        at + 4
    }
}

// `nova_rt_char_to_str`.
fn rt_char_to_str(v: Int) -> Int {
    let c = scalar(v)
    let h = rt_str_alloc(utf8_len(c))
    utf8_put(str_bytes(h), c)
    h
}

// Whether the `n` bytes at `p` and at `q` are equal.
fn mem_eq(p: Int, q: Int, n: Int) -> Bool {
    let mut i = 0
    while i < n {
        if mem_load8(p + i) != mem_load8(q + i) { return false }
        i = i + 1
    }
    true
}

// `nova_rt_str_eq`, and `nova_rt_bytes_eq`.
fn rt_str_eq(a: Int, b: Int) -> Bool {
    let n = str_len(a)
    if n != str_len(b) { return false }
    mem_eq(str_bytes(a), str_bytes(b), n)
}

// `nova_rt_str_cmp`: byte by byte, then the shorter first.
fn rt_str_cmp(a: Int, b: Int) -> Int {
    let la = str_len(a)
    let lb = str_len(b)
    let mut n = la
    if lb < n { n = lb }
    let pa = str_bytes(a)
    let pb = str_bytes(b)
    let mut i = 0
    while i < n {
        let x = mem_load8(pa + i)
        let y = mem_load8(pb + i)
        if x < y { return -1 }
        if x > y { return 1 }
        i = i + 1
    }
    if la < lb { -1 } else if la > lb { 1 } else { 0 }
}

// `z >> k` as an unsigned shift: Nova's `>>` keeps the sign.
fn shr(z: Int, k: Int) -> Int { (z >> k) & ((1 << (64 - k)) - 1) }

// `nova-runtime`'s `splitmix64_finalize`.
fn splitmix(value: Int) -> Int {
    let mut z = value
    z = z ^ shr(z, 30)
    z = z * -4658895280553007687
    z = z ^ shr(z, 27)
    z = z * -7723592293110705685
    z ^ shr(z, 31)
}

// The state words of `str_hash`'s seed: the seed, and whether it is drawn.
const STR_SEED: Int = 16

const STR_SEED_DRAWN: Int = 24

// `str_hash_seed`: drawn once per run from the shim's random seed, kept
// apart from `int_hash_seed`'s own value, as the native seeds are apart.
fn str_seed() -> Int {
    if mem_load64(STR_SEED_DRAWN) == 0 {
        mem_store64(STR_SEED, splitmix(int_hash_seed() ^ 6148914691236517205))
        mem_store64(STR_SEED_DRAWN, 1)
    }
    mem_load64(STR_SEED)
}

// `nova_rt_str_hash`: seeded FNV-1a over the bytes, then the finalizer.
fn rt_str_hash(s: Int) -> Int {
    let mut h = str_seed()
    let p = str_bytes(s)
    let n = str_len(s)
    let mut i = 0
    while i < n {
        h = (h ^ mem_load8(p + i)) * 1099511628211
        i = i + 1
    }
    splitmix(h)
}

// How many characters the `n` bytes of UTF-8 at `p` hold: the bytes that
// do not continue one.
fn chars_in(p: Int, n: Int) -> Int {
    let mut count = 0
    let mut i = 0
    while i < n {
        if (mem_load8(p + i) & 192) != 128 { count = count + 1 }
        i = i + 1
    }
    count
}

// `nova_rt_str_len_chars`.
fn rt_str_len_chars(s: Int) -> Int { chars_in(str_bytes(s), str_len(s)) }

// `nova_rt_str_chars`: the string's characters, as an array of scalar
// values. The string is valid UTF-8.
fn rt_str_chars(s: Int) -> Int {
    let p = str_bytes(s)
    let len = str_len(s)
    let n = chars_in(p, len)
    let arr = rt_alloc(8 + 8 * n)
    mem_store64(arr, n)
    let mut i = 0
    let mut k = 0
    while i < len {
        let b = mem_load8(p + i)
        let mut c = b
        let mut width = 1
        if b >= 240 {
            c = ((b & 7) << 18) | ((mem_load8(p + i + 1) & 63) << 12)
            c = c | ((mem_load8(p + i + 2) & 63) << 6) | (mem_load8(p + i + 3) & 63)
            width = 4
        } else if b >= 224 {
            c = ((b & 15) << 12) | ((mem_load8(p + i + 1) & 63) << 6)
            c = c | (mem_load8(p + i + 2) & 63)
            width = 3
        } else if b >= 192 {
            c = ((b & 31) << 6) | (mem_load8(p + i + 1) & 63)
            width = 2
        }
        mem_store64(arr + 8 + 8 * k, c)
        k = k + 1
        i = i + width
    }
    arr
}

// `nova_rt_str_from_chars`: an invalid value becomes U+FFFD, and a negative
// length counts as zero.
fn rt_str_from_chars(chars: Int) -> Int {
    let mut n = mem_load64(chars)
    if n < 0 { n = 0 }
    let mut total = 0
    let mut i = 0
    while i < n {
        total = total + utf8_len(scalar(mem_load64(chars + 8 + 8 * i)))
        i = i + 1
    }
    let h = rt_str_alloc(total)
    let mut at = str_bytes(h)
    i = 0
    while i < n {
        at = utf8_put(at, scalar(mem_load64(chars + 8 + 8 * i)))
        i = i + 1
    }
    h
}

// `nova_rt_str_join`: the parts, with `sep` between each pair.
fn rt_str_join(sep: Int, parts: Int) -> Int {
    let mut n = mem_load64(parts)
    if n < 0 { n = 0 }
    let ls = str_len(sep)
    let mut total = 0
    if n > 0 { total = ls * (n - 1) }
    let mut i = 0
    while i < n {
        total = total + str_len(mem_load64(parts + 8 + 8 * i))
        i = i + 1
    }
    let h = rt_str_alloc(total)
    let mut at = str_bytes(h)
    i = 0
    while i < n {
        if i > 0 {
            mem_copy(at, str_bytes(sep), ls)
            at = at + ls
        }
        let part = mem_load64(parts + 8 + 8 * i)
        let len = str_len(part)
        mem_copy(at, str_bytes(part), len)
        at = at + len
        i = i + 1
    }
    h
}

// `nova_rt_str_index_of`: the character index of the first `needle` in
// `haystack`, or -1. A byte match starts on a character boundary, since no
// character starts with a continuation byte.
fn rt_str_index_of(haystack: Int, needle: Int) -> Int {
    let h = str_bytes(haystack)
    let lh = str_len(haystack)
    let n = str_bytes(needle)
    let ln = str_len(needle)
    let mut at = 0
    while at + ln <= lh {
        if mem_eq(h + at, n, ln) { return chars_in(h, at) }
        at = at + 1
    }
    // Not `-1` on a line of its own, which would continue the `while`.
    0 - 1
}

// The extra bytes byte `b` takes in a JSON string literal.
fn json_extra(b: Int) -> Int {
    if b == 34 || b == 92 || b == 10 || b == 13 || b == 9 || b == 8 || b == 12 {
        1
    } else if b < 32 {
        5
    } else {
        0
    }
}

// The letter of a hex digit, lowercase.
fn hex_digit(d: Int) -> Int { if d < 10 { 48 + d } else { 87 + d } }

// `nova_rt_json_quote`: `s` as a JSON string literal, quotes included
// (RFC 8259).
fn rt_json_quote(s: Int) -> Int {
    let p = str_bytes(s)
    let n = str_len(s)
    let mut extra = 0
    let mut i = 0
    while i < n {
        extra = extra + json_extra(mem_load8(p + i))
        i = i + 1
    }
    let h = rt_str_alloc(n + 2 + extra)
    let mut at = str_bytes(h)
    mem_store8(at, 34)
    at = at + 1
    i = 0
    while i < n {
        let b = mem_load8(p + i)
        let e = json_extra(b)
        if e == 0 {
            mem_store8(at, b)
            at = at + 1
        } else if e == 1 {
            mem_store8(at, 92)
            let mut letter = b
            if b == 10 { letter = 110 }
            if b == 13 { letter = 114 }
            if b == 9 { letter = 116 }
            if b == 8 { letter = 98 }
            if b == 12 { letter = 102 }
            mem_store8(at + 1, letter)
            at = at + 2
        } else {
            mem_store8(at, 92)
            mem_store8(at + 1, 117)
            mem_store8(at + 2, 48)
            mem_store8(at + 3, 48)
            mem_store8(at + 4, hex_digit(b >> 4))
            mem_store8(at + 5, hex_digit(b & 15))
            at = at + 6
        }
        i = i + 1
    }
    mem_store8(at, 34)
    h
}

// `nova_rt_check_bounds`.
fn rt_check_bounds(index: Int, len: Int) {
    if index < 0 || index >= len { panic("array index ${index} out of bounds for length ${len}") }
}

// `nova_rt_bytes_len`.
fn rt_bytes_len(b: Int) -> Int { str_len(b) }

// `nova_rt_bytes_from_string`.
fn rt_bytes_from_string(s: Int) -> Int { str_copy(s) }

// Whether byte `b` continues a UTF-8 character.
fn continues(b: Int) -> Bool { b >= 128 && b <= 191 }

// `nova_rt_bytes_is_utf8`: `std::str::from_utf8`'s rules. No overlong form,
// no surrogate, nothing past U+10FFFF.
fn rt_bytes_is_utf8(b: Int) -> Bool {
    let p = str_bytes(b)
    let n = str_len(b)
    let mut i = 0
    while i < n {
        let b0 = mem_load8(p + i)
        if b0 < 128 {
            i = i + 1
        } else {
            let mut width = 0
            let mut lo = 128
            let mut hi = 191
            if b0 >= 194 && b0 <= 223 { width = 2 }
            if b0 >= 224 && b0 <= 239 { width = 3 }
            if b0 >= 240 && b0 <= 244 { width = 4 }
            if b0 == 224 { lo = 160 }
            if b0 == 237 { hi = 159 }
            if b0 == 240 { lo = 144 }
            if b0 == 244 { hi = 143 }
            if width == 0 || i + width > n { return false }
            let b1 = mem_load8(p + i + 1)
            if b1 < lo || b1 > hi { return false }
            let mut k = 2
            while k < width {
                if !continues(mem_load8(p + i + k)) { return false }
                k = k + 1
            }
            i = i + width
        }
    }
    true
}

// `nova_rt_bytes_to_string_unchecked`.
fn rt_bytes_to_string_unchecked(b: Int) -> Int { str_copy(b) }

// `nova_rt_bytes_at`.
fn rt_bytes_at(b: Int, i: Int) -> Int {
    if i < 0 { panic("nova_rt_bytes_at: negative index") }
    if i >= str_len(b) { panic("nova_rt_bytes_at: index out of range") }
    mem_load8(str_bytes(b) + i)
}

// `nova_rt_bytes_slice`: the bounds clamped to `0..len`, and empty when
// they cross.
fn rt_bytes_slice(b: Int, start: Int, end: Int) -> Int {
    let len = str_len(b)
    let mut lo = start
    if lo < 0 { lo = 0 }
    if lo > len { lo = len }
    let mut hi = end
    if hi < 0 { hi = 0 }
    if hi > len { hi = len }
    if hi <= lo { return rt_str_alloc(0) }
    let h = rt_str_alloc(hi - lo)
    mem_copy(str_bytes(h), str_bytes(b) + lo, hi - lo)
    h
}

// `nova_rt_bytes_concat`.
fn rt_bytes_concat(a: Int, b: Int) -> Int { rt_str_concat(a, b) }

// `nova_rt_bytes_to_ints`.
fn rt_bytes_to_ints(b: Int) -> Int {
    let n = str_len(b)
    let p = str_bytes(b)
    let arr = rt_alloc(8 + 8 * n)
    mem_store64(arr, n)
    let mut i = 0
    while i < n {
        mem_store64(arr + 8 + 8 * i, mem_load8(p + i))
        i = i + 1
    }
    arr
}

// `nova_rt_bytes_from_ints`: each element must be a byte.
fn rt_bytes_from_ints(ints: Int) -> Int {
    let mut n = mem_load64(ints)
    if n < 0 { n = 0 }
    let h = rt_str_alloc(n)
    let at = str_bytes(h)
    let mut i = 0
    while i < n {
        let v = mem_load64(ints + 8 + 8 * i)
        if v < 0 || v > 255 { panic("nova_rt_bytes_from_ints: element out of range 0..=255") }
        mem_store8(at + i, v)
        i = i + 1
    }
    h
}

// `nova_rt_bytes_eq`.
fn rt_bytes_eq(a: Int, b: Int) -> Bool { rt_str_eq(a, b) }

// The log configuration's state words (spec 4.1 §4.6): 0 while unset, else
// 1 plus whether lines go to stderr; and the level. Memory starts zeroed, so
// an unset configuration reads as `nova-runtime`'s default, `Info` (2) to
// stderr.
const LOG_SET: Int = 32

const LOG_LEVEL: Int = 40

// `nova_rt_log_config_level`.
fn rt_log_config_level() -> Int { if mem_load64(LOG_SET) == 0 { 2 } else { mem_load64(LOG_LEVEL) } }

// `nova_rt_log_config_to_stderr`: 1 or 0.
fn rt_log_config_to_stderr() -> Int {
    let set = mem_load64(LOG_SET)
    if set == 0 { 1 } else { set - 1 }
}

// `nova_rt_log_set_config`: the level as given, and any nonzero flag as
// stderr.
fn rt_log_set_config(level: Int, to_stderr: Int) {
    mem_store64(LOG_LEVEL, level)
    let mut set = 1
    if to_stderr != 0 { set = 2 }
    mem_store64(LOG_SET, set)
}

// The executor (spec 4.1 §4), ported from `nova-runtime`'s `task.rs`: a FIFO
// run queue, tasks parked on a deadline or on another task, woken in the
// order they were parked, and no wakers. Its state is in leaf objects, which
// the collector keeps but does not trace; each unreleased task's state is a
// root instead (§6.4).

// The executor's block, or 0 before its first use. At 0 the task table, a
// task to 32 bytes: its poll function, its state, its output and its flags
// (1 done, 2 released, 4 kept until its output is taken, 8 its state freed),
// laid out as a future at its start; at 8 its count and at 16 its capacity.
// At 24 the run queue, a ring of task ids; at 32 its head, 40 its length and
// 48 its capacity. At 56 the parked tasks, 32 bytes each: the id, the task it
// waits for plus 1, or the shim's token it waits for negated, or 0, whether
// it has a deadline, and the deadline; at 64 their count and at 72 the
// capacity. At 80 the polled task plus 1, or 0 outside a poll. At 88 the wait
// the poll staged: 1 a deadline, 2 a task, 4 a token; at 96 the deadline and
// at 104 the task or the token. At 112, 1 while a `block_on` or
// `async fn main` runs. At 120 the index from a state's address to its
// task, 16 bytes a slot (the address, the id plus 1); at 128 its capacity, a
// power of 2, and at 136 the slots used.
const EXEC: Int = 48

// The block, made at the first use.
fn exec() -> Int {
    let e = mem_load64(EXEC)
    if e != 0 { return e }
    let b = rt_alloc_leaf(144)
    mem_store64(b, rt_alloc_leaf(32 * 16))
    mem_store64(b + 16, 16)
    mem_store64(b + 24, rt_alloc_leaf(8 * 16))
    mem_store64(b + 48, 16)
    mem_store64(b + 56, rt_alloc_leaf(32 * 16))
    mem_store64(b + 72, 16)
    mem_store64(b + 120, rt_alloc_leaf(16 * 16))
    mem_store64(b + 128, 16)
    mem_store64(EXEC, b)
    b
}

// Task `id`'s entry, and its flags.
fn task_at(e: Int, id: Int) -> Int { mem_load64(e) + 32 * id }

fn task_flags(e: Int, id: Int) -> Int { mem_load64(task_at(e, id) + 24) }

fn set_task_flags(e: Int, id: Int, flags: Int) { mem_store64(task_at(e, id) + 24, flags) }

// A new task, never polled, with the poll function and state given.
fn task_new(e: Int, poll: Int, state: Int) -> Int {
    let n = mem_load64(e + 8)
    let cap = mem_load64(e + 16)
    if n == cap {
        let bigger = rt_alloc_leaf(64 * cap)
        mem_copy(bigger, mem_load64(e), 32 * n)
        mem_store64(e, bigger)
        mem_store64(e + 16, 2 * cap)
    }
    let t = mem_load64(e) + 32 * n
    mem_store64(t, poll)
    mem_store64(t + 8, state)
    mem_store64(e + 8, n + 1)
    n
}

// Queue task `id` at the back.
fn queue_push(e: Int, id: Int) {
    let cap = mem_load64(e + 48)
    let len = mem_load64(e + 40)
    if len == cap {
        let ring = mem_load64(e + 24)
        let head = mem_load64(e + 32)
        let bigger = rt_alloc_leaf(16 * cap)
        let mut i = 0
        while i < len {
            mem_store64(bigger + 8 * i, mem_load64(ring + 8 * ((head + i) % cap)))
            i = i + 1
        }
        mem_store64(e + 24, bigger)
        mem_store64(e + 32, 0)
        mem_store64(e + 48, 2 * cap)
    }
    let at = (mem_load64(e + 32) + len) % mem_load64(e + 48)
    mem_store64(mem_load64(e + 24) + 8 * at, id)
    mem_store64(e + 40, len + 1)
}

// The task at the front of the queue, taken off it; the queue is not empty.
fn queue_pop(e: Int) -> Int {
    let head = mem_load64(e + 32)
    let id = mem_load64(mem_load64(e + 24) + 8 * head)
    mem_store64(e + 32, (head + 1) % mem_load64(e + 48))
    mem_store64(e + 40, mem_load64(e + 40) - 1)
    id
}

// The index's slot for a state's address: states are 16-aligned, and the
// page number is folded in.
fn index_home(state: Int, cap: Int) -> Int {
    let x = state >> 4
    let folded = x ^ (x >> 12)
    folded & (cap - 1)
}

// Map `state` to task `id`, replacing what it mapped to.
fn index_put(e: Int, state: Int, id: Int) {
    if 2 * (mem_load64(e + 136) + 1) > mem_load64(e + 128) {
        index_rebuild(e, 2 * mem_load64(e + 128))
    }
    let table = mem_load64(e + 120)
    let cap = mem_load64(e + 128)
    let mut i = index_home(state, cap)
    while true {
        let k = mem_load64(table + 16 * i)
        if k == 0 {
            mem_store64(table + 16 * i, state)
            mem_store64(table + 16 * i + 8, id + 1)
            mem_store64(e + 136, mem_load64(e + 136) + 1)
            return
        }
        if k == state {
            mem_store64(table + 16 * i + 8, id + 1)
            return
        }
        i = (i + 1) & (cap - 1)
    }
}

// The task `state` maps to, or -1.
fn index_get(e: Int, state: Int) -> Int {
    let table = mem_load64(e + 120)
    let cap = mem_load64(e + 128)
    let mut i = index_home(state, cap)
    while true {
        let k = mem_load64(table + 16 * i)
        if k == 0 { return 0 - 1 }
        if k == state { return mem_load64(table + 16 * i + 8) - 1 }
        i = (i + 1) & (cap - 1)
    }
    0
}

// The index made again with `cap` slots.
fn index_rebuild(e: Int, cap: Int) {
    mem_store64(e + 120, rt_alloc_leaf(16 * cap))
    mem_store64(e + 128, cap)
    index_fill(e)
}

// The index emptied and filled again from every task whose state has not
// been freed, in spawn order, so a state spawned again maps to its last
// task, as `BY_STATE`'s insert leaves it.
fn index_fill(e: Int) {
    mem_fill(mem_load64(e + 120), 0, 16 * mem_load64(e + 128))
    mem_store64(e + 136, 0)
    let n = mem_load64(e + 8)
    let mut id = 0
    while id < n {
        if (task_flags(e, id) & 8) == 0 { index_put(e, mem_load64(task_at(e, id) + 8), id) }
        id = id + 1
    }
}

// Park task `id`: on task `target1 - 1` if `target1` is not 0, and until
// `deadline` if `timed` is not 0.
fn park(e: Int, id: Int, target1: Int, timed: Int, deadline: Int) {
    let n = mem_load64(e + 64)
    let cap = mem_load64(e + 72)
    if n == cap {
        let bigger = rt_alloc_leaf(64 * cap)
        mem_copy(bigger, mem_load64(e + 56), 32 * n)
        mem_store64(e + 56, bigger)
        mem_store64(e + 72, 2 * cap)
    }
    let p = mem_load64(e + 56) + 32 * n
    mem_store64(p, id)
    mem_store64(p + 8, target1)
    mem_store64(p + 16, timed)
    mem_store64(p + 24, deadline)
    mem_store64(e + 64, n + 1)
}

// Queue every parked task whose deadline is due at `now` (`done` < 0), or
// that waits for task `done`, in the order they were parked; the rest stay,
// in their order (`wake_due` and `wake_tasks_waiting_on`).
fn wake(e: Int, done: Int, now: Int) {
    let parked = mem_load64(e + 56)
    let n = mem_load64(e + 64)
    let mut kept = 0
    let mut i = 0
    while i < n {
        let p = parked + 32 * i
        let mut due = false
        if done < 0 {
            due = mem_load64(p + 16) != 0 && mem_load64(p + 24) <= now
        } else {
            due = mem_load64(p + 8) == done + 1
        }
        if due {
            queue_push(e, mem_load64(p))
        } else {
            mem_copy(parked + 32 * kept, p, 32)
            kept = kept + 1
        }
        i = i + 1
    }
    mem_store64(e + 64, kept)
}

// The earliest deadline of a parked task, or -1 when none has one. Every
// deadline is at least 0.
fn earliest(e: Int) -> Int {
    let parked = mem_load64(e + 56)
    let n = mem_load64(e + 64)
    let mut at = 0 - 1
    let mut i = 0
    while i < n {
        let p = parked + 32 * i
        if mem_load64(p + 16) != 0 {
            let d = mem_load64(p + 24)
            if at < 0 || d < at { at = d }
        }
        i = i + 1
    }
    at
}

// Stage a wait until `deadline` for the polled task; deadlines merge to the
// earliest (`try_stage`).
fn stage_deadline(e: Int, deadline: Int) {
    if mem_load64(e + 80) == 0 { panic("nova_rt: a park was staged outside a poll") }
    let staged = mem_load64(e + 88)
    if (staged & 1) == 0 || deadline < mem_load64(e + 96) { mem_store64(e + 96, deadline) }
    mem_store64(e + 88, staged | 1)
}

// Stage a wait for task `id`; a second one in the same poll means an inner
// future's pending status was dropped.
fn stage_task(e: Int, id: Int) {
    if mem_load64(e + 80) == 0 { panic("nova_rt: a park was staged outside a poll") }
    let staged = mem_load64(e + 88)
    if (staged & 6) != 0 {
        let mut deadline = "None"
        if (staged & 1) != 0 { deadline = "Some(_)" }
        let prev = mem_load64(e + 104)
        panic(
            "nova_rt: two parks staged in one poll (Task { id: ${prev}, deadline: ${deadline} } then Task { id: ${id}, deadline: None }); an inner future's POLL_PENDING did not propagate",
        )
    }
    mem_store64(e + 104, id)
    mem_store64(e + 88, staged | 2)
}

// Stage a wait for the shim's token `token` (spec 4.2 §7.1): a park whose
// target is the token, negated, so it is told from a task's.
fn stage_host(e: Int, token: Int) {
    if mem_load64(e + 80) == 0 { panic("nova_rt: a park was staged outside a poll") }
    let staged = mem_load64(e + 88)
    if (staged & 6) != 0 {
        panic(
            "nova_rt: two parks staged in one poll; an inner future's POLL_PENDING did not propagate",
        )
    }
    mem_store64(e + 104, token)
    mem_store64(e + 88, staged | 4)
}

// Queue every task parked on the shim's token `token`, in the order they
// were parked.
fn wake_host(e: Int, token: Int) {
    let parked = mem_load64(e + 56)
    let n = mem_load64(e + 64)
    let mut kept = 0
    let mut i = 0
    while i < n {
        let p = parked + 32 * i
        if mem_load64(p + 8) == 0 - token {
            queue_push(e, mem_load64(p))
        } else {
            mem_copy(parked + 32 * kept, p, 32)
            kept = kept + 1
        }
        i = i + 1
    }
    mem_store64(e + 64, kept)
}

// Whether a parked task waits on one of the shim's tokens.
fn waits_on_host(e: Int) -> Bool {
    let parked = mem_load64(e + 56)
    let n = mem_load64(e + 64)
    let mut i = 0
    while i < n {
        if mem_load64(parked + 32 * i + 8) < 0 { return true }
        i = i + 1
    }
    false
}

// Release task `id`, once: its state stops being a root.
fn release_id(e: Int, id: Int) {
    let flags = task_flags(e, id)
    if (flags & 2) == 0 { set_task_flags(e, id, flags | 2) }
}

// Poll task `id` once (`poll_one`). Pending with a wait staged parks it,
// and without one queues it at the back; ready records the output, queues
// the tasks waiting for it, and releases it unless its output is to be
// taken. A wait staged by a poll that ends ready is dropped.
fn poll_task(e: Int, id: Int) {
    mem_store64(e + 80, id + 1)
    let status = future_poll(task_at(e, id))
    mem_store64(e + 80, 0)
    let staged = mem_load64(e + 88)
    mem_store64(e + 88, 0)
    if status == 0 {
        if staged == 0 {
            queue_push(e, id)
        } else {
            let mut target1 = 0
            if (staged & 2) != 0 { target1 = mem_load64(e + 104) + 1 }
            if (staged & 4) != 0 { target1 = 0 - mem_load64(e + 104) }
            park(e, id, target1, staged & 1, mem_load64(e + 96))
        }
        return
    }
    if status != 1 {
        panic(
            "poll function for task ${id} returned ${status}, which is neither POLL_PENDING (0) nor POLL_READY (1)",
        )
    }
    let t = task_at(e, id)
    mem_store64(t + 16, mem_load64(mem_load64(t + 8) + 8))
    let flags = mem_load64(t + 24) | 1
    mem_store64(t + 24, flags)
    wake(e, id, 0)
    if (flags & 4) == 0 { release_id(e, id) }
}

// Poll queued tasks until none is queued, waking due deadlines after each
// poll while any task is parked, so a task that yields in a loop cannot
// starve a sleeper.
fn drain(e: Int) {
    while mem_load64(e + 40) > 0 {
        poll_task(e, queue_pop(e))
        if mem_load64(e + 64) > 0 { wake(e, 0 - 1, time_now_nanos()) }
    }
}

// How long a turn polls, in nanoseconds: about 10 ms.
const TURN_BUDGET: Int = 10000000

// `drain` for a turn, which stops once it has polled for `TURN_BUDGET`
// with tasks still queued. A task that waits for a lock or a channel yields
// in a loop, so while the task it waits for sleeps, the queue never empties;
// the turn returns to JS instead, which runs, and the collector with it at
// the turn's end. The next turn goes on in the queue's order.
fn drain_turn(e: Int) {
    let start = time_now_nanos()
    let mut now = start
    while mem_load64(e + 40) > 0 && now - start < TURN_BUDGET {
        poll_task(e, queue_pop(e))
        now = time_now_nanos()
        if mem_load64(e + 64) > 0 { wake(e, 0 - 1, now) }
    }
}

// A task for the future at `fut`, queued at the back, not run
// (`spawn_internal`).
fn spawn_task(e: Int, fut: Int, keep: Bool) -> Int {
    let state = mem_load64(fut + 8)
    let prior = index_get(e, state)
    if prior >= 0 {
        if (task_flags(e, prior) & 2) == 0 {
            panic(
                "nova_rt_task_spawn: this future is already a live task; spawn it again only after its task has been released",
            )
        }
    }
    let id = task_new(e, mem_load64(fut), state)
    if keep { set_task_flags(e, id, 4) }
    index_put(e, state, id)
    queue_push(e, id)
    id
}

// The task of the future at `fut`, which must have been spawned.
fn task_id_of(e: Int, fut: Int, who: String) -> Int {
    let id = index_get(e, mem_load64(fut + 8))
    if id < 0 { panic("${who}: this future was never spawned, so there is no task to ask about") }
    id
}

// Take a finished task's output, once (`take_output_internal`).
fn take_output(e: Int, id: Int) -> Int {
    if id < 0 || id >= mem_load64(e + 8) { panic("nova_rt_task_take_output: unknown task id") }
    let flags = task_flags(e, id)
    if (flags & 1) == 0 {
        panic(
            "nova_rt_task_take_output: task ${id} has not completed; poll nova_rt_task_is_done until it reports true first",
        )
    }
    if (flags & 2) != 0 && (flags & 4) == 0 {
        panic(
            "nova_rt_task_take_output: task ${id}'s GC root has already been released -- a spawned task's is released when it completes -- so its output can no longer be taken; read it through its future, as JoinHandle::join does",
        )
    }
    if (flags & 2) != 0 {
        panic(
            "nova_rt_task_take_output: task ${id}'s output was already taken; taking released the state object's GC root, so a heap-valued output may already have been collected",
        )
    }
    set_task_flags(e, id, flags | 2)
    mem_load64(task_at(e, id) + 16)
}

// The deadlock report, on stderr, then an abort (`report_deadlock`): tasks
// are parked, none has a deadline, and nothing is queued.
fn report_deadlock(e: Int) {
    let n = mem_load64(e + 64)
    let mut plural = "tasks are"
    if n == 1 { plural = "task is" }
    eprint("nova: deadlock: ${n} ${plural} parked and none can wake\n")
    let mut i = 0
    while i < n {
        let p = mem_load64(e + 56) + 32 * i
        let id = mem_load64(p)
        let target1 = mem_load64(p + 8)
        if target1 == 0 {
            eprint("  task ${id} is waiting on a deadline\n")
        } else if mem_load64(p + 16) != 0 {
            eprint("  task ${id} is waiting for task ${target1 - 1} to finish, with a deadline\n")
        } else {
            eprint("  task ${id} is waiting for task ${target1 - 1} to finish\n")
        }
        i = i + 1
    }
    host_abort()
}

// `nova_rt_task_spawn`.
fn rt_task_spawn(fut: Int) -> Int { spawn_task(exec(), fut, false) }

// `nova_rt_task_block_on` (spec 4.1 §4.4): the root queued behind earlier
// spawns, every task drained, and the root's output. With only deadlines
// left, it waits for the earliest by reading the clock in a loop, as native
// `thread::sleep` holds the thread.
fn rt_task_block_on(fut: Int) -> Int {
    let e = exec()
    // Inside a poll, from a task, is re-entrant too: a task a call from JS
    // spawned runs in that call's turn, where no loop has set the flag
    // (spec 4.2 §5.2).
    if mem_load64(e + 112) != 0 || mem_load64(e + 80) != 0 {
        panic(
            "nova_rt_task_block_on called re-entrantly: an async fn must not call block_on, which would run a second executor loop from inside the first one's frame",
        )
    }
    mem_store64(e + 112, 1)
    let root = spawn_task(e, fut, true)
    drain(e)
    while mem_load64(e + 64) > 0 {
        let at = earliest(e)
        if at < 0 {
            if waits_on_host(e) {
                panic(
                    "nova_rt_task_block_on: a task waits for JS, as `fetch` does, and JS cannot answer while block_on holds the thread; await it from an `async fn main` instead",
                )
            }
            report_deadlock(e)
        }
        while time_now_nanos() < at {}
        wake(e, 0 - 1, time_now_nanos())
        drain(e)
    }
    mem_store64(e + 112, 0)
    take_output(e, root)
}

// `nova_rt_task_is_done`.
fn rt_task_is_done(fut: Int) -> Bool {
    let e = exec()
    let done = task_flags(e, task_id_of(e, fut, "nova_rt_task_is_done")) & 1
    done != 0
}

// `nova_rt_task_take_output`.
fn rt_task_take_output(id: Int) -> Int { take_output(exec(), id) }

// `nova_rt_task_release`: idempotent.
fn rt_task_release(fut: Int) {
    let e = exec()
    release_id(e, task_id_of(e, fut, "nova_rt_task_release"))
}

// A deadline `nanos` from now, a negative count as 0, saturating
// (`deadline_nanos_from_now`).
fn deadline_from_now(nanos: Int) -> Int {
    let now = time_now_nanos()
    let mut d = nanos
    if d < 0 { d = 0 }
    if d > 9223372036854775807 - now { 9223372036854775807 } else { now + d }
}

// The leaf futures (spec 4.1 §4.3) are `async fn`s over the one the backend
// builds, `task_yield_future`, which is pending once with no wait staged.
// Each stages its wait, then awaits a fresh one, so its task parks; woken, it
// checks again. Each fixes its deadline or its target at its first poll,
// which comes as it is built: std awaits each where it builds it.

// `nova_rt_task_sleep_future_nanos`: due at once completes without
// suspending.
async fn rt_task_sleep_future_nanos(nanos: Int) -> Int {
    let deadline = deadline_from_now(nanos)
    while time_now_nanos() < deadline {
        stage_deadline(exec(), deadline)
        task_yield_future().await
    }
    0
}

// `nova_rt_task_join_future`: an unspawned future aborts.
async fn rt_task_join_future(fut: Int) -> Int {
    let e = exec()
    let target = task_id_of(e, fut, "nova_rt_task_join_future")
    while (task_flags(e, target) & 1) == 0 {
        stage_task(e, target)
        task_yield_future().await
    }
    0
}

// `nova_rt_task_timeout_future`: 0 when the future at `inner` completes,
// polled first, and 1 when the deadline passes first. A wait the inner
// future staged is dropped when the timeout completes, and the inner future
// is abandoned, not cancelled.
async fn rt_task_timeout_future(nanos: Int, inner: Int) -> Int {
    let deadline = deadline_from_now(nanos)
    let e = exec()
    while true {
        let staged = mem_load64(e + 88)
        let at = mem_load64(e + 96)
        let target = mem_load64(e + 104)
        let status = future_poll(inner)
        if status != 0 && status != 1 {
            panic(
                "nova_rt: a future polled by a timeout returned ${status}, which is neither POLL_PENDING (0) nor POLL_READY (1)",
            )
        }
        let mut done = 0 - 1
        if status == 1 { done = 0 } else if time_now_nanos() >= deadline { done = 1 }
        if done >= 0 {
            mem_store64(e + 88, staged)
            mem_store64(e + 96, at)
            mem_store64(e + 104, target)
            return done
        }
        stage_deadline(e, deadline)
        task_yield_future().await
    }
    0
}

// `async fn main` on the event loop (spec 4.1 §4.4, §5). Its shim calls
// this with the root's future instead of `block_on`: the root is spawned as
// `block_on` would, and run as a turn runs. Then JS calls `nova_turn`, on a
// timer, until it returns -1. The flag stays set, so a `block_on` inside
// aborts, as it does natively, where `async fn main` is one `block_on`.
fn rt_task_main(fut: Int) {
    let e = exec()
    mem_store64(e + 112, 1)
    spawn_task(e, fut, true)
    drain_turn(e)
    gc_turn_end()
}

// `nova_turn`: wake what is due, run what is queued for up to
// `TURN_BUDGET`, then 0 if tasks are still queued, or else the time until
// the earliest deadline in milliseconds, rounded up, or -1 when no task is
// parked. A timer may fire early; the turn then only says what is left.
// Parked tasks without a deadline can never wake: the deadlock report.
fn rt_turn() -> Int {
    let e = exec()
    wake(e, 0 - 1, time_now_nanos())
    turn_end(e)
}

// The rest of a turn, after what woke it (spec 4.2 §5.2, §7.2): run the
// queue for up to `TURN_BUDGET`, collect if due, then 0 if tasks are still
// queued, or else the milliseconds to the earliest deadline, or -1 when no
// task is parked, or -2 when no parked task has a deadline and one waits on
// the shim's tokens.
fn turn_end(e: Int) -> Int {
    drain_turn(e)
    gc_turn_end()
    if mem_load64(e + 40) > 0 { return 0 }
    if mem_load64(e + 64) == 0 { return 0 - 1 }
    let at = earliest(e)
    if at < 0 {
        if waits_on_host(e) { return 0 - 2 }
        report_deadlock(e)
    }
    let left = at - time_now_nanos()
    if left <= 0 { return 0 }
    let ms = left / 1000000
    if left % 1000000 == 0 { ms } else { ms + 1 }
}

// The closures JS may call (spec
// docs/superpowers/specs/2026-10-16-phase-4-2-std-dom-and-the-shim-design.md
// §5): at state word 96, a leaf block holding the address of a leaf table of
// `fn(Int)` closures' addresses at 0, the entries used so far at 8, and the
// table's capacity at 16. An entry's index plus 1 is its id, and 0 marks a
// free entry. The collector marks every closure in it: the table is a root.
const CALLS: Int = 96

// The table, made at its first use.
fn calls() -> Int {
    let c = mem_load64(CALLS)
    if c != 0 { return c }
    let block = rt_alloc_leaf(24)
    mem_store64(block, rt_alloc_leaf(8 * 16))
    mem_store64(block + 16, 16)
    mem_store64(CALLS, block)
    block
}

/// Put the `fn(Int)` closure at address `f` in the table of closures JS may
/// call, in the first free entry, and return its id. Only `std/dom` calls
/// it, with `closure_word`.
pub fn rt_closure_register(f: Int) -> Int {
    let c = calls()
    let used = mem_load64(c + 8)
    let mut i = 0
    while i < used {
        let at = mem_load64(c) + 8 * i
        if mem_load64(at) == 0 {
            mem_store64(at, f)
            return i + 1
        }
        i = i + 1
    }
    let cap = mem_load64(c + 16)
    if used == cap {
        let bigger = rt_alloc_leaf(16 * cap)
        mem_copy(bigger, mem_load64(c), 8 * used)
        mem_store64(c, bigger)
        mem_store64(c + 16, 2 * cap)
    }
    mem_store64(mem_load64(c) + 8 * used, f)
    mem_store64(c + 8, used + 1)
    used + 1
}

// The entries of the table in use, for `NOVA_GC_DEBUG`'s line; 0 with no
// table.
fn calls_in_use(c: Int) -> Int {
    if c == 0 { return 0 }
    let used = mem_load64(c + 8)
    let mut n = 0
    let mut i = 0
    while i < used {
        if mem_load64(mem_load64(c) + 8 * i) != 0 { n = n + 1 }
        i = i + 1
    }
    n
}

/// Take entry `id` out of the table, so the collector may free its closure.
/// An id that is free, or no id at all, changes nothing.
pub fn rt_closure_release(id: Int) {
    let c = mem_load64(CALLS)
    if c == 0 || id < 1 || id > mem_load64(c + 8) { return }
    mem_store64(mem_load64(c) + 8 * (id - 1), 0)
}

// The shim's side of a token: whether what it waits for has settled.
extern "js" {
    fn host_done(token: Int) -> Bool
}

/// A future that completes once the shim's token `token` has settled, as a
/// `fetch` does (spec 4.2 §7.1). Its task parks meanwhile; `nova_wake`
/// queues it. Only `std/dom` awaits it.
pub async fn rt_task_host_future(token: Int) -> Int {
    while !host_done(token) {
        stage_host(exec(), token)
        task_yield_future().await
    }
    0
}

// `nova_wake` (spec 4.2 §7.1): the shim's token `token` has settled. Queue
// the tasks parked on it, then run a turn, as `nova_call` does.
fn rt_wake(token: Int) -> Int {
    let e = exec()
    wake_host(e, token)
    wake(e, 0 - 1, time_now_nanos())
    turn_end(e)
}

// `nova_call` (spec 4.2 §5.2): call entry `id` with `arg`; an entry that is
// free calls nothing. JS says whether the call is outermost (`outer` 1): only
// then is it a turn, which wakes what is due, runs the queue and collects.
// An inner call, made while Nova code is on the WASM stack, returns -2 and
// leaves that to the call it is inside.
fn rt_call(id: Int, arg: Int, outer: Int) -> Int {
    let c = mem_load64(CALLS)
    if c != 0 && id >= 1 && id <= mem_load64(c + 8) {
        let f = mem_load64(mem_load64(c) + 8 * (id - 1))
        if f != 0 { closure_call(f, arg) }
    }
    if outer == 0 { return 0 - 2 }
    let e = exec()
    wake(e, 0 - 1, time_now_nanos())
    turn_end(e)
}

// The state of `std/ui` (spec
// docs/superpowers/specs/2026-10-17-phase-4-3-std-ui-reactivity-and-views-design.md
// §4): at state word 104, its record's address, or 0 before the first store.
// The collector marks the record, and so everything a mounted page keeps.
const UI_STATE: Int = 104

// `ui_state_present() -> Bool`.
fn rt_ui_state_present() -> Bool { mem_load64(UI_STATE) != 0 }

// `ui_state_load<T>() -> T`: the record.
fn rt_ui_state_load() -> Int { mem_load64(UI_STATE) }

// `ui_state_store<T>(state: T)`.
fn rt_ui_state_store(state: Int) { mem_store64(UI_STATE, state) }

// JS's objects, as `std/dom` holds them (spec
// docs/superpowers/specs/2026-10-16-phase-4-2-std-dom-and-the-shim-design.md
// §4): a box is a 16-byte leaf holding a handle of the shim's table, then 0.
// A record holds the box's address in an `Int` field, which the collector,
// being conservative, reads as a pointer.
//
// The registry, at state word 88, is a leaf block: the address of a leaf
// table of (box, handle) pairs at 0, their count at 8, and the table's
// capacity at 16. It is weak: the collector marks the block and the table,
// not the boxes, and after each sweep `gc_release` drops the pairs whose box
// was freed and tells the shim to release their handles.
const HANDLES: Int = 88

// The shim's side: empty a handle's slot, and count the slots in use.
extern "js" {
    fn host_release(handle: Int)
    fn host_handles() -> Int
}

// The registry, made at its first use.
fn handles() -> Int {
    let h = mem_load64(HANDLES)
    if h != 0 { return h }
    let block = rt_alloc_leaf(24)
    mem_store64(block, rt_alloc_leaf(16 * 16))
    mem_store64(block + 16, 16)
    mem_store64(HANDLES, block)
    block
}

/// A box for the shim's handle `id`, registered so the collector releases
/// the handle once the box is freed. Only `std/dom` calls it.
pub fn rt_handle_box(id: Int) -> Int {
    let b = rt_alloc_leaf(16)
    mem_store64(b, id)
    let r = handles()
    let n = mem_load64(r + 8)
    let cap = mem_load64(r + 16)
    if n == cap {
        let bigger = rt_alloc_leaf(32 * cap)
        mem_copy(bigger, mem_load64(r), 16 * n)
        mem_store64(r, bigger)
        mem_store64(r + 16, 2 * cap)
    }
    let p = mem_load64(r) + 16 * n
    mem_store64(p, b)
    mem_store64(p + 8, id)
    mem_store64(r + 8, n + 1)
    b
}

/// The handle in the box at `b`. A forged address reads whatever is there,
/// and the shim's table panics on a handle it does not hold.
pub fn rt_handle_id(b: Int) -> Int { mem_load64(b) }

// The collector (spec 4.1 §6.4 to §6.6), ported from `nova-runtime`'s
// `gc.rs`: conservative and non-moving, marking from the roots, then
// sweeping by bitmap. A word is a pointer if it falls inside an allocated
// object, at its start or not. It runs only at the end of a turn, when the
// WASM stack holds nothing it has to see: its roots are the executor's block
// and tables, each unreleased task's state, and the closures JS may call;
// the handle registry it keeps without its boxes (spec 4.2 §4.2, §5.1).

// The next collection's threshold, or 0 for the first, 1 MiB; collections so
// far; and the switches, 1 stress and 2 debug.
const GC_NEXT: Int = 64

const GC_COUNT: Int = 72

const GC_SWITCHES: Int = 80

// The switches, from the shim before `main`, as `nova_gc_switches`.
fn rt_gc_switches(flags: Int) { mem_store64(GC_SWITCHES, flags) }

// Collect at the end of a turn if the bytes allocated since the last
// collection have reached the threshold, or always under stress.
fn gc_turn_end() {
    if mem_load64(HEAP_META) == 0 { return }
    let mut limit = mem_load64(GC_NEXT)
    if limit == 0 { limit = 1048576 }
    if (mem_load64(GC_SWITCHES) & 1) != 0 || mem_load64(GC_SINCE) >= limit { gc_collect() }
}

// One collection (`collect_with_roots`): mark from the roots, sweep, prune
// the executor's index of freed states, and set the next threshold to twice
// the live bytes, 1 MiB at least. Under debug, `nova-runtime`'s line.
fn gc_collect() {
    let m = heap_meta()
    let e = mem_load64(EXEC)
    if e != 0 {
        gc_mark(m, e)
        gc_mark(m, mem_load64(e))
        gc_mark(m, mem_load64(e + 24))
        gc_mark(m, mem_load64(e + 56))
        gc_mark(m, mem_load64(e + 120))
        let n = mem_load64(e + 8)
        let mut id = 0
        while id < n {
            if (task_flags(e, id) & 2) == 0 { gc_mark(m, mem_load64(task_at(e, id) + 8)) }
            id = id + 1
        }
    }
    let r = mem_load64(HANDLES)
    if r != 0 {
        gc_mark(m, r)
        gc_mark(m, mem_load64(r))
    }
    let u = mem_load64(UI_STATE)
    if u != 0 { gc_mark(m, u) }
    let c = mem_load64(CALLS)
    if c != 0 {
        gc_mark(m, c)
        let table = mem_load64(c)
        gc_mark(m, table)
        let used = mem_load64(c + 8)
        let mut i = 0
        while i < used {
            let f = mem_load64(table + 8 * i)
            if f != 0 { gc_mark(m, f) }
            i = i + 1
        }
    }
    gc_trace(m)
    gc_sweep(m)
    if e != 0 { gc_prune(m, e) }
    let mut released = 0
    if r != 0 { released = gc_release(m, r) }
    let count = mem_load64(GC_COUNT) + 1
    mem_store64(GC_COUNT, count)
    let bytes = mem_load64(m + 56)
    let mut next = 2 * bytes
    if next < 1048576 { next = 1048576 }
    mem_store64(GC_NEXT, next)
    if (mem_load64(GC_SWITCHES) & 2) != 0 {
        let freed = mem_load64(m + 40)
        let live = mem_load64(m + 48)
        eprintln(
            "nova-gc: collection ${count} freed ${freed} bytes, ${live} objects live (${bytes} bytes)",
        )
        if r != 0 || c != 0 {
            eprintln(
                "nova-dom: collection ${count} released ${released} handles, ${host_handles()} live, ${calls_in_use(c)} calls",
            )
        }
    }
    mem_store64(GC_SINCE, 0)
}

// Drop the registry's pairs whose box no object starts at any more, and
// release their handles; the rest keep their order. The count released.
fn gc_release(m: Int, r: Int) -> Int {
    let table = mem_load64(r)
    let n = mem_load64(r + 8)
    let mut kept = 0
    let mut i = 0
    while i < n {
        let p = table + 16 * i
        if gc_is_live(m, mem_load64(p)) {
            mem_copy(table + 16 * kept, p, 16)
            kept = kept + 1
        } else {
            host_release(mem_load64(p + 8))
        }
        i = i + 1
    }
    mem_store64(r + 8, kept)
    n - kept
}

// Mark the object word `w` falls in, if any, and queue it to be traced
// unless it is a leaf (`try_mark`).
fn gc_mark(m: Int, w: Int) {
    if w < mem_load64(m) * PAGE || w >= mem_load64(m + 8) * PAGE { return }
    let p = w / PAGE
    let word = page_word(m, p)
    let kind = word & 255
    if kind == 2 {
        let base = p * PAGE
        let off = w - base - SLOTS
        if off < 0 { return }
        let slot = mem_load64(base + 8)
        let i = off / slot
        if i >= mem_load64(base + 16) { return }
        let at = 8 * (i >> 6)
        let bit = 1 << (i & 63)
        if (mem_load64(base + 32 + at) & bit) == 0 { return }
        let marks = mem_load64(base + 544 + at)
        if (marks & bit) != 0 { return }
        mem_store64(base + 544 + at, marks | bit)
        if (mem_load64(base + 1056 + at) & bit) != 0 { work_push(m, base + SLOTS + i * slot, slot) }
    } else if kind == 3 || kind == 4 {
        let mut head = p
        if kind == 4 { head = word >> 8 }
        let base = head * PAGE
        let size = mem_load64(base)
        if w < base + 16 || w >= base + 16 + size { return }
        let flags = mem_load64(base + 8)
        if (flags & 1) != 0 { return }
        mem_store64(base + 8, flags | 1)
        if (flags & 2) != 0 { work_push(m, base + 16, size) }
    }
}

// Queue `len` bytes at `at` to be traced, on the worklist: pages of the
// collector's own, which double when full. V8's stack is too small for
// recursion.
fn work_push(m: Int, at: Int, len: Int) {
    let n = mem_load64(m + 32)
    let cap = mem_load64(m + 24)
    if n == cap {
        let old = mem_load64(m + 16)
        let mut pages = 1
        if cap > 0 { pages = 2 * cap * 16 / PAGE }
        let p = take_pages(m, pages)
        let mut k = 0
        while k < pages {
            set_page_word(m, p + k, 5)
            k = k + 1
        }
        if cap > 0 {
            mem_copy(p * PAGE, old, 16 * n)
            let first = old / PAGE
            k = 0
            while k < cap * 16 / PAGE {
                set_page_word(m, first + k, 1)
                k = k + 1
            }
        }
        mem_store64(m + 16, p * PAGE)
        mem_store64(m + 24, pages * PAGE / 16)
    }
    let wl = mem_load64(m + 16) + 16 * n
    mem_store64(wl, at)
    mem_store64(wl + 8, len)
    mem_store64(m + 32, n + 1)
}

// Trace until the worklist is empty: mark what every word of each queued
// object points into.
fn gc_trace(m: Int) {
    while mem_load64(m + 32) > 0 {
        let n = mem_load64(m + 32) - 1
        mem_store64(m + 32, n)
        let wl = mem_load64(m + 16) + 16 * n
        let at = mem_load64(wl)
        let end = at + mem_load64(wl + 8)
        let mut p = at
        while p < end {
            gc_mark(m, mem_load64(p))
            p = p + 8
        }
    }
}

// The set bits of `x`.
fn popcount(x: Int) -> Int {
    let a = x - ((x >> 1) & 6148914691236517205)
    let b = (a & 3689348814741910323) + ((a >> 2) & 3689348814741910323)
    let c = (b + (b >> 4)) & 1085102592571150095
    let d = (c * 72340172838076673) >> 56
    d & 255
}

// Sweep (`Pages::sweep`, and the large objects' `retain`): an unmarked
// object is freed, a page left empty becomes free for any use, as does a
// large object's run; the marks are cleared; each class goes on from one of
// its pages with a free slot. The freed bytes, the live objects and the live
// bytes go to the metadata's words 40, 48 and 56.
fn gc_sweep(m: Int) {
    let mut freed = 0
    let mut live = 0
    let mut bytes = 0
    let mut c = 0
    while c < 24 {
        mem_store64(m + 448 + 8 * c, 0)
        c = c + 1
    }
    let frontier = mem_load64(m + 8)
    let mut p = mem_load64(m)
    while p < frontier {
        let word = page_word(m, p)
        let kind = word & 255
        let base = p * PAGE
        let mut step = 1
        if kind == 2 {
            let slot = mem_load64(base + 8)
            let n = mem_load64(base + 16)
            let mut kept = 0
            let mut k = 0
            while 64 * k < n {
                let a = mem_load64(base + 32 + 8 * k)
                let marks = mem_load64(base + 544 + 8 * k)
                freed = freed + popcount(a ^ marks) * slot
                kept = kept + popcount(marks)
                mem_store64(base + 32 + 8 * k, marks)
                mem_store64(base + 544 + 8 * k, 0)
                k = k + 1
            }
            live = live + kept
            bytes = bytes + kept * slot
            if kept == 0 {
                set_page_word(m, p, 1)
            } else if kept < n {
                let cls = word >> 8
                mem_store64(base + 24, mem_load64(m + 448 + 8 * cls))
                mem_store64(m + 448 + 8 * cls, p)
            }
        } else if kind == 3 {
            step = word >> 8
            let size = mem_load64(base)
            let flags = mem_load64(base + 8)
            if (flags & 1) != 0 {
                mem_store64(base + 8, flags - 1)
                live = live + 1
                bytes = bytes + size
            } else {
                freed = freed + size
                let mut k = 0
                while k < step {
                    set_page_word(m, p + k, 1)
                    k = k + 1
                }
            }
        }
        p = p + step
    }
    c = 0
    while c < 24 {
        let next = mem_load64(m + 448 + 8 * c)
        if next != 0 { mem_store64(m + 448 + 8 * c, mem_load64(next * PAGE + 24)) }
        mem_store64(m + 64 + 8 * c, next)
        mem_store64(m + 256 + 8 * c, 0)
        c = c + 1
    }
    mem_store64(m + 40, freed)
    mem_store64(m + 48, live)
    mem_store64(m + 56, bytes)
}

// Whether an allocated object starts at `a`: after a sweep, whether `a`
// still names one (`slot_scan`, and the large objects' search).
fn gc_is_live(m: Int, a: Int) -> Bool {
    if a < mem_load64(m) * PAGE || a >= mem_load64(m + 8) * PAGE { return false }
    let p = a / PAGE
    let base = p * PAGE
    let kind = page_word(m, p) & 255
    if kind == 2 {
        let off = a - base - SLOTS
        let slot = mem_load64(base + 8)
        if off < 0 || off % slot != 0 || off / slot >= mem_load64(base + 16) { return false }
        let i = off / slot
        let bits = mem_load64(base + 32 + 8 * (i >> 6))
        return ((bits >> (i & 63)) & 1) != 0
    }
    kind == 3 && a == base + 16
}

// Forget every freed state (`prune_freed_states`): a task whose state was
// freed is marked so, and the index filled again without it, so a new
// object at the same address names no old task.
fn gc_prune(m: Int, e: Int) {
    let n = mem_load64(e + 8)
    let mut id = 0
    while id < n {
        let flags = task_flags(e, id)
        if (flags & 8) == 0 && !gc_is_live(m, mem_load64(task_at(e, id) + 8)) {
            set_task_flags(e, id, flags | 8)
        }
        id = id + 1
    }
    index_fill(e)
}
