//! An HTTP/1.1 server: requests read and parsed, responses built and written,
//! and a router that sends each request to a handler by its method and path.
//!
//! `Server` is the simple way in: give it a handler for each method and path
//! pattern with `get`, `post`, `put`, `delete` or `route`, and one for every
//! other `GET` with `fallback`, then `listen` on an address, or `listen_on` a
//! listener already bound. A pattern such as `/posts/:id` puts the piece of
//! the path it matched in the request's `params`. A handler is a plain
//! function from a `Request` to a `Response`, so it cannot await anything.
//! `Request`'s `query`, `form` and `cookies` read what a browser sends, and
//! `Response`'s `html`, `redirect` and `with_cookie` build what it is sent
//! back. `read_request`, `write_response` and `parse_request_head` are the
//! parts underneath, for serving a `std/net` `TcpStream` yourself. There is
//! no HTTP client. Every module sees these names without an import, and a
//! module's own definition of one of them shadows the one here.
//!
//! Only `Content-Length` says how long a request's body is: chunked transfer
//! encoding is not supported, and a chunked request's body is misread as the
//! next request. A request's header names are lower-cased, since HTTP
//! ignores their case, and the order of a response's headers on the wire can
//! change from one run of a program to the next.
//!
//! `Server::listen` serves until the process is stopped, so this example
//! has the server `dispatch` requests parsed from bytes, with no socket:
//!
//! ```
//! let app = Server::new()
//!     .get("/hello", |_| Response::text(200, "hi"))
//!     .get("/posts/:id", |r: Request| Response::text(200, "post ${r.params.get("id").unwrap()}"))
//!
//! let raw = bytes_from_string("GET /hello HTTP/1.1\r\nHost: example\r\nX-Trace: abc\r\n\r\n")
//! let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
//! assert_eq(req.headers.get("x-trace").unwrap(), "abc") // names are lower-cased
//!
//! let resp = app.dispatch(req)
//! assert_eq(resp.status, 200)
//! assert_eq(resp.headers.get("content-length").unwrap(), "2")
//! let wire = resp.to_bytes().to_string().unwrap()
//! assert(wire.starts_with("HTTP/1.1 200 OK\r\n"), "the status line comes first")
//! assert(wire.ends_with("\r\n\r\nhi"), "then a blank line and the body")
//!
//! // A pattern's `:id` takes the piece of the path it matched; the query
//! // takes no part in matching.
//! let post = bytes_from_string("GET /posts/7?tab=2 HTTP/1.1\r\n\r\n")
//! let shown = app.dispatch(parse_request_head(post, Limits::default()).unwrap().unwrap())
//! assert_eq(shown.body.to_string().unwrap(), "post 7")
//! ```

// Nova standard library -- HTTP/1.1, server side.
//
// Compiled as an implicit module and glob-imported into every user module, so
// these names need no `import` (see docs/adr/0004-stdlib-compile-model.md).
// The transport is `std/net`. Parsing and serialising never open a socket;
// `Server::listen`, at the end of this file, binds one and is the only code
// here that does.
//
// **What ships, against `nova-spec/20-STDLIB.md` section 6.** That section
// specifies a router over `pub type Handler = async fn(Request) -> Response`.
// That alias does not parse -- measured, `P0001: expected type (in type
// alias), found async` -- and a type alias of any kind is `E0900`, so
// `Server` at the end of this file types each handler inline as
// `fn(Request) -> Response`. A handler is therefore synchronous: it builds
// its response without awaiting. Routes by method, `:name` parameters
// (`req.params`), `405`, and the form, query and cookie readers shipped in
// Phase 4.7 (docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md
// §3); there is no client. `Server::listen` shuts down gracefully on SIGTERM or SIGINT
// (Ctrl+Break or Ctrl+C on Windows); see its own comment and
// docs/adr/0022-process-shutdown-signals.md. See also
// docs/adr/0019-offset-table-intrinsic-boundary.md and section 6's own dated
// amendments.
//
// **Parsing is one intrinsic and it returns offsets, not values.**
// `http_parse_request` hands back a flat `[Int]` table of byte offsets into
// the caller's own buffer -- no copies, no Rust-side state, nothing to
// release. `parse_offsets` below is a thin `pub` wrapper over it, the same
// shape `std/bytes`'s `bytes_from_ints` uses, so a fixture can pin the raw
// encoding; ordinary callers want `parse_request_head`.
//
// **Header names are lower-cased and the original casing is not kept.** HTTP
// field names are case-insensitive, so a `Map` keyed on the raw casing would
// answer `get("content-length")` differently depending on what the peer sent.
//
// **Two limitations of `read_request` below share one cause: it reads
// exactly one request's worth of bytes per connection turn and trusts
// `Content-Length` to say where that ends.** `Server` shares the first and
// not the second: it keeps one buffer per connection, so it answers
// pipelined requests in order.
//
// - `Content-Length` is the only framing either understands. Chunked
//   transfer-encoding is neither supported nor detected, so a chunked
//   request's body is left on the connection and is misread as the next
//   request.
// - `read_request` discards bytes already read past the current request's
//   body, so a pipelined request is lost and its connection deadlocks rather
//   than merely going unsupported. See `read_request`'s own doc comment for
//   the exact wording this needs.
//
// **A third limitation, with a different cause.** Neither `conn.read` call
// in `read_request` below carries a timeout, so a peer that connects and
// then sends nothing -- or sends a partial head or body and stops -- holds
// the task serving it parked forever. `std/net::TcpStream::read_timeout`
// already exists (`std/net/lib.nova`) and was not used there; see
// `read_request`'s own doc comment for the reasoning, and
// docs/adr/0019-offset-table-intrinsic-boundary.md's Consequences section
// for the same gap recorded against that ADR. `Server` does not share this
// one either: every wait in its `serve` is bounded.

// The request method. `Unknown` carries the raw token rather than discarding
// it: a request may carry any method a peer invents, and the parser must not
// abort on one it does not know.
//
// Named `Unknown` rather than `nova-spec/20-STDLIB.md` section 6's `Other`,
// deliberately. `Other` is already an `IoErrorKind` variant in `std/io`, every
// std module is glob-imported into every module, and whether two std modules
// may export one variant name is not established on this tree. This increment
// is not the place to find out.
/// An HTTP request method.
///
/// Seven methods have variants of their own, each matched exactly as written
/// in capitals; any other method, `get` in lower case included, is `Unknown`.
pub type Method =
    /// `GET`.
    | Get
    /// `POST`.
    | Post
    /// `PUT`.
    | Put
    /// `DELETE`.
    | Delete
    /// `PATCH`.
    | Patch
    /// `HEAD`.
    | Head
    /// `OPTIONS`.
    | Options
    /// Any other method, holding its name as the request wrote it.
    | Unknown(String)

// Why a request head was rejected.
//
// **This type is one half of a wire contract, for its first seven kinds.**
// The other half is the `ERR_*` constants in
// `crates/nova-runtime/src/http.rs`, which produce those seven codes. The two
// are independent copies of one numbering -- the shape that has already
// produced a miscompile in this project -- so `tests/runtime/http_malformed.nova`
// pins together the ones `http_error_kind_of` actually maps; see that
// function's own doc comment for exactly which those are, since "per kind"
// would overclaim -- not every one of the seven is currently reachable from
// a fixture through this type.
//
// `InvalidUtf8`, `BodyTooLarge` and `Transport` have no runtime counterpart
// and no `ERR_*` code: `std/http` reports all three itself, so none of them
// needs to stay in sync with the intrinsic's own numbering the way the first
// seven do.
/// Why reading or parsing a request failed.
pub type HttpErrorKind =
    /// The request head is too long: longer than the `max_head_bytes` of the
    /// `Limits` given, or than 8,192 bytes, whatever the limit.
    | HeadTooLarge
    /// The request head has more headers than the `max_header_count` of the
    /// `Limits` given, or more than 100, whatever the limit.
    | TooManyHeaders
    /// The request line is malformed: its method, target or version is not
    /// valid, or the version is not `HTTP/1.0` or `HTTP/1.1`.
    | BadRequestLine
    /// A header line is malformed, or `Content-Length` appears twice or is
    /// not a whole number written in digits.
    | BadHeader
    /// A line ends badly, as with a carriage return not followed by a line
    /// feed.
    | BadNewline
    /// The parser finished a head without its method, target or version,
    /// which it is not expected to do.
    | IncompleteHeadFields
    /// Part of a parsed head lay outside the bytes given, which the parser
    /// is not expected to do.
    | SliceOutOfBuffer
    /// A header's value is not valid UTF-8.
    | InvalidUtf8
    /// `Content-Length` is more than the `max_body_bytes` of the `Limits`
    /// given.
    | BodyTooLarge
    /// Reading from the connection failed, or the connection closed before
    /// the request was complete.
    | Transport

/// The error `read_request` and `parse_request_head` return.
pub record HttpError {
    /// What went wrong.
    pub kind: HttpErrorKind,
    /// A short description, such as `duplicate Content-Length header`. For a
    /// `Transport` error it is the connection's own error message, or
    /// `connection closed mid-head` or `connection closed mid-body`.
    pub message: String,
}

// Map a parse status to its kind. The argument is the **negated** status the
// intrinsic returned, so a status of `-3` arrives here as `3`.
//
// An unrecognised code is `BadRequestLine` rather than a panic: a status this
// function does not know is a runtime bug, and mapping it to a diagnosable
// kind keeps an error flowing instead of ending the process -- the same call
// `std/io`'s `io_error_kind_of` makes for the same reason.
//
// **Which of the seven codes a Nova fixture actually drives through this
// function, and which do not.** `BadRequestLine`, `BadHeader` and
// `BadNewline` (3, 4, 5) do: `tests/runtime/http_malformed.nova` feeds each
// one's triggering input to `parse_request_head` under `Limits::default()`
// and asserts the mapped kind on the `Err` it returns. `HeadTooLarge` and
// `TooManyHeaders` (1, 2) are different: their own raw negative status is
// observed directly through `parse_offsets` in `tests/runtime/http_limits.nova`,
// but every `parse_request_head` call in that fixture supplies a `Limits` at
// or below the runtime's own ceiling, so `parse_request_head`'s two
// Nova-side checks (just below) return a literal `HeadTooLarge` or
// `TooManyHeaders` before ever reaching `status < 0` there -- this
// function's own arms for 1 and 2 are real code, reachable by a caller whose
// `Limits` is looser than the runtime's wall, but no fixture currently
// drives them. `IncompleteHeadFields` (6) and `SliceOutOfBuffer` (7) are
// undemonstrated by any fixture, and differ from each other at their Rust
// call sites: `SliceOutOfBuffer`'s (`offset_within` in
// `crates/nova-runtime/src/http.rs`) argues from httparse's zero-copy
// contract that it cannot fire in practice and checks anyway, while
// `IncompleteHeadFields`'s call site carries no such argument either way.
/// Returns the `HttpErrorKind` for an error code from `parse_offsets`, which
/// reports the code as a negative status: pass the status negated.
///
/// Codes 1 to 7 are `HeadTooLarge`, `TooManyHeaders`, `BadRequestLine`,
/// `BadHeader`, `BadNewline`, `IncompleteHeadFields` and `SliceOutOfBuffer`,
/// in that order. Any other code gives `BadRequestLine`.
pub fn http_error_kind_of(code: Int) -> HttpErrorKind {
    if code == 1 { return HeadTooLarge }
    if code == 2 { return TooManyHeaders }
    if code == 3 { return BadRequestLine }
    if code == 4 { return BadHeader }
    if code == 5 { return BadNewline }
    if code == 6 { return IncompleteHeadFields }
    if code == 7 { return SliceOutOfBuffer }
    BadRequestLine
}

// Caller-chosen ceilings.
//
// **`max_head_bytes` and `max_header_count` may only tighten, never loosen.**
// The runtime compiles in its own hard wall (8 KiB and 100, in
// `crates/nova-runtime/src/http.rs`) and checks it before allocating anything
// on the Nova side, because the intrinsic takes one argument and there is
// nowhere for a caller's limit to arrive. The two fields here are checked on
// this side, in addition. `max_body_bytes` is this side's alone: the intrinsic
// returns `body_start` and never looks at the body.
/// Limits on the size of a request, for `read_request` and
/// `parse_request_head`.
///
/// `Limits::default()` allows a head of 8,192 bytes with 100 headers, and a
/// body of 1,048,576 bytes (1 MiB); `Server` always uses those. The two head
/// limits can only be made stricter: a head over 8,192 bytes, or with more
/// than 100 headers, is refused whatever they say.
pub record Limits {
    /// The most bytes a request head may take.
    pub max_head_bytes: Int,
    /// The most headers a request may have.
    pub max_header_count: Int,
    /// The largest `Content-Length` accepted.
    pub max_body_bytes: Int,
}

impl Default for Limits {
    fn default() -> Limits {
        Limits { max_head_bytes: 8192, max_header_count: 100, max_body_bytes: 1048576 }
    }
}

// A parsed request. `body` is the bytes after the head, already bounded by
// `Content-Length` and by `Limits::max_body_bytes`. `params` is the router's
// (spec docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md
// §3.1), as `nova-spec/20-STDLIB.md` section 6 has it, `req.params.get("id")`,
// rather than a second argument to every handler.
/// An HTTP request: its method, target, headers and body, and the parameters
/// the route that answers it took from its path.
pub record Request {
    /// The request's method.
    pub method: Method,
    /// The request's target as the request wrote it, query string included,
    /// such as `/search?q=nova`. Nothing in it is decoded.
    pub path: String,
    /// The headers, by lower-cased name. Each value has the spaces and tabs
    /// around it removed. Of two headers with the same name, the last is
    /// kept.
    pub headers: Map<String, String>,
    /// The body: as many bytes as `Content-Length` says, or none without that
    /// header. Empty in a request from `parse_request_head`.
    pub body: Bytes,
    /// What the pattern of the route that answers the request took from its
    /// path, by name, decoded: `/posts/:id` matching `/posts/7` puts `7`
    /// under `id`. `Server::dispatch` sets it before it calls the route's
    /// handler. It is empty in a request from `parse_request_head` or
    /// `read_request`, and in one a `fallback` handler gets.
    pub params: Map<String, String>,
}

impl Request {
    /// Returns the query of the request's target, the text after its first
    /// `?`, by name, decoded as a browser encodes a form's fields
    /// (`application/x-www-form-urlencoded`), as `std/ui/router`'s
    /// `use_query` decodes a location's query.
    ///
    /// The text is split at each `&`, and an empty part is skipped. A part is
    /// split at its first `=` into a name and a value; a part with no `=` is
    /// a name whose value is `""`. In each half `+` is a space, and each `%`
    /// followed by two hex digits is the byte they write, the bytes read as
    /// UTF-8; a half that holds a `%` not followed by two hex digits, or
    /// whose bytes are not UTF-8, is kept as written. Of two parts with the
    /// same name, the last wins. A target with no `?` gives an empty map.
    ///
    /// ```
    /// let raw = bytes_from_string("GET /search?q=nova+lang&tag=a%26b&tag=c&flag HTTP/1.1\r\n\r\n")
    /// let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
    /// let q = req.query()
    /// assert_eq(q.get("q").unwrap(), "nova lang")
    /// assert_eq(q.get("tag").unwrap(), "c") // the last of two wins
    /// assert_eq(q.get("flag").unwrap(), "") // no `=`, no value
    /// assert_eq(q.len(), 3)
    /// ```
    pub fn query(self) -> Map<String, String> {
        match self.path.index_of("?") {
            Some(at) => form_fields(self.path.slice(at + 1, self.path.len()))
            None => {
                let none: Map<String, String> = Map::new()
                none
            }
        }
    }

    /// Returns the fields of the form the request's body holds, by name,
    /// decoded as `query` decodes a query, when the body is a form a browser
    /// sent: its `content-type` header's media type, the part before any
    /// `;`, trimmed and read in any case, is
    /// `application/x-www-form-urlencoded`, and the body is UTF-8. Any other
    /// request, one with no `content-type` or a form sent as
    /// `multipart/form-data` included, gives an empty map.
    ///
    /// ```
    /// let mut headers: Map<String, String> = Map::new()
    /// headers.insert("content-type", "application/x-www-form-urlencoded; charset=UTF-8")
    /// let req = Request {
    ///     method: Post,
    ///     path: "/comments",
    ///     headers: headers,
    ///     body: bytes_from_string("name=Ada+L.&text=Hi%21+%E2%9C%93"),
    ///     params: Map::new(),
    /// }
    /// let form = req.form()
    /// assert_eq(form.get("name").unwrap(), "Ada L.")
    /// assert_eq(form.get("text").unwrap(), "Hi! \u{2713}")
    ///
    /// // The same body as JSON is no form.
    /// let mut json: Map<String, String> = Map::new()
    /// json.insert("content-type", "application/json")
    /// let other = Request { method: Post, path: "/comments", headers: json, body: req.body, params: Map::new() }
    /// assert(other.form().is_empty(), "not a form")
    /// ```
    pub fn form(self) -> Map<String, String> {
        let none: Map<String, String> = Map::new()
        let media = match self.headers.get("content-type") {
            Some(v) => {
                match v.index_of(";") {
                    Some(at) => v.slice(0, at).trim().to_lower()
                    None => v.trim().to_lower()
                }
            }
            None => return none
        }
        if media != "application/x-www-form-urlencoded" { return none }
        match self.body.to_string() {
            Some(text) => form_fields(text)
            None => none
        }
    }

    /// Returns the cookies the request's `cookie` header holds, by name.
    ///
    /// The header is split at each `;`, and each part trimmed, then split at
    /// its first `=` into a name and a value. A part with no `=` is skipped,
    /// and of two cookies with the same name the first is kept, since a
    /// browser sends the one set for the longest path first. Values are
    /// returned as sent, not decoded. A request with no `cookie` header gives
    /// an empty map.
    ///
    /// ```
    /// let raw = bytes_from_string("GET / HTTP/1.1\r\nCookie: sid=abc.123; theme=dark; sid=old\r\n\r\n")
    /// let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
    /// let cookies = req.cookies()
    /// assert_eq(cookies.get("sid").unwrap(), "abc.123") // the first of two
    /// assert_eq(cookies.get("theme").unwrap(), "dark")
    /// assert_eq(cookies.len(), 2)
    /// ```
    pub fn cookies(self) -> Map<String, String> {
        let mut out: Map<String, String> = Map::new()
        let header = match self.headers.get("cookie") {
            Some(v) => v
            None => return out
        }
        let parts = header.split(";")
        let mut i = 0
        while i < parts.len() {
            let part = parts[i].trim()
            match part.index_of("=") {
                Some(eq) => {
                    let name = part.slice(0, eq)
                    if !out.contains_key(name) {
                        let _ = out.insert(name, part.slice(eq + 1, part.len()))
                    }
                }
                None => {}
            }
            i = i + 1
        }
        out
    }
}

// The fields of `text`, a query or a form's body, as `Request::query` says,
// by `std/ui/router`'s `query_of` rules, which this copies since std/http
// cannot import std/ui: `&`-separated parts, each `name=value` or a `name`
// whose value is `""`, both halves decoded with `+` as a space, an empty part
// skipped, and a name's last value winning. `query` and `form` share it
// (spec §12, decision 4).
fn form_fields(text: String) -> Map<String, String> {
    let mut out: Map<String, String> = Map::new()
    let parts = text.split("&")
    let mut i = 0
    while i < parts.len() {
        let part = parts[i]
        if part != "" {
            let mut name = part
            let mut value = ""
            match part.index_of("=") {
                Some(eq) => {
                    name = part.slice(0, eq)
                    value = part.slice(eq + 1, part.len())
                }
                None => {}
            }
            let _ = out.insert(form_decoded(name), form_decoded(value))
        }
        i = i + 1
    }
    out
}

// A half of a form's part: `+` is a space, then percent-decoding.
fn form_decoded(text: String) -> String { percent_decoded(" ".join(text.split("+"))) }

// `text` percent-decoded as UTF-8, or as written when a `%` is not followed
// by two hex digits or the bytes are not UTF-8: `std/ui/router`'s `decoded`,
// copied, so a server and its client read a path and a query alike.
fn percent_decoded(text: String) -> String {
    if !text.contains("%") { return text }
    let bs = bytes_from_string(text).to_ints()
    let mut out = [0; bs.len()]
    let mut n = 0
    let mut i = 0
    while i < bs.len() {
        if bs[i] == 37 {
            if i + 2 >= bs.len() { return text }
            let hi = hex_value(bs[i + 1])
            let lo = hex_value(bs[i + 2])
            if hi < 0 || lo < 0 { return text }
            out[n] = hi * 16 + lo
            i = i + 3
        } else {
            out[n] = bs[i]
            i = i + 1
        }
        n = n + 1
    }
    bytes_from_ints(out).slice(0, n).to_string().unwrap_or(text)
}

// The value of the hex digit whose ASCII code is `b`, or -1.
fn hex_value(b: Int) -> Int {
    if b >= 48 && b <= 57 {
        b - 48
    } else if b >= 65 && b <= 70 {
        b - 55
    } else if b >= 97 && b <= 102 {
        b - 87
    } else {
        -1
    }
}

// The pieces of `path`, a request's path or a route's pattern: split at `/`,
// with the empty ones dropped, each percent-decoded, or kept as written when
// it does not decode -- `std/ui/router`'s `pieces_of`, copied, so a server's
// route and a client's agree on what a path is (spec §3.1).
fn path_pieces(path: String) -> [String] {
    let parts = path.split("/")
    let mut n = 0
    let mut i = 0
    while i < parts.len() {
        if parts[i] != "" { n = n + 1 }
        i = i + 1
    }
    let mut out = [""; n]
    let mut k = 0
    let mut j = 0
    while j < parts.len() {
        if parts[j] != "" {
            out[k] = percent_decoded(parts[j])
            k = k + 1
        }
        j = j + 1
    }
    out
}

// The raw offset table for `buf`, exactly as
// `crates/nova-runtime/src/http.rs` encodes it.
//
// **Element 0 is a status and a caller must read it first.** `0` is a complete
// head, `1` is a partial one (read more bytes and call again), and a negative
// value is the negation of an error kind. On any non-zero status **the array
// has length 1**, so a caller who skips the check indexes out of bounds rather
// than reading a plausible-looking offset. That is deliberate.
//
// Exposed so `tests/runtime/http_offsets.nova` can pin the encoding from this
// side; ordinary callers want `parse_request_head`.
/// Returns the raw table of byte offsets that parsing the request head at the
/// start of `buf` gives. `parse_request_head` is usually the one to call.
///
/// Element 0 is a status: 0 for a complete head, 1 for an incomplete one, and
/// otherwise a negative error code, which `http_error_kind_of` turns into a
/// kind once negated. Unless the status is 0, the table holds only that
/// element. A complete head's table goes on with the method's start
/// and length, the target's start and length, the HTTP minor version (0 or
/// 1), the number of headers, four elements per header (its name's start and
/// length, then its value's), and last the offset where the body starts. All
/// offsets count bytes from the start of `buf`.
pub fn parse_offsets(buf: Bytes) -> [Int] { http_parse_request(buf) }

// Decode a complete head out of `buf`, or report that more bytes are needed.
//
// `Ok(None)` means the head is incomplete: read more and call again with the
// longer buffer. `Ok(Some(req))` is a complete head, with `body` empty --
// `read_request` fills that in once it knows `Content-Length`.
/// Parses the request head at the start of `buf`.
///
/// Returns `Ok(None)` if `buf` does not yet hold a whole head: read more and
/// call again with the longer buffer. Once it does, returns `Ok(Some(req))`,
/// whose `body` is empty: the body's length is in its `content-length`
/// header. Lines may end with a carriage return and line feed or with a line
/// feed alone, and empty lines before the request line are skipped.
///
/// Returns an `HttpError` whose kind says how the head is malformed, or
/// `HeadTooLarge` or `TooManyHeaders` if it breaks `limits`. The byte limit
/// applies to all of `buf`, so bytes after the head count against it too. A
/// second `Content-Length` header is `BadHeader`, and a header value that is
/// not valid UTF-8 is `InvalidUtf8`.
///
/// Part of a head, then all of it:
///
/// ```
/// let limits = Limits::default()
///
/// // Part of a head is `Ok(None)`: read more, then try again with it all.
/// let start = bytes_from_string("GET /items HTTP/1.1\r\nHost: shop")
/// assert(parse_request_head(start, limits).unwrap().is_none(), "not a whole head yet")
/// let whole = start.concat(bytes_from_string("\r\n\r\n"))
/// let req = parse_request_head(whole, limits).unwrap().unwrap()
/// assert_eq(req.path, "/items")
/// assert_eq(req.headers.get("host").unwrap(), "shop")
///
/// // A malformed head is an `Err`.
/// assert(
///     parse_request_head(bytes_from_string("HELLO\r\n\r\n"), limits).is_err(),
///     "no target or version",
/// )
/// ```
pub fn parse_request_head(buf: Bytes, limits: Limits) -> Result<Option<Request>, HttpError> {
    // Measures the accumulated read buffer, not the head's own exact length:
    // when called from `read_request`, `buf` may hold a few bytes past the
    // head's end if the read that completed it also pulled in the start of
    // the body, so a legal head can be rejected slightly before its own
    // exact byte count if the peer's writes happen to land that way. The
    // design spec's own words license exactly this ("bounds the buffer a
    // client can force before the head completes"), not an exact bound on
    // the head alone.
    if buf.len() > limits.max_head_bytes {
        return Err(HttpError { kind: HeadTooLarge, message: "request head over max_head_bytes" })
    }
    let t = parse_offsets(buf)
    let status = t[0]
    if status == 1 { return Ok(None) }
    if status < 0 {
        let kind = http_error_kind_of(0 - status)
        return Err(HttpError { kind: kind, message: "request head rejected by the parser" })
    }
    let n = t[6]
    if n > limits.max_header_count {
        return Err(
            HttpError { kind: TooManyHeaders, message: "header count over max_header_count" },
        )
    }
    let method = method_from(text_at(buf, t[1], t[2]))
    let path = text_at(buf, t[3], t[4])
    let mut headers: Map<String, String> = Map::new()
    let mut i = 0
    while i < n {
        let at = 7 + 4 * i
        // Lower-cased because HTTP field names are case-insensitive. Full
        // Unicode lowercasing has nothing to bite on here: `httparse`
        // validates a name as an HTTP token, which is ASCII-only, so this
        // sees only ASCII.
        let name = text_at(buf, t[at], t[at + 1]).to_lower()
        let mut value = ""
        match text_at_utf8(buf, t[at + 2], t[at + 3]) {
            Ok(s) => value = s
            Err(e) => return Err(e)
        }
        // A second `Content-Length` header is rejected outright rather than
        // silently overwritten by `insert` below. RFC 9112 section 6.3 treats
        // multiple `Content-Length` fields with differing values as invalid
        // framing; this takes the simpler and stricter position of rejecting
        // any repeat, matching or not, rather than keeping the first value
        // and comparing it against every later one -- there is exactly one
        // value available to compare against here regardless, since this
        // loop (like `Map::insert`) only ever sees the latest one once a
        // name repeats, so "compare instead of reject" would need its own
        // separate bookkeeping to buy anything.
        if name == "content-length" && headers.contains_key(name) {
            return Err(HttpError { kind: BadHeader, message: "duplicate Content-Length header" })
        }
        headers.insert(name, value)
        i = i + 1
    }
    Ok(
        Some(
            Request {
                method: method,
                path: path,
                headers: headers,
                body: bytes_from_string(""),
                params: Map::new(),
            },
        ),
    )
}

// The bytes `buf[start .. start+len]` as text, defaulting to the empty
// string if they are not valid UTF-8.
//
// Safe for the method, the path, and a header's name -- but not for a
// header's value, which is why that fourth call site uses `text_at_utf8`
// below instead of this function. Checked directly against the locked
// `httparse` 1.10.1 source (`crates/nova-runtime`'s `Cargo.lock` entry)
// rather than assumed:
//
// - The method is matched against literal `"GET "`/`"POST "` or, failing
//   that, `parse_token`'s `is_method_token`, which is backed by `TOKEN_MAP`
//   -- ASCII-only -- so it cannot be anything but ASCII.
// - A header's name is matched against `TOKEN_MAP` the same way
//   (`is_header_name_token`), so the same argument applies.
// - The path looks like it should be the same risk as a header's value --
//   `parse_uri` scans it against `URI_MAP`, which (like `HEADER_VALUE_MAP`
//   below) admits `0x80..=0xFF` -- but `parse_uri` then validates the whole
//   scanned slice with `str::from_utf8` and fails the *entire request line*
//   (`Error::Token`) if that fails. So `httparse::Request::path` is
//   `Option<&str>`, not bytes, and a `Complete` parse cannot have produced
//   an invalid one. Measured, not assumed: a lone `0x80` byte placed in the
//   path (no valid UTF-8 continuation) was tried against this parser
//   directly, and it rejected the whole request line as `BadRequestLine`
//   rather than completing with an undecodable path -- this function's
//   `None` branch is not reachable from that call site.
fn text_at(buf: Bytes, start: Int, len: Int) -> String {
    match buf.slice(start, start + len).to_string() {
        Some(s) => s
        None => ""
    }
}

// The bytes `buf[start .. start+len]` as text, or `InvalidUtf8` if they are
// not valid UTF-8.
//
// Used only for a header's value -- the one call site `text_at`'s doc
// comment, just above, does not cover. `httparse::Header::value` is `&[u8]`,
// not `&str`: httparse's own doc comment on that field says a value "may
// not" be ASCII and stores it as bytes with no UTF-8 check anywhere, unlike
// the method, path and header-name sites, which are already `&str` by the
// time this module sees them. A byte outside ASCII is legal there under
// HTTP's obs-text allowance (`HEADER_VALUE_MAP` admits `0x80..=0xFF`, the
// same range `URI_MAP` admits), and such a byte need not be valid UTF-8 on
// its own -- measured directly: a request whose entire header value is one
// literal `0x80` byte parses to `status = 0` like any other request, with a
// value offset pointing at a byte `to_string` reports as not UTF-8.
// Silently substituting "" there would discard real request data with no
// signal, which is what an earlier version of this module did at every call
// site alike. See `tests/runtime/http_malformed.nova`'s non-UTF-8 case.
fn text_at_utf8(buf: Bytes, start: Int, len: Int) -> Result<String, HttpError> {
    match buf.slice(start, start + len).to_string() {
        Some(s) => Ok(s)
        None => Err(HttpError { kind: InvalidUtf8, message: "header value is not valid UTF-8" })
    }
}

fn method_from(token: String) -> Method {
    if token == "GET" { return Get }
    if token == "POST" { return Post }
    if token == "PUT" { return Put }
    if token == "DELETE" { return Delete }
    if token == "PATCH" { return Patch }
    if token == "HEAD" { return Head }
    if token == "OPTIONS" { return Options }
    Unknown(token)
}

// A response to serialise onto a connection.
//
// **Header order on the wire is `headers`' iteration order**, which is a
// `Map`'s bucket order and therefore varies per process: `impl Hash for
// String` is seeded per process, which is exactly the property that makes a
// `Map` keyed on attacker-supplied header names resist a precomputed
// collision set. HTTP does not require a header order, so nothing here
// depends on it -- but that same seeding means a whole-response `.eq()`
// against one fixed byte sequence cannot be a stable test, not merely an
// inconvenient one to write: which of two headers comes first changes from
// run to run. Measured, not just argued from the seeding --
// `tests/runtime/http_serialise.nova` compared the whole buffer against one
// fixed ordering first, and printed `wire matches false` about as often as
// `true` across repeated separate runs. It checks the parts a header order
// cannot move instead: the exact status line, the exact tail (the blank line
// and the body), and that each expected header line occurs somewhere
// between them.
/// An HTTP response: a status code, headers, a body, and the cookies it
/// sets.
///
/// `ok`, `text`, `html`, `json`, `redirect` and `not_found` build the common
/// ones, and each sets `content-length`. A response built by hand should set
/// it too: `Server` keeps the connection open after a response, so without it
/// a client cannot tell where the body ends.
pub record Response {
    /// The status code, such as 200 or 404. It is written as given, without
    /// a check.
    pub status: Int,
    /// The headers, by name. Each name is written as given, and their order
    /// on the wire can change from one run of a program to the next.
    pub headers: Map<String, String>,
    /// The body.
    pub body: Bytes,
    /// The cookies the response sets, in order, each written as a
    /// `set-cookie` header of its own: a `Map` of headers holds one value
    /// per name, so they cannot be headers. `with_cookie` adds one.
    pub cookies: [Cookie],
}

impl Response {
    // `200 OK` carrying `body`, with `content-length` set from it.
    /// Returns a `200 OK` response carrying `body`, with `content-length` set
    /// and no `content-type`.
    pub fn ok(body: Bytes) -> Response {
        let mut h: Map<String, String> = Map::new()
        h.insert("content-length", "${body.len()}")
        Response { status: 200, headers: h, body: body, cookies: [] }
    }

    // `status` carrying `s` as UTF-8 text.
    /// Returns a response with status `status` carrying `s` as UTF-8 text,
    /// with `content-type` set to `text/plain; charset=utf-8` and
    /// `content-length` to the text's length in bytes.
    pub fn text(status: Int, s: String) -> Response {
        let body = bytes_from_string(s)
        let mut h: Map<String, String> = Map::new()
        h.insert("content-length", "${body.len()}")
        h.insert("content-type", "text/plain; charset=utf-8")
        Response { status: status, headers: h, body: body, cookies: [] }
    }

    // `text`'s twin for HTML (spec
    // docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md
    // §3.3). `s` is written as given: escaping is the caller's, as `std/ui`'s
    // renderers do it.
    /// Returns a response with status `status` carrying `s` as an HTML page,
    /// with `content-type` set to `text/html; charset=utf-8` and
    /// `content-length` to its length in bytes. `s` is sent as given, so
    /// text from a visitor in it must already be escaped, as `std/ui`
    /// escapes what it renders.
    ///
    /// ```
    /// let r = Response::html(201, "<p>Saved</p>")
    /// assert_eq(r.status, 201)
    /// assert_eq(r.headers.get("content-type").unwrap(), "text/html; charset=utf-8")
    /// assert_eq(r.headers.get("content-length").unwrap(), "12")
    /// assert_eq(r.body.to_string().unwrap(), "<p>Saved</p>")
    /// ```
    pub fn html(status: Int, s: String) -> Response {
        let body = bytes_from_string(s)
        let mut h: Map<String, String> = Map::new()
        h.insert("content-length", "${body.len()}")
        h.insert("content-type", "text/html; charset=utf-8")
        Response { status: status, headers: h, body: body, cookies: [] }
    }

    // `303 See Other`, the answer to a form's `POST` that succeeded, so the
    // browser follows it with a `GET` (post, redirect, get).
    /// Returns a `303 See Other` response sending the browser to `location`,
    /// which it then asks for with a `GET`: the `location` header set to it,
    /// `content-length` to `0`, and no body. A `location` holding a carriage
    /// return or a line feed is left out by `to_bytes`, as any such header
    /// is.
    ///
    /// ```
    /// let r = Response::redirect("/posts/7#comments")
    /// assert_eq(r.status, 303)
    /// assert_eq(r.headers.get("location").unwrap(), "/posts/7#comments")
    /// assert_eq(r.headers.get("content-length").unwrap(), "0")
    /// assert(r.to_bytes().to_string().unwrap().starts_with("HTTP/1.1 303 See Other\r\n"), "303")
    /// ```
    pub fn redirect(location: String) -> Response {
        let mut h: Map<String, String> = Map::new()
        h.insert("location", location)
        h.insert("content-length", "0")
        Response { status: 303, headers: h, body: bytes_from_string(""), cookies: [] }
    }

    // A copy with one more cookie. The new array is built whole, so `self`'s
    // own stays as it was, as `Server::get` leaves its receiver's routes.
    /// Returns a copy of this response that also sets `c`, after the cookies
    /// it already sets.
    ///
    /// `self` is left unchanged, so calls chain. Each cookie is written as a
    /// `set-cookie` header of its own, after the other headers; one that
    /// `Cookie` says cannot be written is left out.
    ///
    /// ```
    /// let r = Response::redirect("/")
    ///     .with_cookie(Cookie::new("sid", "abc.123"))
    ///     .with_cookie(Cookie::expired("old"))
    /// let wire = r.to_bytes().to_string().unwrap()
    /// assert(wire.contains("\r\nset-cookie: sid=abc.123; Path=/; HttpOnly; SameSite=Lax\r\n"), wire)
    /// assert(wire.contains("\r\nset-cookie: old=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax\r\n"), wire)
    /// ```
    pub fn with_cookie(self, c: Cookie) -> Response {
        let n = self.cookies.len()
        // `[c; n + 1]` holds `c` in every slot; each slot but the last is
        // overwritten with the cookie already there.
        let mut all = [c; n + 1]
        let mut i = 0
        while i < n {
            all[i] = self.cookies[i]
            i = i + 1
        }
        Response { status: self.status, headers: self.headers, body: self.body, cookies: all }
    }

    /// Returns a `404 Not Found` response whose body is the text `not found`.
    ///
    /// `Server` answers with it when no route matches.
    pub fn not_found() -> Response { Response::text(404, "not found") }

    // `200 OK` carrying `v` as JSON text, with `content-type` and
    // `content-length` set. It takes the name section 6 gives a client-side
    // decoder (`json<T: FromJson>(self)`): there is no client, and one type
    // cannot have both, so the constructor has it.
    /// Returns a `200 OK` response carrying `v` as JSON text, as `stringify`
    /// writes it, with `content-type` set to `application/json` and
    /// `content-length` set.
    ///
    /// Panics where `stringify` does, if arrays and objects in `v` nest too
    /// deep.
    pub fn json(v: JsonValue) -> Response {
        let body = bytes_from_string(stringify(v))
        let mut h: Map<String, String> = Map::new()
        h.insert("content-length", "${body.len()}")
        h.insert("content-type", "application/json")
        Response { status: 200, headers: h, body: body, cookies: [] }
    }

    // The response as it goes on the wire.
    //
    // No intrinsic backs this: a response is a status line, a header block and
    // a body, which Nova builds with string interpolation and `Bytes::concat`.
    // That is the design's decision rather than a gap -- see
    // docs/adr/0019-offset-table-intrinsic-boundary.md.
    /// Returns the response as it is sent: the status line, one line per
    /// header, one `set-cookie` line per cookie, a blank line, and the body.
    /// Each line ends with a carriage return and a line feed.
    ///
    /// The status line holds `HTTP/1.1`, the status code and a reason phrase:
    /// the usual one for 200, 201, 204, 301, 302, 303, 400, 401, 403, 404,
    /// 405, 413 and 500, and for any other code a phrase for its class, such
    /// as `Client Error`. Each header is written `name: value`. A header
    /// whose name or value holds a carriage return or a line feed is left
    /// out, so it cannot add lines of its own. The cookies come after the
    /// headers, in order, each written as `Cookie` says, and one it says
    /// cannot be written is left out. Nothing else is added: no header the
    /// response does not hold.
    pub fn to_bytes(self) -> Bytes {
        let mut head = "HTTP/1.1 ${self.status} ${reason_phrase(self.status)}\r\n"
        let names = self.headers.keys()
        let mut i = 0
        while i < names.len() {
            let k = names[i]
            match self.headers.get(k) {
                // A header whose name or value carries a CR or LF is
                // skipped rather than emitted: see `is_crlf_free`'s own doc
                // comment for why this is the right layer to refuse it.
                Some(v) => {
                    if is_crlf_free(k) && is_crlf_free(v) { head = "${head}${k}: ${v}\r\n" }
                }
                None => head = head
            }
            i = i + 1
        }
        // After the headers, so the order of the cookies, which a `Map` does
        // not decide, is the order they were added in.
        let mut c = 0
        while c < self.cookies.len() {
            match cookie_line(self.cookies[c]) {
                Some(line) => head = "${head}set-cookie: ${line}\r\n"
                None => {}
            }
            c = c + 1
        }
        bytes_from_string("${head}\r\n").concat(self.body)
    }
}

// A cookie a response sets: one `Set-Cookie` header (RFC 6265 section 4.1),
// a field of `Response` of its own rather than a header map holding several
// values (spec docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md
// §3.3 and §12, decision 5). `Cookie::new`'s defaults are the safe ones
// (decision 6). There is no `Domain` and no `Expires`: a cookie is the
// host's own, and `Max-Age` says how long it lasts, since std/time writes no
// HTTP date.
//
// **What is refused, and why each rule is the one it is.** The serialiser
// is the right layer to refuse a cookie that would forge a header or an
// attribute, for the reason `is_crlf_free` gives for headers: it cannot see
// where a value came from. A name must be an HTTP token (RFC 9110 section
// 5.6.2), as RFC 6265's cookie-name is; a value must be RFC 6265's
// `*cookie-octet`, so no space, `"`, `,`, `;` or `\`, no control character
// and nothing outside ASCII -- the quoted form RFC 6265 also allows is not
// written, a choice that keeps one rule; a path must be RFC 6265's
// path-value, any CHAR but a control character or `;`; and `same_site`,
// which the spec leaves open, must be empty or a token, so it cannot carry
// a `;` and an attribute of its own either.
/// A cookie for a response to set, with `Response::with_cookie`.
///
/// `Cookie::new` gives the safe attributes, which the fields can change
/// afterwards in a `let mut` binding. `Response::to_bytes` writes a cookie
/// as one `set-cookie` header: `name=value`, then each attribute that
/// applies, in this order: `Path` when `path` is not empty, `Max-Age` when
/// `max_age` holds a number, `HttpOnly`, `SameSite` when `same_site` is not
/// empty, and `Secure`. There is no `Domain` and no `Expires`.
///
/// A cookie is left out, as a header holding a carriage return or a line
/// feed is, when one of its parts holds what a cookie cannot carry:
///
/// - a name that is not an HTTP token: one or more characters, each an ASCII
///   letter or digit or one of ``!#$%&'*+-.^_`|~``;
/// - a value holding anything but RFC 6265's cookie-octets, the ASCII
///   characters from `!` to `~` less `"`, `,`, `;` and `\`: so no space, no
///   control character and nothing outside ASCII. An empty value is a
///   value, and one in double quotes is refused;
/// - a path holding a control character (U+0000 to U+001F, or U+007F), a
///   `;`, or anything outside ASCII;
/// - a `same_site` that is neither empty nor a token.
///
/// A value that needs other characters can be encoded first, as
/// `Bytes::to_hex` encodes bytes.
pub record Cookie {
    /// The cookie's name, such as `sid`.
    pub name: String,
    /// Its value, written as given.
    pub value: String,
    /// The path whose requests the browser sends it with, and those below
    /// it: `/` for every path. `""` writes no `Path`, and the browser takes
    /// the directory of the page that set it.
    pub path: String,
    /// How many seconds the cookie lasts, written as `Max-Age`; `Some(0)`
    /// removes it. `None` writes no `Max-Age`, so it lasts until the
    /// browser's session ends.
    pub max_age: Option<Int>,
    /// Whether the page's scripts are kept from reading it: `HttpOnly`.
    pub http_only: Bool,
    /// When the browser sends it with a request another site starts:
    /// `"Strict"`, `"Lax"` or `"None"`, written as `SameSite`. `""` writes no
    /// `SameSite`.
    pub same_site: String,
    /// Whether the browser sends it only over HTTPS: `Secure`.
    pub secure: Bool,
}

impl Cookie {
    /// Returns the cookie `name` holding `value`, with the safe attributes:
    /// path `/`, no `Max-Age`, so it lasts until the browser's session ends,
    /// `HttpOnly`, `SameSite=Lax`, and not `Secure`, so it is sent over HTTP
    /// too.
    ///
    /// ```
    /// let c = Cookie::new("theme", "dark")
    /// assert_eq(c.path, "/")
    /// assert(c.max_age.is_none(), "a cookie for the browser's session")
    /// assert(c.http_only && !c.secure, "HttpOnly, and not only over HTTPS")
    /// assert_eq(c.same_site, "Lax")
    ///
    /// // Fields change in a `let mut` binding: a cookie that lasts a day.
    /// let mut day = Cookie::new("seen", "1")
    /// day.max_age = Some(86400)
    /// let wire = Response::ok(bytes_from_string("")).with_cookie(day).to_bytes().to_string().unwrap()
    /// assert(wire.contains("set-cookie: seen=1; Path=/; Max-Age=86400; HttpOnly; SameSite=Lax\r\n"), wire)
    /// ```
    pub fn new(name: String, value: String) -> Cookie {
        Cookie {
            name: name,
            value: value,
            path: "/",
            max_age: None,
            http_only: true,
            same_site: "Lax",
            secure: false,
        }
    }

    /// Returns the cookie that removes the cookie `name` from the browser:
    /// `Cookie::new(name, "")` with `Max-Age=0`. A cookie is replaced only by
    /// one of the same name and path, so this one's path, `/`, must be the
    /// path the cookie was set with.
    ///
    /// ```
    /// let c = Cookie::expired("sid")
    /// assert_eq(c.value, "")
    /// assert_eq(c.max_age.unwrap(), 0)
    /// assert_eq(c.path, "/")
    /// ```
    pub fn expired(name: String) -> Cookie {
        let mut c = Cookie::new(name, "")
        c.max_age = Some(0)
        c
    }
}

// `c` as a `Set-Cookie` header's value, or `None` when a part of it holds
// what a cookie cannot carry (`Cookie`'s comment).
fn cookie_line(c: Cookie) -> Option<String> {
    if !is_token(c.name) { return None }
    if !all_chars(c.value, is_cookie_octet) { return None }
    if !all_chars(c.path, is_path_char) { return None }
    if c.same_site != "" && !is_token(c.same_site) { return None }
    let mut line = "${c.name}=${c.value}"
    if c.path != "" { line = "${line}; Path=${c.path}" }
    match c.max_age {
        Some(n) => line = "${line}; Max-Age=${n}"
        None => {}
    }
    if c.http_only { line = "${line}; HttpOnly" }
    if c.same_site != "" { line = "${line}; SameSite=${c.same_site}" }
    if c.secure { line = "${line}; Secure" }
    Some(line)
}

// Whether `s` is an HTTP token (RFC 9110 section 5.6.2): one or more
// `tchar`s, ASCII letters and digits and ``!#$%&'*+-.^_`|~``.
fn is_token(s: String) -> Bool { s != "" && all_chars(s, is_tchar) }

fn is_tchar(code: Int) -> Bool {
    // Digits, then upper- and lower-case letters.
    if code >= 48 && code <= 57 { return true }
    if code >= 65 && code <= 90 { return true }
    if code >= 97 && code <= 122 { return true }
    // ! # $ % & ' * + - . ^ _ ` | ~
    if code == 33 || (code >= 35 && code <= 39) || code == 42 || code == 43 { return true }
    if code == 45 || code == 46 || code == 94 || code == 95 || code == 96 { return true }
    code == 124 || code == 126
}

// RFC 6265's cookie-octet: %x21, %x23-2B, %x2D-3A, %x3C-5B and %x5D-7E,
// which leaves out controls, space, `"`, `,`, `;`, `\`, DEL and all beyond
// ASCII.
fn is_cookie_octet(code: Int) -> Bool {
    if code == 33 || (code >= 35 && code <= 43) || (code >= 45 && code <= 58) { return true }
    // A line may not start with `(`: it would call the `if` above.
    let upper = code >= 60 && code <= 91
    upper || (code >= 93 && code <= 126)
}

// RFC 6265's path-value: any CHAR (US-ASCII) but a control character or
// `;`, so U+0020 to U+007E less `;`.
fn is_path_char(code: Int) -> Bool { code >= 32 && code <= 126 && code != 59 }

// Whether `ok` holds for the code of each character of `s`.
fn all_chars(s: String, ok: fn(Int) -> Bool) -> Bool {
    let cs = s.chars()
    let mut i = 0
    while i < cs.len() {
        if !ok(char_to_int(cs[i])) { return false }
        i = i + 1
    }
    true
}

// Whether `s` contains no CR and no LF, and so is safe to place verbatim in
// one header line.
//
// **Response splitting is a real vulnerability class, and a stdlib
// serialiser is the right layer to refuse it rather than every caller
// separately.** A header name or value carrying an embedded CRLF can
// terminate the line `to_bytes` is building early and forge arbitrary
// further header lines -- or even a second status line -- into what the
// peer reads as one response. Request-derived strings cannot carry either
// byte: `httparse` itself terminates the request line and every header
// value at CRLF, so the reachable case is a handler that writes body-derived
// or otherwise untrusted data straight into a response header.
//
// **This paragraph used to name `examples/05-json-api` as exactly that
// shape, and that example is the opposite of it.** The sentence was written
// before the example existed, so nothing checked it. `json_response` there
// sets two headers -- a literal `application/json`, and `"${b.len()}"`, an
// `Int` interpolation -- and neither can carry CR or LF, which makes it the
// pattern to copy rather than the hazard to point at. The argument for this
// check never rested on an exemplar anyway: the serialiser cannot see where
// a caller's value came from, so it refuses the bytes whatever the current
// set of callers happens to do. Whether some handler in the tree does feed
// untrusted data into a header is a search of `*.nova` for `insert(`, read
// for which hits write into a header map and where each value comes from --
// it is not this comment.
//
// `to_bytes` above skips (does not emit) any header whose name or value
// fails this check, rather than emitting it verbatim or panicking, and its
// own `Bytes`-returning signature is unchanged for that -- becoming
// fallible here was judged out of scope for this fix. A caller that must
// know whether a header was dropped needs to check its own data before
// handing it to `Response`; silently dropping is still strictly safer than
// the alternative of emitting it.
fn is_crlf_free(s: String) -> Bool { !s.contains("\r") && !s.contains("\n") }

// The reason phrase for a status code. Unknown codes get the class's own
// phrase rather than an empty string: HTTP/1.1 lets a client ignore the
// phrase entirely, so a plausible one costs nothing and reads better in a
// packet capture than a blank.
fn reason_phrase(status: Int) -> String {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 303 { return "See Other" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 413 { return "Payload Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status < 200 { return "Informational" }
    if status < 300 { return "Success" }
    if status < 400 { return "Redirection" }
    if status < 500 { return "Client Error" }
    "Server Error"
}

// The transport half: reading a request off a connection and writing a
// response back onto one, honouring keep-alive. `std/net`'s `TcpStream` is
// the only socket type either function below touches, through the `Read` and
// `Write` impls that module defines for it -- neither function opens one.
// Only `Server::listen`, at the end of this file, binds a listener.

// Read one request from `conn`, honouring keep-alive: the caller loops, and
// this reads exactly one request's head and body, leaving anything after it
// on the connection.
//
// **This accumulates the head with `Bytes::concat`, which is O(n) per call**,
// so building an n-byte head out of k reads is O(n*k). Bounded by
// `max_head_bytes` at 8 KiB that is not worth a rope or a growable buffer;
// it is noted here so a reader knows it was weighed rather than missed.
//
// **One socket wait per task.** Staging two I/O waits in one poll ends the
// process (`stage_park` in `crates/nova-runtime/src/task.rs`), so a task
// parked in `accept` cannot also be here. A server needs one task accepting
// and one per connection -- see `std/net`'s `accept` doc comment.
//
// **Neither `conn.read` call below carries a timeout, and that is a live
// denial-of-service, not a hygiene gap.** Both park with no deadline
// (`crates/nova-runtime/src/net.rs`'s `poll_read` calls
// `stage_io_park(socket, Interest::Read, None)` -- the trailing `None` is
// the deadline argument). A peer that connects and sends nothing, or sends a
// partial head or body and then goes silent, holds this task parked
// forever, and on the single-threaded executor this project runs, one such
// connection costs one socket and one task, indefinitely, for the price of
// a single `connect`. `std/net`'s `TcpStream::read_timeout`
// (`std/net/lib.nova`) already exists and documents EOF semantics identical
// to plain `read`'s; it was not used here. That is recorded as a gap in
// this increment's own spec, not an oversight this code silently carries --
// section 6's limits table is entirely byte-valued, so no task in this
// increment was ever asked for a temporal bound. Implementing one is later
// work; disclosing its absence is not.
//
// **A pipelined second request deadlocks the connection; it is not merely
// unsupported.** This function reads into a local buffer and returns
// `body.slice(0, want)`, so any bytes already pulled off the socket past the
// end of the current request's body are discarded when it returns. A client
// that writes a second request before reading the first response -- which
// HTTP/1.1 permits -- has that second request's bytes eaten here. The server
// then waits on its next `read` for a request that has already arrived, while
// the client waits for a response that will never come: both sides block
// forever, which is a different and worse claim than "request 2 is ignored".
//
// **`tests/runtime/http_keepalive.nova` does not exercise this case.** Its
// client `await`s each reply before writing the next request, so it never
// pipelines the two requests it sends. That fixture passing is evidence this
// function's ordinary keep-alive path works; it is not evidence the pipelined
// path is safe, and a reader should not conclude otherwise from seeing it
// green.
/// Reads one request from `conn`: its head, then a body of `Content-Length`
/// bytes.
///
/// An `async fn`: it suspends the calling task while it waits for the client,
/// and other tasks run meanwhile. It waits as long as the client takes, so a
/// client that sends nothing keeps it waiting for ever; `std/time`'s
/// `timeout` can bound the wait. On a connection kept open for more requests,
/// call it again for the next one only after answering this one: any bytes
/// it read past this request's body are dropped, so a request that a client
/// sends before reading the response can be lost, and both sides then wait
/// for ever.
///
/// Returns an `HttpError` of kind `Transport` if reading fails or the
/// connection closes before the request is complete, `BodyTooLarge` if
/// `Content-Length` is more than `limits` allows, `BadHeader` if it is not a
/// whole number written in digits, and the kinds `parse_request_head`
/// returns for a malformed head. As there, the head's byte limit counts
/// every byte read so far, which can include the start of the body.
///
/// One request read from a connection and answered, over the loopback
/// address:
///
/// ```
/// async fn serve_one(listener: TcpListener) {
///     let conn = listener.accept().await.unwrap()
///     let req = read_request(conn, Limits::default()).await.unwrap()
///     let reply = Response::text(200, "got ${req.body.len()} bytes")
///     write_response(conn, reply).await.unwrap()
///     conn.close().await.unwrap()
/// }
///
/// async fn main() {
///     let listener = bind("127.0.0.1:0").unwrap()
///     let server = spawn(serve_one(listener))
///     let client = connect("127.0.0.1:${listener.local_port().unwrap()}").await.unwrap()
///     let ask = "POST /upload HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"
///     client.write(bytes_from_string(ask)).await.unwrap()
///     let reply = client.read_to_end().await.unwrap().to_string().unwrap()
///     assert(reply.starts_with("HTTP/1.1 200 OK\r\n"), reply)
///     assert(reply.ends_with("\r\n\r\ngot 5 bytes"), reply)
///     server.join().await
///     listener.close().await.unwrap()
/// }
/// ```
pub async fn read_request(conn: TcpStream, limits: Limits) -> Result<Request, HttpError> {
    let mut buf = bytes_from_string("")
    let mut head: Option<Request> = None
    while head.is_none() {
        let chunk = match conn.read(4096).await {
            Ok(b) => b
            Err(e) => return Err(HttpError { kind: Transport, message: e.message })
        }
        if chunk.len() == 0 {
            return Err(HttpError { kind: Transport, message: "connection closed mid-head" })
        }
        buf = buf.concat(chunk)
        // One arm, not two: `parse_request_head` already returns
        // `Option<Request>`, so the loop assigns it straight through. It is
        // also the form the language permits -- `Ok(Some(r))` is
        // `E0900: nested patterns inside variants are not supported yet`.
        match parse_request_head(buf, limits) {
            Ok(maybe) => head = maybe
            Err(e) => return Err(e)
        }
    }
    let req = match head {
        Some(r) => r
        None => return Err(HttpError { kind: BadRequestLine, message: "no head after parsing" })
    }

    // The head's own length, so the body can be split off what was already
    // read. `parse_offsets` is cheap and the buffer is unchanged, so re-reading
    // `body_start` costs less than threading it out of `parse_request_head`
    // and widening that function's return type for one caller.
    //
    // Indexed straight to the last element with no status check first --
    // safe here specifically because reaching this line already required
    // `parse_request_head(buf, limits)` above to return `Ok(Some(_))` on
    // this same, unmutated `buf`, which happens only at status `0`; see
    // `parse_offsets`'s own doc comment for the check a caller in general
    // must make first.
    let t = parse_offsets(buf)
    let body_start = t[t.len() - 1]

    let want = match content_length_of(req, limits.max_body_bytes) {
        Ok(n) => n
        Err(e) => return Err(e)
    }
    if want > limits.max_body_bytes {
        return Err(HttpError { kind: BodyTooLarge, message: "Content-Length over max_body_bytes" })
    }
    let mut body = buf.slice(body_start, buf.len())
    // **The head's "not worth engineering around" conclusion above does not
    // transfer here.** `max_body_bytes` defaults to 1 MiB, not 8 KiB, and the
    // same per-call-O(n) `concat` accumulation is work amplification on
    // attacker-controlled input at that size, not a rounding error.
    //
    // **Each read below asks for exactly `want - body.len()` bytes, not a
    // fixed chunk size, which changes the common case but not the worst
    // one.** A peer able to deliver the whole remainder in one read now
    // costs this loop exactly one concatenation, regardless of `want` --
    // previously, a fixed 4096-byte ask meant even a peer that had already
    // sent the entire body cost exactly 256 concatenations to drain at the 1
    // MiB default (not "up to" -- with the whole body already available,
    // every read but the last returned the full 4096 bytes asked for), since
    // this loop could only take 4096 bytes at a time regardless of how much
    // more was already there to read. `Read::read` may still legally hand
    // back fewer bytes than asked for on any call, so the worst case is
    // exactly what it was before: a peer that sends the
    // body `k` bytes at a time forces about `want / k` reads and
    // concatenations, and because each concatenation copies everything
    // accumulated so far plus the new chunk, the bytes actually moved are
    // triangular in the read count -- about 134,742,016 bytes copied to
    // assemble a 1,048,576-byte body at 4096 bytes per read (a ~128x
    // amplification), or about 537,395,200 bytes at 1024 bytes per read
    // (~512x). **Both figures are floors, not ceilings**: they hold only if
    // the peer hands back exactly that many bytes on every read, and since
    // `Read::read` may legally return fewer, a slower or more adversarial
    // peer only raises the read count and the bytes copied -- never lowers
    // them. At the worse of the two, that is roughly 230 microseconds in GC
    // allocations alone at this project's own measured ~900 ns each
    // (`docs/superpowers/specs/2026-09-01-std-http-request-parsing-design.md`
    // section 7), against the ~100 microsecond/request budget a 10k req/sec
    // gate implies on a single-threaded executor. Bounded, so not unlimited,
    // but a lever attacker-controlled input can still pull on the worst-case
    // path, recorded here rather than eliminated: no restructuring beyond
    // sizing each read to what is still wanted, and no intrinsic, are part
    // of this change -- that choice is recorded for the whole-branch review.
    //
    // **The `body.len() > limits.max_body_bytes` check this loop used to run
    // on every iteration is gone, not merely untriggered.** It could only
    // ever fire on overshoot -- reading more than `want` bytes in one call,
    // which needed the old fixed 4096-byte ask to happen at all -- and when
    // it did fire on a legitimate request it was a false rejection: with the
    // defaults, any declared length in `(1044481, 1048576]` plus one
    // trailing byte pulled into the same read pushed `body.len()` past
    // `max_body_bytes` while `want` itself was still under it. Reading
    // exactly `want - body.len()` bytes below means `body.len()` can never
    // exceed `want`, and `want` is already checked against
    // `limits.max_body_bytes` above before this loop starts, so the
    // allocation this loop builds is bounded exactly now, not
    // approximately -- there is no overshoot left for that check to catch.
    while body.len() < want {
        let chunk = match conn.read(want - body.len()).await {
            Ok(b) => b
            Err(e) => return Err(HttpError { kind: Transport, message: e.message })
        }
        if chunk.len() == 0 {
            return Err(HttpError { kind: Transport, message: "connection closed mid-body" })
        }
        body = body.concat(chunk)
    }

    Ok(
        Request {
            method: req.method,
            path: req.path,
            headers: req.headers,
            body: body.slice(0, want),
            params: req.params,
        },
    )
}

// `Content-Length`, or `Ok(0)` when the header is absent.
//
// **`Content-Length` is the only body framing v1 understands.** A request
// without one is treated as bodiless; chunked transfer-encoding is out of
// scope and is not detected, so a chunked request's body is left on the
// connection and will be misread as the next request. That is a known
// limitation of v1 rather than a defect to work around here -- it is recorded
// in the design spec's section 10 and in this module's header.
//
// **Returns `Err(BadHeader)` when the header is present but is not a
// non-empty run of decimal digits, rather than defaulting it to `0`.** RFC
// 9112 section 6.3 requires rejecting such a message outright: treating
// `"5x"`, `"abc"` or `""` as `0` would accept the request with an empty body
// while the peer still has the declared bytes queued to send, which desyncs
// the connection exactly like the chunked-encoding and pipelining cases this
// module's own header already documents -- the undelivered bytes sit on the
// socket, and `read_request`'s next call parses them as the start of a new
// request. This was checked once and found NOT to be absorbed downstream:
// `Bytes::slice` clamping a negative bound to `0` (which is what the old,
// silently-defaulting version of this function relied on) only kept a
// negative `want` from corrupting memory safety -- it said nothing about the
// connection-framing consequence above, which is the one that actually
// matters here and is what this function now prevents directly.
//
// `max` is `limits.max_body_bytes`, threaded through to `digits_to_int` so a
// pathologically long digit string cannot wrap its accumulator negative; see
// that function's own doc comment.
fn content_length_of(req: Request, max: Int) -> Result<Int, HttpError> {
    match req.headers.get("content-length") {
        Some(v) => match digits_to_int(v.trim(), max) {
            Some(n) => Ok(n)
            None => Err(
                HttpError {
                    kind: BadHeader,
                    message: "Content-Length is not a valid non-negative integer",
                },
            )
        }
        None => Ok(0)
    }
}

// A non-empty run of decimal digits as an `Int`, or `None` if `s` is empty
// or contains anything else. Nova has no `String`-to-number conversion, so
// this walks the characters.
//
// **Capped at `max`, rather than accumulating without bound.** `Int` wraps
// on overflow (measured elsewhere in this project), so a pathologically
// long digit string could otherwise wrap the accumulator negative. The
// value this returns eventually reaches exactly one comparison against
// `max` itself: `content_length_of` passes it straight through as `want`,
// and `read_request` checks `want > limits.max_body_bytes`, the same `max`
// passed in here. So once the running total exceeds `max` the exact value
// stops mattering, it is already "too large," and returning as soon as
// that is known bounds the accumulator.
//
// **What that bound actually is, since the guarantee is conditional and an
// earlier version of this comment stated it flatly.** Every iteration that
// continues leaves `n <= max`, so the largest value `n` can reach is
// `max * 10 + 9`. That cannot wrap while `max` stays below roughly
// `Int::MAX / 10`. At the default `max_body_bytes` of 1 MiB the accumulator
// tops out around ten million, so the margin is enormous -- but the
// condition is on `max`, not on this function, and `max_body_bytes` is the
// one ceiling here with no backstop underneath it: the runtime hard-walls
// `max_head_bytes` and `max_header_count` before allocating, and never sees
// the body at all. A caller passing a `max_body_bytes` near `Int::MAX`
// would wrap this accumulator, and nothing clamps it. That value is
// absurd -- hundreds of petabytes -- which is why this is a scoping note
// rather than a check.
//
// This is narrower than a general overflow check, and is sufficient only
// because of that comparison-only usage; it is not a general-purpose
// decimal parser. One consequence of stopping early: a value
// that is both longer than `max` warrants and would eventually prove
// invalid past that point (digits followed by a stray non-digit) is
// reported as a valid, too-large number rather than a malformed one, since
// scanning stops the moment the running total is confirmed to exceed `max`
// and the remaining characters are never inspected. The caller rejects the
// request either way -- as `BodyTooLarge` instead of `BadHeader` in that one
// edge case -- so this does not change whether the request is accepted.
fn digits_to_int(s: String, max: Int) -> Option<Int> {
    let cs = s.chars()
    if cs.len() == 0 { return None }
    let mut n = 0
    let mut i = 0
    while i < cs.len() {
        let d = char_digit(cs[i])
        if d < 0 { return None }
        n = n * 10 + d
        if n > max { return Some(n) }
        i = i + 1
    }
    Some(n)
}

fn char_digit(c: Char) -> Int {
    if c == '0' { return 0 }
    if c == '1' { return 1 }
    if c == '2' { return 2 }
    if c == '3' { return 3 }
    if c == '4' { return 4 }
    if c == '5' { return 5 }
    if c == '6' { return 6 }
    if c == '7' { return 7 }
    if c == '8' { return 8 }
    if c == '9' { return 9 }
    0 - 1
}

// Write `resp` to `conn`, looping until every byte is out.
//
// **`std/net`'s `write` is one non-blocking attempt, not a `write_all`**, and
// it returns the count it managed -- so a caller that ignored the count would
// silently truncate a response under back-pressure. Returns the total written,
// which equals the response's length on success.
/// Writes all of `resp` to `conn`, laid out as `to_bytes` lays it out, and
/// returns the number of bytes written.
///
/// An `async fn`: it suspends the calling task while the connection has no
/// room for more, and other tasks run meanwhile. Returns the `IoError` a
/// write fails with, or one of kind `Other` if a write makes no progress.
pub async fn write_response(conn: TcpStream, resp: Response) -> Result<Int, IoError> {
    let wire = resp.to_bytes()
    let total = wire.len()
    let mut sent = 0
    while sent < total {
        let n = match conn.write(wire.slice(sent, total)).await {
            Ok(n) => n
            Err(e) => return Err(e)
        }
        if n <= 0 { return Err(IoError { kind: Other, message: "write made no progress" }) }
        sent = sent + n
    }
    Ok(total)
}

// ---------------------------------------------------------------------------
// The router: `Server`.
//
// Written in Nova over the pieces above. Handlers are `fn(Request) ->
// Response` values -- this module's header says why not section 6's
// `Handler` alias -- so a handler is synchronous: it builds its response
// without awaiting.

// How often `Server::listen` and every connection it serves look at the
// shutdown flag, in milliseconds. A signal is noticed within one tick.
const SERVER_TICK_MS: Int = 100

// How long one request may take, in milliseconds: from the moment `serve`
// takes it up until its response has been written. A stalled client is
// dropped at this deadline, so a shutdown always finishes.
const SERVER_REQUEST_MS: Int = 10000

// A routing table, and the handler of a `GET` no route matches. Build one
// with `Server::new()`, a route method for each route, and `fallback`, then
// `listen` or `listen_on`. Routes by method, patterns, `405` and `params`
// are spec docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md
// §3.1.
/// A router that serves HTTP/1.1, sending each request to a handler by its
/// method and path.
///
/// Build one with `Server::new()` and a call to `get`, `post`, `put`,
/// `delete` or `route` for each route, and `fallback` for the `GET`s no route
/// matches, then serve it with `listen`, or `listen_on` a listener already
/// bound. `dispatch` says which handler answers a request.
pub record Server { routes: Vec<Route>, unmatched: Option<fn(Request) -> Response> }

// One route: the method it answers, its pattern's pieces, as `path_pieces`
// splits it once when the route is added, and its handler.
record Route { method: Method, pattern: [String], handler: fn(Request) -> Response }

// A request read off a connection, and the bytes that followed it: a
// pipelined next request, or the start of one.
record InFlight { req: Request, rest: Bytes }

impl Server {
    /// Returns a server with no routes and no fallback.
    pub fn new() -> Server { Server { routes: Vec::new(), unmatched: None } }

    // Adds a GET route. Takes `self` rather than `mut self`, and returns
    // `Server` rather than section 6's `Self`: a `mut self` call on the
    // temporary `Server::new()` returns is `E0060`, and `Self` as a type in an
    // impl block is `E0001`. Before 4.7 it matched the whole target, query
    // included; it takes a pattern now, as every route does (spec §12,
    // decision 1).
    /// Returns a copy of this server with one more route: `GET` requests
    /// whose path matches `pattern` go to `handler`. It is
    /// `route(Get, pattern, handler)`, which says how a pattern matches.
    ///
    /// `self` is left unchanged, so calls chain, as in
    /// `Server::new().get("/", home).get("/posts/:id", post)`. The query
    /// takes no part: `/add` matches `/add?x=1`, and so does `/add/`.
    ///
    /// ```
    /// let app = Server::new()
    ///     .get("/", |_| Response::text(200, "home"))
    ///     .get("/posts/:id", |r: Request| Response::text(200, "post ${r.params.get("id").unwrap()}"))
    /// let get = |target: String| parse_request_head(
    ///     bytes_from_string("GET ${target} HTTP/1.1\r\n\r\n"),
    ///     Limits::default(),
    /// ).unwrap().unwrap()
    /// assert_eq(app.dispatch(get("/?ref=mail")).body.to_string().unwrap(), "home")
    /// assert_eq(app.dispatch(get("/posts/a%20b/")).body.to_string().unwrap(), "post a b")
    /// assert_eq(app.dispatch(get("/posts/7/edit")).status, 404)
    /// ```
    pub fn get(self, pattern: String, handler: fn(Request) -> Response) -> Server {
        self.route(Get, pattern, handler)
    }

    /// Returns a copy of this server with one more route: `POST` requests
    /// whose path matches `pattern` go to `handler`. It is
    /// `route(Post, pattern, handler)`, which says how a pattern matches.
    ///
    /// ```
    /// let app = Server::new()
    ///     .get("/posts/:id", |_| Response::html(200, "<form method=post>…</form>"))
    ///     .post("/posts/:id", |r: Request| Response::redirect("/posts/${r.params.get("id").unwrap()}"))
    /// let raw = bytes_from_string("POST /posts/7 HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
    /// let saved = app.dispatch(parse_request_head(raw, Limits::default()).unwrap().unwrap())
    /// assert_eq(saved.status, 303)
    /// assert_eq(saved.headers.get("location").unwrap(), "/posts/7")
    /// ```
    pub fn post(self, pattern: String, handler: fn(Request) -> Response) -> Server {
        self.route(Post, pattern, handler)
    }

    /// Returns a copy of this server with one more route: `PUT` requests
    /// whose path matches `pattern` go to `handler`. It is
    /// `route(Put, pattern, handler)`, which says how a pattern matches.
    ///
    /// ```
    /// let app = Server::new().put("/notes/:name", |r: Request| Response::text(200, "stored ${r.body.len()} bytes"))
    /// let raw = bytes_from_string("PUT /notes/todo HTTP/1.1\r\n\r\n")
    /// let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
    /// assert_eq(app.dispatch(req).body.to_string().unwrap(), "stored 0 bytes")
    /// ```
    pub fn put(self, pattern: String, handler: fn(Request) -> Response) -> Server {
        self.route(Put, pattern, handler)
    }

    /// Returns a copy of this server with one more route: `DELETE` requests
    /// whose path matches `pattern` go to `handler`. It is
    /// `route(Delete, pattern, handler)`, which says how a pattern matches.
    ///
    /// ```
    /// let app = Server::new().delete("/notes/:name", |_| Response::text(204, ""))
    /// let raw = bytes_from_string("DELETE /notes/todo HTTP/1.1\r\n\r\n")
    /// let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
    /// assert_eq(app.dispatch(req).status, 204)
    /// ```
    pub fn delete(self, pattern: String, handler: fn(Request) -> Response) -> Server {
        self.route(Delete, pattern, handler)
    }

    // Adds a route. The new server gets a copy of the route table, and
    // `self` is left alone. A `Vec` is shared, not copied, on assignment, so
    // pushing onto `self.routes` would add the route to every server built
    // from the same base as well.
    /// Returns a copy of this server with one more route: requests whose
    /// method is `method` and whose path matches `pattern` go to `handler`.
    ///
    /// `self` is left unchanged, so calls chain. A request's path is its
    /// target before any `?`, split at each `/`, with the empty pieces
    /// dropped and each piece percent-decoded, as `std/ui/router` reads a
    /// location; a piece that does not decode, one with a `%` not followed by
    /// two hex digits say, is kept as written. `pattern` is split the same
    /// way, and each of its pieces is literal, matching a piece equal to it,
    /// or `:name`, matching any one piece, which the handler finds in
    /// `req.params` under `name`. A pattern matches a path with as many
    /// pieces, each matching: `/posts/:id` matches `/posts/7`, `/posts/7/`
    /// and `/posts/7?x=1`, with `id` set to `7`, but not `/posts` or
    /// `/posts/7/edit`; and `/` matches only `/`. A method matches only
    /// itself, as the request writes it: `Unknown("PURGE")` matches `PURGE`.
    /// `dispatch` says which of several matching routes answers.
    ///
    /// ```
    /// let app = Server::new().route(Patch, "/notes/:name", |r: Request| Response::text(200, "patched ${r.params.get("name").unwrap()}"))
    /// let raw = bytes_from_string("PATCH /notes/to%2Fdo HTTP/1.1\r\n\r\n")
    /// let req = parse_request_head(raw, Limits::default()).unwrap().unwrap()
    /// assert_eq(app.dispatch(req).body.to_string().unwrap(), "patched to/do")
    /// ```
    pub fn route(
        self,
        method: Method,
        pattern: String,
        handler: fn(Request) -> Response,
    ) -> Server {
        let mut rs: Vec<Route> = Vec::new()
        let mut i = 0
        while i < self.routes.len() {
            match self.routes.get(i) {
                Some(r) => rs.push(r)
                None => {}
            }
            i = i + 1
        }
        rs.push(Route { method: method, pattern: path_pieces(pattern), handler: handler })
        Server { routes: rs, unmatched: self.unmatched }
    }

    // Sets the fallback. Like `route`, it takes `self` and returns a new
    // server, so `self` keeps its own; the route table is shared between the
    // two, which is safe since `route` copies it before it adds a route.
    /// Returns a copy of this server whose `handler` answers each `GET`
    /// request no route matches, in place of `Response::not_found()`.
    ///
    /// `self` is left unchanged, and calls chain with the route methods in
    /// any order: a route still answers its own path. A second `fallback`
    /// replaces the first. It never answers any method but `GET`, and a
    /// `GET` of a path a route matches with another method gets `405`, as
    /// `dispatch` says. The request it gets has no `params`.
    ///
    /// ```
    /// let app = Server::new()
    ///     .get("/", |_| Response::text(200, "home"))
    ///     .fallback(|r: Request| Response::text(404, "no page at ${r.path}"))
    /// let get = |path: String| Request {
    ///     method: Get,
    ///     path: path,
    ///     headers: Map::new(),
    ///     body: bytes_from_string(""),
    ///     params: Map::new(),
    /// }
    /// assert_eq(app.dispatch(get("/")).body.to_string().unwrap(), "home")
    /// let missing = app.dispatch(get("/nope?x=1"))
    /// assert_eq(missing.status, 404)
    /// assert_eq(missing.body.to_string().unwrap(), "no page at /nope?x=1")
    /// ```
    pub fn fallback(self, handler: fn(Request) -> Response) -> Server {
        Server { routes: self.routes, unmatched: Some(handler) }
    }

    // The response to `req`, by spec §3.1's dispatch: the first route whose
    // method and pattern match, else `405` naming the methods of the routes
    // whose pattern matches, else the fallback's for a GET, else
    // `Response::not_found()`. Socket-free, so a test can call it directly.
    /// Returns the response to `req`.
    ///
    /// The routes are tried in the order they were added, and the first
    /// whose method and pattern both match `req` answers: its handler gets
    /// `req` with `params` holding what the pattern took. Otherwise, when a
    /// route's pattern matches but its method does not, the answer is
    /// `405 Method Not Allowed`, with an `allow` header naming the methods of
    /// the routes whose pattern matches, each once, in the order they were
    /// added, as `GET, POST`. Otherwise a `GET` goes to the `fallback`
    /// handler, when there is one, and any other request gets
    /// `Response::not_found()`. `HEAD` is a method like any other, answered
    /// only by a route added for it.
    ///
    /// It touches no connection, so a test can call it directly with a
    /// `Request` it builds.
    ///
    /// ```
    /// let app = Server::new()
    ///     .get("/login", |_| Response::html(200, "<form>…</form>"))
    ///     .post("/login", |_| Response::redirect("/admin"))
    /// let raw = bytes_from_string("DELETE /login HTTP/1.1\r\n\r\n")
    /// let refused = app.dispatch(parse_request_head(raw, Limits::default()).unwrap().unwrap())
    /// assert_eq(refused.status, 405)
    /// assert_eq(refused.headers.get("allow").unwrap(), "GET, POST")
    /// ```
    pub fn dispatch(self, req: Request) -> Response {
        let target = req.path
        let path = match target.index_of("?") {
            Some(at) => target.slice(0, at)
            None => target
        }
        let pieces = path_pieces(path)
        let mut allowed: Vec<String> = Vec::new()
        let mut i = 0
        while i < self.routes.len() {
            match self.routes.get(i) {
                Some(r) => {
                    match params_of(r.pattern, pieces) {
                        Some(params) => {
                            let name = method_name(r.method)
                            if name == method_name(req.method) {
                                // Bound to a local first: calling a fn-typed
                                // field directly, `r.handler(req)`, is `E0014`.
                                let h = r.handler
                                return h(
                                    Request {
                                        method: req.method,
                                        path: req.path,
                                        headers: req.headers,
                                        body: req.body,
                                        params: params,
                                    },
                                )
                            }
                            if !holds(allowed, name) { allowed.push(name) }
                        }
                        None => {}
                    }
                }
                None => {}
            }
            i = i + 1
        }
        if allowed.len() > 0 {
            let mut names = [""; allowed.len()]
            let mut k = 0
            while k < allowed.len() {
                names[k] = allowed.get(k).unwrap_or("")
                k = k + 1
            }
            let mut refused = Response::text(405, "method not allowed")
            refused.headers.insert("allow", ", ".join(names))
            return refused
        }
        match req.method {
            Get => {
                match self.unmatched {
                    Some(h) => h(req)
                    None => Response::not_found()
                }
            }
            _ => Response::not_found()
        }
    }

    // Serves `addr` until the process is asked to stop: SIGTERM or SIGINT on
    // Unix, Ctrl+Break or Ctrl+C on Windows.
    //
    // **Graceful.** On the first such signal it stops accepting within one
    // tick, closes the listener, and returns `Ok(())`. Connections are not
    // touched: each finishes the request it has started, and any pipelined
    // request that has already arrived whole, within that request's deadline,
    // then closes; an idle one closes at its next tick. A second signal ends
    // the process at once, by the signal's default action.
    //
    // **It returns before those connections finish.** Their tasks run on
    // alongside any code after `.await`, and the process exits only once
    // `block_on`'s implicit join has finished them
    // (docs/adr/0009-async-execution-model.md).
    //
    // **The signal handler is installed by the first `listen`, before `bind`,
    // and stays installed for the rest of the process.** So a client that can
    // connect can also stop the server gracefully. But a program that recovers
    // from this function's `Err` and keeps running swallows its next signal,
    // and only a second one ends it; docs/adr/0022-process-shutdown-signals.md
    // records why.
    //
    // **Errors.** A failed `bind` or `accept` returns `Err`. An accept error
    // closes the listener first and leaves the connections running; the flag
    // is not set, so they keep being served.
    /// Serves HTTP on `addr`, a `"host:port"` string such as
    /// `"127.0.0.1:8080"`, until the process is asked to stop.
    ///
    /// An `async fn`: it suspends the calling task while it waits for
    /// connections, and serves each connection in a task of its own. A
    /// handler that panics ends the whole program.
    ///
    /// A connection stays open for more requests until the client closes it,
    /// and they are answered in order, including requests sent before the
    /// previous response arrived; a `Connection: close` header does not close
    /// it. Requests are limited as `Limits::default()` says. A malformed or
    /// oversized request, or one not read and answered within 10 seconds of
    /// the server starting on it, closes its connection without a response.
    /// No `100 Continue` is ever sent.
    ///
    /// On SIGTERM or SIGINT (Ctrl+C or Ctrl+Break on Windows) it stops
    /// accepting within about a tenth of a second, and returns `Ok(())`.
    /// Connections already open are not cut off: each finishes the request it
    /// has started, and any further request that has already arrived whole,
    /// then closes; an idle one closes within about a tenth of a second. The
    /// program does not end until they have, and a second signal ends it at
    /// once. Once `listen` has run, the program goes on catching those
    /// signals, even after `listen` returns an `Err`: a program that carries
    /// on after that is not ended by the next signal, only by a second.
    ///
    /// Returns an `IoError` if `addr` cannot be bound, as when it is already
    /// in use, or if accepting a connection fails. After a failed accept the
    /// connections already open go on being served.
    pub async fn listen(self, addr: String) -> Result<(), IoError> {
        let _ = shutdown_requested()
        let l = match bind(addr) {
            Ok(l) => l
            Err(e) => return Err(e)
        }
        self.listen_on(l).await
    }

    // `listen`'s loop, on a listener the caller bound: so a program can bind
    // port 0 and print the port it got, then serve it (spec
    // docs/superpowers/specs/2026-10-19-phase-4-6-ssr-hydration-and-ssg-design.md
    // §8.3). `listen` binds, then calls it. The signal handler is installed
    // here too, for a caller that did not install it before its own `bind`;
    // a second install is a no-op.
    /// Serves HTTP on `listener`, already bound with `std/net`'s `bind`, until
    /// the process is asked to stop, as `listen` does on the address it binds.
    ///
    /// A program binds first when it must know the address before serving,
    /// such as the port the system chose for port 0, which `local_port`
    /// reads. Everything else is as `listen` says: the connections, the
    /// limits, the stop on SIGTERM or SIGINT, after which the listener is
    /// closed and it returns `Ok(())`, and an `IoError` if accepting a
    /// connection fails. A signal that arrives between the `bind` and this
    /// call ends the program, unless something has already called `listen`
    /// or `listen_on`.
    pub async fn listen_on(self, l: TcpListener) -> Result<(), IoError> {
        let _ = shutdown_requested()
        // The flag is checked on every turn, not only when an accept times
        // out: under steady traffic the timeout arm may never run. The accept
        // is polled under `timeout` because a bare one never returns without a
        // connection, and closing the listener under it does not wake it.
        while !shutdown_requested() {
            match timeout(Duration::from_millis(SERVER_TICK_MS), l.accept()).await {
                Ok(r) => {
                    match r {
                        Ok(conn) => { let _ = spawn(serve(self, conn)) }
                        Err(e) => {
                            let _ = l.close().await
                            return Err(e)
                        }
                    }
                }
                Err(_) => {}
            }
        }
        let _ = l.close().await
        Ok(())
    }
}

// One connection, for its whole life, with one buffer it keeps throughout.
//
// - **Idle (buffer empty):** waits for a request's first bytes one tick at a
//   time. EOF closes; a timeout closes once the shutdown flag is set and
//   otherwise keeps waiting.
// - **In flight (buffer not empty):** a request is taken up -- its deadline
//   starts now -- read to completion by `read_in_flight`, and answered. The
//   response is written under the same deadline, so a peer that stops
//   reading cannot hold the connection forever either. A request taken up
//   after a stop gets no further reads: it is answered only if it has already
//   arrived whole, so a peer that keeps sending cannot hold the connection
//   open either.
// - **After an answer:** bytes left in the buffer are the next request,
//   answered even after a stop if they hold all of it. With the buffer
//   empty, the connection closes if the flag is set and goes idle otherwise.
//
// Anything else that goes wrong -- EOF mid-request, a read or write error, a
// malformed head, an oversized body, a deadline passing -- closes this
// connection without a response, and touches no other.
async fn serve(s: Server, conn: TcpStream) {
    let mut buf = bytes_from_string("")
    let mut open = true
    while open {
        if buf.len() == 0 {
            match conn.read_timeout(4096, SERVER_TICK_MS).await {
                Ok(chunk) => { if chunk.len() == 0 { open = false } else { buf = chunk } }
                Err(e) => {
                    match e.kind {
                        TimedOut => { if shutdown_requested() { open = false } }
                        _ => open = false
                    }
                }
            }
        } else {
            let started = Instant::now()
            let may_read = !shutdown_requested()
            match read_in_flight(conn, buf, started, may_read).await {
                Some(f) => {
                    buf = f.rest
                    let left = SERVER_REQUEST_MS - started.elapsed().as_millis()
                    match timeout(
                        Duration::from_millis(left),
                        write_response(conn, s.dispatch(f.req)),
                    ).await {
                        Ok(w) => {
                            match w {
                                Ok(n) => {
                                    if buf.len() == 0 && shutdown_requested() { open = false }
                                }
                                Err(e) => open = false
                            }
                        }
                        Err(_) => open = false
                    }
                }
                None => open = false
            }
        }
    }
    let _ = conn.close().await
}

// The request at the front of `first`, reading more from `conn` as needed, or
// `None` to close the connection. The head is parsed from at most
// `max_head_bytes` of the buffer, so bytes buffered behind it -- a body, or a
// pipelined request -- never count against the head's own limit. With
// `may_read` false, for a request taken up after a stop, nothing more is
// read, and a request not already whole in `first` is `None`.
async fn read_in_flight(
    conn: TcpStream,
    first: Bytes,
    started: Instant,
    may_read: Bool,
) -> Option<InFlight> {
    let limits = Limits::default()
    let mut buf = first
    let mut head: Option<Request> = None
    while head.is_none() {
        let window = head_window(buf, limits.max_head_bytes)
        match parse_request_head(window, limits) {
            Ok(maybe) => head = maybe
            Err(_) => return None
        }
        if head.is_none() {
            // A head still incomplete at `max_head_bytes` never will be.
            if window.len() >= limits.max_head_bytes { return None }
            if !may_read { return None }
            match read_more(conn, 4096, started).await {
                Some(chunk) => buf = buf.concat(chunk)
                None => return None
            }
        }
    }
    let req = match head {
        Some(r) => r
        None => return None
    }
    // `parse_request_head` returned `Ok(Some(_))` on this same window, so its
    // offset table has status 0 and its last element is where the body starts.
    let t = parse_offsets(head_window(buf, limits.max_head_bytes))
    let body_start = t[t.len() - 1]
    let want = match content_length_of(req, limits.max_body_bytes) {
        Ok(n) => n
        Err(_) => return None
    }
    if want > limits.max_body_bytes { return None }
    let end = body_start + want
    while buf.len() < end {
        if !may_read { return None }
        match read_more(conn, end - buf.len(), started).await {
            Some(chunk) => buf = buf.concat(chunk)
            None => return None
        }
    }
    Some(
        InFlight {
            req: Request {
                method: req.method,
                path: req.path,
                headers: req.headers,
                body: buf.slice(body_start, end),
                params: req.params,
            },
            rest: buf.slice(end, buf.len()),
        },
    )
}

// Up to `max` more bytes for the request taken up at `started`, or `None` at
// EOF, on a read error, or once that request's deadline has passed.
async fn read_more(conn: TcpStream, max: Int, started: Instant) -> Option<Bytes> {
    let left = SERVER_REQUEST_MS - started.elapsed().as_millis()
    if left <= 0 { return None }
    match conn.read_timeout(max, left).await {
        Ok(chunk) => {
            if chunk.len() == 0 { return None }
            Some(chunk)
        }
        Err(_) => None
    }
}

// The first `max` bytes of `buf`, or all of it if it is shorter.
fn head_window(buf: Bytes, max: Int) -> Bytes {
    if buf.len() <= max { return buf }
    buf.slice(0, max)
}

// The parameters `pattern`, a route's pieces, takes from `pieces`, a
// request path's, or `None` when it does not match them: `std/ui/router`'s
// `params_of`, less its catch-all, which a server's pattern does not have
// (spec §3.1).
fn params_of(pattern: [String], pieces: [String]) -> Option<Map<String, String>> {
    if pattern.len() != pieces.len() { return None }
    let mut params: Map<String, String> = Map::new()
    let mut i = 0
    while i < pattern.len() {
        let p = pattern[i]
        if p.starts_with(":") {
            let _ = params.insert(p.slice(1, p.len()), pieces[i])
        } else if p != pieces[i] {
            return None
        }
        i = i + 1
    }
    Some(params)
}

// `m` as a request line writes it, which is how two methods are compared and
// how `allow` names one: `Method` has no `Eq`.
fn method_name(m: Method) -> String {
    match m {
        Get => "GET"
        Post => "POST"
        Put => "PUT"
        Delete => "DELETE"
        Patch => "PATCH"
        Head => "HEAD"
        Options => "OPTIONS"
        Unknown(name) => name
    }
}

// Whether `names` holds `name`.
fn holds(names: Vec<String>, name: String) -> Bool {
    let mut i = 0
    while i < names.len() {
        if names.get(i).unwrap_or("") == name { return true }
        i = i + 1
    }
    false
}
