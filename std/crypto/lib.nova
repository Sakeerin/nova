//! Hashes, message authentication codes and secure random values.
//!
//! `sha256` and `sha512` hash `Bytes`, `hmac_sha256` computes an HMAC-SHA-256
//! tag, and `hmac_sha256_verify` checks one. `pbkdf2_sha256` derives a key
//! from a password, for storing a password's hash, and
//! `pbkdf2_sha256_verify` checks a password against one. `random_bytes` and
//! `random_int` draw from the operating system's cryptographically secure
//! random source. Hashes and tags are raw `Bytes`: `Bytes::to_hex` writes
//! them as hex. Every module sees these names without an import, and a
//! module's own definition of one of them shadows the one here.
//!
//! There is no encryption, no hash other than SHA-256 and SHA-512, and no way
//! to hash input that arrives in pieces: each function takes all of its
//! input in one `Bytes`.
//!
//! Hashing bytes, tagging a message with HMAC and checking the tag, and
//! drawing random values:
//!
//! ```
//! let digest = sha256(bytes_from_string("abc"))
//! assert_eq(digest.len(), 32) // raw bytes, not hex
//! assert_eq(digest.byte_at(0).unwrap(), 0xba) // SHA-256("abc") is ba7816bf…
//!
//! // An HMAC tag proves a message came from someone holding the key.
//! let key = bytes_from_string("secret key")
//! let msg = bytes_from_string("amount=10")
//! let tag = hmac_sha256(key, msg)
//! assert(hmac_sha256_verify(key, msg, tag), "the tag matches its message")
//! assert(
//!     !hmac_sha256_verify(key, bytes_from_string("amount=99"), tag),
//!     "a changed message does not",
//! )
//!
//! let roll = random_int(1, 6).unwrap()
//! assert(roll >= 1 && roll <= 6, "both ends are included")
//! assert_eq(random_bytes(16).unwrap().len(), 16)
//! ```

// `std/crypto`: hashes, HMAC, PBKDF2 and random, over five runtime
// intrinsics.
//
// **Digest lengths are documented, not typed.** `nova-spec/20-STDLIB.md`
// section 8 declares these as `[u8; 32]` and `[u8; 64]`; neither is
// writable, because `u8` does not name a type and a fixed-length array type
// does not parse. So a digest is a `Bytes` whose length is stated in a
// comment, and nothing can force a caller to hold exactly 32 bytes.
//
// **What this module does not provide:** BLAKE3, which the `ring` backing
// this module does not implement; AEAD; and any streaming or incremental
// hasher, so a caller with more data than fits in one `Bytes` has no route
// here.

/// Why `random_bytes` or `random_int` failed.
pub type CryptoErrorKind =
    /// The operating system's random source failed.
    | EntropyUnavailable
    /// `random_bytes` was asked for a negative number of bytes.
    | InvalidLength
    /// `random_bytes` was asked for more than 65,536 bytes.
    | RequestTooLarge
    /// `random_int` was given a `min` greater than its `max`.
    | InvalidRange

/// The error `random_bytes` and `random_int` return.
pub record CryptoError {
    /// Why the call failed.
    pub kind: CryptoErrorKind,
    /// A short message naming the function that failed, such as
    /// `random_bytes failed`; `kind` says why.
    pub message: String,
}

// These four values are duplicated in `crates/nova-runtime/src/crypto.rs`.
// Nothing ties the two sides together, so the fixtures assert a known vector
// per operation: swapping two of these must fail a fixture.
const OP_SHA256: Int = 0

const OP_SHA512: Int = 1

const OP_HMAC_SHA256: Int = 2

const OP_HMAC_SHA256_VERIFY: Int = 3

// The `1 => EntropyUnavailable` arm below is not exercised by any test in
// this project: it is reachable only when the OS entropy source itself
// fails, and no fixture or Rust unit test can force that failure without
// breaking the entropy source out from under the whole runtime, so the gap
// is disclosed here rather than covered.
fn crypto_error_kind_of(status: Int) -> CryptoErrorKind {
    match 0 - status {
        1 => EntropyUnavailable
        2 => InvalidLength
        3 => RequestTooLarge
        4 => InvalidRange
        // `Int` cannot be matched exhaustively, so a wildcard arm must
        // exist. It is unreachable for the kinds
        // `crates/nova-runtime/src/crypto.rs` currently defines, and exists
        // so that set can grow without this function failing to compile.
        _ => InvalidRange
    }
}

fn no_bytes() -> Bytes { bytes_from_ints([]) }

// SHA-256 of `data`, 32 bytes.
//
// Infallible: the intrinsic's status is always 0 for this operation, because
// no input this surface can produce makes a digest fail.
/// Returns the SHA-256 hash of `data`, as 32 raw bytes.
///
/// Any `Bytes` is accepted, empty included, and it cannot fail.
pub fn sha256(data: Bytes) -> Bytes {
    let _ = crypto_hash(OP_SHA256, no_bytes(), data, no_bytes())
    fs_take_bytes()
}

// SHA-512 of `data`, 64 bytes. Infallible, for the reason `sha256` gives.
/// Returns the SHA-512 hash of `data`, as 64 raw bytes.
///
/// Any `Bytes` is accepted, empty included, and it cannot fail.
pub fn sha512(data: Bytes) -> Bytes {
    let _ = crypto_hash(OP_SHA512, no_bytes(), data, no_bytes())
    fs_take_bytes()
}

// HMAC-SHA-256 of `data` under `key`, 32 bytes. Infallible.
/// Returns the HMAC-SHA-256 tag of `data` under `key`, as 32 raw bytes.
///
/// `key` may be any length, empty included, and it cannot fail. To check a
/// tag a message arrived with, use `hmac_sha256_verify` rather than comparing
/// it with this function's result yourself.
pub fn hmac_sha256(key: Bytes, data: Bytes) -> Bytes {
    let _ = crypto_hash(OP_HMAC_SHA256, key, data, no_bytes())
    fs_take_bytes()
}

// Whether `tag` is the HMAC-SHA-256 of `data` under `key`.
//
// **Constant-time, and that property is INHERITED from `ring::hmac::verify`
// rather than demonstrated here.** No test in this project observes timing.
// Prefer this over comparing tags yourself: `Bytes::eq` is available and
// exact, but it is not constant-time -- it returns early on a length
// mismatch and then calls `memcmp` -- so a hand-written check leaks.
/// Returns `true` if `tag` is the HMAC-SHA-256 tag of `data` under `key`.
///
/// A `tag` of the wrong length gives `false`, not an error. The comparison
/// is made in constant time, so how long it takes does not reveal how much of
/// a wrong `tag` matched; comparing tags with `Bytes`'s `eq` gives no such
/// guarantee.
pub fn hmac_sha256_verify(key: Bytes, data: Bytes, tag: Bytes) -> Bool {
    crypto_hash(OP_HMAC_SHA256_VERIFY, key, data, tag) == 0
}

// PBKDF2-HMAC-SHA-256 (spec
// docs/superpowers/specs/2026-10-21-phase-4-7-fullstack-blog-design.md §5),
// over `ring::pbkdf2`: written in Nova it ran about 0.84 s per 100,000
// iterations, during which a single-threaded server answers nothing. The
// runtime checks the iteration count and the length, and returns these two
// statuses, which `crates/nova-runtime/src/crypto.rs` defines as well; each
// is a caller's error, so a panic, as `bytes_from_ints` panics on a value
// out of range, rather than a `CryptoError` every call would have to unwrap.
const PBKDF2_BAD_ITERATIONS: Int = -5

const PBKDF2_BAD_LENGTH: Int = -6

// The panics both functions share, for the statuses above.
fn pbkdf2_refused(name: String, status: Int, iterations: Int, length: Int) {
    if status == PBKDF2_BAD_ITERATIONS {
        panic("${name}: iterations must be from 1 to 4294967295, not ${iterations}")
    }
    if status == PBKDF2_BAD_LENGTH {
        panic("${name}: length must be from 1 to 65536, not ${length}")
    }
    panic("${name}: the runtime refused it with status ${status}")
}

/// Returns the key of `length` bytes that PBKDF2-HMAC-SHA-256 (RFC 8018)
/// derives from `password` and `salt` over `iterations` rounds.
///
/// It is made for storing a password: keep the key, the salt, which should
/// be random and differ from one password to the next, as from
/// `random_bytes(16)`, and the count, and check a password later with
/// `pbkdf2_sha256_verify`. Each round makes the key costlier to guess:
/// OWASP recommends 600,000 for a password. It runs on the calling task for
/// as long as the count says, and every other task waits.
///
/// Panics when `iterations` is below 1 or above 4,294,967,295, with
/// `pbkdf2_sha256: iterations must be from 1 to 4294967295, not <n>`, and
/// when `length` is below 1 or above 65,536, with
/// `pbkdf2_sha256: length must be from 1 to 65536, not <n>`.
///
/// ```
/// // RFC 7914's first PBKDF2-HMAC-SHA-256 vector, its first 32 bytes.
/// let key = pbkdf2_sha256(bytes_from_string("passwd"), bytes_from_string("salt"), 1, 32)
/// assert_eq(key.to_hex(), "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc")
/// ```
pub fn pbkdf2_sha256(password: Bytes, salt: Bytes, iterations: Int, length: Int) -> Bytes {
    let status = crypto_pbkdf2_sha256(password, salt, iterations, length)
    if status != 0 { pbkdf2_refused("pbkdf2_sha256", status, iterations, length) }
    fs_take_bytes()
}

// Constant-time, and that property is INHERITED from `ring::pbkdf2::verify`
// rather than demonstrated here, as `hmac_sha256_verify`'s is.
/// Returns `true` if `expected` is the key PBKDF2-HMAC-SHA-256 derives from
/// `password` and `salt` over `iterations` rounds, of `expected`'s own
/// length, as `pbkdf2_sha256` derives it.
///
/// The comparison is made in constant time, as `ring`'s is, so how long it
/// takes does not reveal how much of a wrong key matched. An empty
/// `expected` gives `false`. A shorter key is the start of a longer one, so
/// the start of the right key gives `true` too: keep and check the whole
/// key, and its length.
///
/// Panics when `iterations` is below 1 or above 4,294,967,295, with
/// `pbkdf2_sha256_verify: iterations must be from 1 to 4294967295, not <n>`.
///
/// ```
/// let salt = random_bytes(16).unwrap()
/// let stored = pbkdf2_sha256(bytes_from_string("correct horse"), salt, 1000, 32)
/// assert(pbkdf2_sha256_verify(bytes_from_string("correct horse"), salt, 1000, stored), "the password")
/// assert(!pbkdf2_sha256_verify(bytes_from_string("wrong horse"), salt, 1000, stored), "another")
/// ```
pub fn pbkdf2_sha256_verify(
    password: Bytes,
    salt: Bytes,
    iterations: Int,
    expected: Bytes,
) -> Bool {
    let status = crypto_pbkdf2_sha256_verify(password, salt, iterations, expected)
    if status < 0 { pbkdf2_refused("pbkdf2_sha256_verify", status, iterations, expected.len()) }
    status == 0
}

// `n` cryptographically random bytes.
//
// Fallible where section 8 declared it infallible: the OS entropy source can
// fail, `n` can be negative or above the runtime's cap, and no panic may
// cross a generated poll boundary, so the alternative to a `Result` is
// ending the process.
/// Returns `n` cryptographically secure random bytes from the operating
/// system.
///
/// An `n` of 0 gives empty `Bytes`. Returns a `CryptoError` of kind
/// `InvalidLength` if `n` is negative, `RequestTooLarge` if `n` is more than
/// 65,536, and `EntropyUnavailable` if the operating system's random source
/// fails.
pub fn random_bytes(n: Int) -> Result<Bytes, CryptoError> {
    let status = crypto_random_bytes(n)
    if status == 0 { return Ok(fs_take_bytes()) }
    Err(CryptoError { kind: crypto_error_kind_of(status), message: "random_bytes failed" })
}

// A uniform integer in `min ..= max`.
//
// `min == max` is a valid degenerate range and returns `min`; a range with
// `min` above `max` is `InvalidRange`.
/// Returns a random `Int` from `min` to `max`, both included, each value as
/// likely as any other.
///
/// It draws from the operating system's cryptographically secure random
/// source. A `min` equal to `max` gives `min`, and the range may span every
/// `Int`. Returns a `CryptoError` of kind `InvalidRange` if `min` is greater
/// than `max`, and `EntropyUnavailable` if the random source fails.
pub fn random_int(min: Int, max: Int) -> Result<Int, CryptoError> {
    let status = crypto_random_int(min, max)
    if status == 0 { return Ok(decode_count(fs_take_bytes())) }
    Err(CryptoError { kind: crypto_error_kind_of(status), message: "random_int failed" })
}
