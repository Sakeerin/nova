// Nova standard library — filesystem.
//
// Compiled as an implicit module and glob-imported into every user module. Error
// types live in `std/io`.
//
// Paths are `String` throughout. Contents are not, uniformly: `read`/`write`
// take and return `Bytes` (`std/bytes`), so arbitrary file contents need no
// UTF-8 round-trip, while `read_to_string`/`write_string` stay on `String`
// for the common text case.
//
// Every function that touches the filesystem is an `async fn` per
// `nova-spec/20-STDLIB.md` §5, but **none of them suspends**: the operation
// runs synchronously inside the poll, because there is no I/O poller yet. The
// signature is what matters — it does not change when a poller lands, so no
// call site breaks then. The cost is that a call blocks the whole executor for
// its duration, so a sibling task makes no progress during a large read. See
// docs/adr/0011-io-error-kinds.md.
//
// `temp_dir` is the one exception and is a plain `fn`: it only queries the
// environment and touches no filesystem, so there is nothing in it that could
// ever suspend, and no future reason to change its signature either.
//
// # The shape of these wrappers is load-bearing
//
// Each one calls its intrinsic, then reads a slot, with **no `.await` between
// the two**. The runtime's payload and message slots are per-task, keyed on the
// polling task (`crates/nova-runtime/src/fs.rs`'s `SLOTS`/`slot_index`), so a
// sibling task cannot clobber them. The risk that remains is narrower but still
// real: **within one task**, a second operation overwrites that same task's own
// slot, so a wrapper that awaited mid-sequence could still read a payload its
// own later call replaced. A future function here that awaited mid-sequence
// would break that. Keep them straight-line.

// Read the whole file at `path` as a UTF-8 string.
//
// Non-UTF-8 contents are `InvalidData`, not a panic and not lossy replacement.
pub async fn read_to_string(path: String) -> Result<String, IoError> {
    let status = fs_read_to_string(path)
    if status == 0 {
        return Ok(fs_take_string())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Write `content` to `path`, replacing any existing contents.
pub async fn write_string(path: String, content: String) -> Result<(), IoError> {
    let status = fs_write_string(path, content)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Read the whole file at `path` as bytes.
//
// Unlike `read_to_string` this cannot fail with `InvalidData`: there is no
// encoding to violate.
pub async fn read(path: String) -> Result<Bytes, IoError> {
    let status = fs_read(path)
    if status == 0 {
        return Ok(fs_take_bytes())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Write `content` to `path`, replacing any existing contents.
pub async fn write(path: String, content: Bytes) -> Result<(), IoError> {
    let status = fs_write(path, content)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// The OS's temporary-directory path, with no trailing separator guaranteed
// either way -- join a name onto it the same way `fs_roundtrip` does.
pub fn temp_dir() -> String {
    fs_temp_dir()
}

// Whether `path` exists.
//
// Returns `Bool`, not `Result`, per `nova-spec/20-STDLIB.md` §5 — so a path that
// exists but cannot be examined is indistinguishable from one that is absent.
pub async fn exists(path: String) -> Bool {
    fs_exists(path)
}

// Create the directory `path`. The parent must already exist; use
// `create_dir_all` otherwise. An existing `path` is `AlreadyExists`.
pub async fn create_dir(path: String) -> Result<(), IoError> {
    let status = fs_create_dir(path)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Create the directory `path`, and any missing parent directories along the
// way. Unlike `create_dir`, an existing `path` is not an error.
pub async fn create_dir_all(path: String) -> Result<(), IoError> {
    let status = fs_create_dir_all(path)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Remove the file `path`.
pub async fn remove_file(path: String) -> Result<(), IoError> {
    let status = fs_remove_file(path)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// Remove the directory `path` and everything under it.
pub async fn remove_dir_all(path: String) -> Result<(), IoError> {
    let status = fs_remove_dir_all(path)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

// One entry in a directory listing.
//
// `is_file` and `is_dir` come from a single `fs_kind` call, so they cannot
// disagree with each other. They CAN both be false, though: `fs_kind` returns
// `0` whenever it cannot read the entry's metadata at all, not only when the
// entry is absent (see `fs_kind`'s own doc comment), and this record does not
// special-case that. So "exactly one is true" holds only for an entry whose
// metadata `fs_kind` could actually read -- not for every entry that exists.
// INFERRED, not measured: the clean trigger is a dangling symlink (`read_dir`
// lists it, its metadata call fails), which this codebase has not measured
// against on any platform -- constructing one needs admin rights on Windows,
// where this was checked.
pub record DirEntry {
    pub name: String
    pub path: String
    pub is_file: Bool
    pub is_dir: Bool
}

// List the entries in `path`, sorted by name.
//
// Sorted because directory order is unspecified by the operating system; the
// sort happens in the runtime.
//
// Builds each `DirEntry` here rather than in the runtime: a record built in Rust
// would put Nova's field layout in two places, which is the drift this module's
// boundary exists to avoid. The cost is one extra `fs_kind` call per entry.
pub async fn read_dir(path: String) -> Result<[DirEntry], IoError> {
    let status = fs_read_dir(path)
    if status != 0 {
        return Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
    }
    let names = fs_take_string_array()
    let n = names.len()
    // A repeat array, then every slot overwritten. `[init; n]` evaluates `init`
    // exactly ONCE, so all `n` slots start as the same heap object -- harmless
    // only because the loop below replaces each one. Do not read a slot before
    // assigning it.
    let mut out = [DirEntry { name: "", path: "", is_file: false, is_dir: false }; n]
    let mut i = 0
    while i < n {
        let name = names[i]
        let full = "${path}/${name}"
        let k = fs_kind(full)
        out[i] = DirEntry { name: name, path: full, is_file: k == 1, is_dir: k == 2 }
        i = i + 1
    }
    Ok(out)
}

// --- File, OpenOptions and open ---
//
// Unlike everything above, which opens, acts and closes inside one intrinsic
// call, a `File` is a handle that survives between calls -- Nova's first
// value holding an OS resource that way. Nova has no destructors, so
// explicit `close` is the only release mechanism; a `File` that is never
// closed leaks its descriptor until the process exits.

// Options for `open`. Each flag forwards onto `std::fs::OpenOptions`'s own
// method of the same name, in the order `open` below passes them to
// `file_open`: read, write, append, truncate, create, create_new.
//
// No chainable builder: a receiver-mutating method cannot be called on a
// temporary (`E0060`, measured), so `OpenOptions::reading().with_write()`
// does not compile in this language. Use one of the three constructors
// below, or build an exotic combination with `let mut o =
// OpenOptions::default()` followed by field assignment.
pub record OpenOptions {
    read: Bool
    write: Bool
    append: Bool
    truncate: Bool
    create: Bool
    create_new: Bool
}

// Every flag false. Passed to `open` as-is this fails -- measured:
// `std::fs::OpenOptions` itself requires at least one of read/write/append
// -- so this exists as the base for field assignment building an exotic
// combination, not as an option set meant to be used directly.
impl Default for OpenOptions {
    fn default() -> OpenOptions {
        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
    }
}

impl OpenOptions {
    pub fn reading() -> OpenOptions {
        OpenOptions { read: true, write: false, append: false, truncate: false, create: false, create_new: false }
    }

    // Write + create + truncate: start this file fresh, creating it if it is
    // not there yet and discarding any content it already has.
    pub fn writing() -> OpenOptions {
        OpenOptions { read: false, write: true, append: false, truncate: true, create: true, create_new: false }
    }

    // Append + create: add to this file, creating it if it is not there
    // yet, and leaving any content it already has in place.
    pub fn appending() -> OpenOptions {
        OpenOptions { read: false, write: false, append: true, truncate: false, create: true, create_new: false }
    }
}

// A handle to an open file. `fd` keys
// `crates/nova-runtime/src/file.rs`'s thread-local table of open
// `std::fs::File`s -- it is not an OS file descriptor number, and nothing
// about its value means anything to a Nova program beyond identifying an
// entry in that table.
//
// `fd` is not privacy-enforced -- no record field in this language is -- so
// a program can build `File { fd: 9999 }` naming no file this module ever
// opened. That is safe by design: absence from the handle table is
// indistinguishable from closedness, so a forged, stale, or already-closed
// handle behaves exactly like the real thing does once closed (see `close`
// below).
pub record File { fd: Int }

// Open `path` under `options`.
pub async fn open(path: String, options: OpenOptions) -> Result<File, IoError> {
    let status = file_open(path, options.read, options.write, options.append, options.truncate, options.create, options.create_new)
    if status == 0 {
        return Ok(File { fd: decode_count(fs_take_bytes()) })
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

impl File {
    // Closes the handle. Idempotent: a second or third call also returns
    // `Ok(())`, because Nova has no move checking, so `self` by value cannot
    // stop a second call the way it would in a language with real
    // ownership. Closing a stale or forged handle is the same no-op: the
    // table lookup a close performs simply removes nothing.
    pub async fn close(self) -> Result<(), IoError> {
        let status = file_close(self.fd)
        if status == 0 {
            return Ok(())
        }
        Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
    }
}

// Any operation other than `close` against a handle this module's table does
// not recognise -- already closed, stale, or forged -- reaches this same
// `IoError { kind: Other }` by missing the same table lookup, whether the
// operation is this function or `write_file`/`flush_file` below.
async fn read_file(f: File, max: Int) -> Result<Bytes, IoError> {
    let status = file_read(f.fd, max)
    if status == 0 {
        return Ok(fs_take_bytes())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

impl Read for File {
    fn read(self, max: Int) -> Future<Result<Bytes, IoError>> { read_file(self, max) }
}

// The write's byte count crosses the boundary the same way `std/io`'s
// `write_stdout` decodes its own byte count: 8 little-endian bytes in the
// payload slot, read back here by that same `decode_count` rather than a
// second decoder.
async fn write_file(f: File, buf: Bytes) -> Result<Int, IoError> {
    let status = file_write(f.fd, buf)
    if status == 0 {
        return Ok(decode_count(fs_take_bytes()))
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

async fn flush_file(f: File) -> Result<(), IoError> {
    let status = file_flush(f.fd)
    if status == 0 {
        return Ok(())
    }
    Err(IoError { kind: io_error_kind_of(status), message: fs_last_error_message() })
}

impl Write for File {
    fn write(self, buf: Bytes) -> Future<Result<Int, IoError>> { write_file(self, buf) }
    fn flush(self) -> Future<Result<(), IoError>> { flush_file(self) }
}
