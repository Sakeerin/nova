// Nova standard library -- JSON.
//
// `nova-spec/20-STDLIB.md` section 7's type declaration compiles verbatim,
// including the variant names that shadow builtin type names. Measured, not
// assumed: `Bool(Bool)` and `String(String)` are accepted and `match` binds
// them unqualified.

pub type JsonValue =
    | Null
    | Bool(Bool)
    | Number(Float)
    | String(String)
    | Array([JsonValue])
    | Object(Map<String, JsonValue>)

// `at` is a character index into the input, not a byte offset -- the parser
// walks `[Char]` -- but that is true only of an error `parse` returns.
// `FromJson::from_json`, below, constructs `JsonError` too, decoding an
// already-parsed `JsonValue` tree rather than input text: there is no
// cursor and no source position to report, so every error `from_json`
// returns carries a FIXED PLACEHOLDER, `at: 0`, never a real index.
pub record JsonError { msg: String, at: Int }

// The deepest nesting `parse` accepts. RFC 8259 section 9 permits a limit --
// "An implementation may set limits on the maximum depth of nesting" -- so a
// cap conforms.
//
// 128 IS A DECLARED CONTRACT AND DELIBERATELY NOT DERIVED FROM THIS BUILD'S
// STACK. That distinction answers the objection this file used to raise against
// any cap: a stack-size threshold is not a portable budget, and a number taken
// from one machine's stack would be wrong on the next. 128 is instead the
// budget `serde_json` starts a deserializer with -- a bare `remaining_depth:
// 128` literal on a `u8` field in its `src/de.rs`, not a named constant, and
// defeatable there through `disable_recursion_limit`. Read at `master` on
// 2026-08-25 and cited as a precedent that makes 128 defensible, not as a
// standard: Jackson's `StreamReadConstraints.maxNestingDepth()` defaults to
// 1000, CPython has no JSON-specific constant and inherits the interpreter's
// recursion limit, and Go's `encoding/json` caps nothing.
//
// For scale rather than for derivation: this build was measured parsing depth
// 5000 successfully and overflowing its stack at 6000, on an input of 12001
// characters. 128 sits far below that on the platform where it was measured,
// which is what makes it portable.
const MAX_DEPTH: Int = 128

// Render `v` as JSON text.
//
// TOTAL OVER VALUES, NOT OVER DEPTH. There is no `JsonValue` whose *shape*
// this cannot render and no error channel to report one with -- that is the
// sense in which `stringify` is called total throughout the records. It is NOT
// total over nesting depth: the `Array` and `Object` arms recurse back into
// this function with one native frame per level, so a value nested deeply
// enough exhausts the stack and THE PROCESS DIES. No `JsonError` is produced,
// because there is nowhere to put one.
//
// Measured against this compiler, debug build, on Windows: a value nested
// 1024, 4096 and 8192 levels deep all render; 20000 levels overflows the stack
// and the process aborts. `parse` has the identical property in the other
// direction, with its own measured threshold at `parse_value`, and the
// reasoning for imposing no cap in either direction is recorded there once.
//
// The two accumulator arms below are also QUADRATIC IN THE WHOLE RENDERED
// DOCUMENT, not in one literal: `out = "${out}..."` rebuilds the entire string
// once per element. The numbers for all four accumulators in this file, and
// why these two are the ones that matter, are at `scan_str`.
pub fn stringify(v: JsonValue) -> String {
    match v {
        Null => "null"
        Bool(b) => if b { "true" } else { "false" }
        Number(n) => number_to_json(n)
        String(s) => quote(s)
        Array(xs) => {
            let mut out = "["
            let mut i = 0
            while i < xs.len() {
                if i > 0 { out = "${out}," }
                out = "${out}${stringify(xs[i])}"
                i = i + 1
            }
            "${out}]"
        }
        Object(m) => {
            let ks = m.keys()
            let mut out = "{"
            let mut i = 0
            while i < ks.len() {
                if i > 0 { out = "${out}," }
                // The `None` arm is UNREACHABLE: `ks` is `m.keys()`, which
                // returns exactly the occupied slots, and nothing mutates
                // `m` between that call and this lookup, so every key here
                // is live and `get` answers `Some`.
                //
                // It is written out because it is the one fallback in this
                // file that would fail UNSAFE rather than safe. The
                // separator above is appended BEFORE the lookup, so a
                // `None` would leave a comma with no member after it --
                // `{"a":1,}` if it fired on the last key, `{"a":1,,"c":3}`
                // in the middle -- and neither is JSON, contradicting
                // `number_to_json`'s "output always valid JSON" directly.
                // Every other fallback in this file degrades safely
                // instead: `bump` refuses to advance, `span` returns the
                // empty string, and `utf8_bytes` returns `0xFF` precisely
                // to force a downstream rejection.
                //
                // `out = out` keeps the arm total without inventing a
                // member. Making the OUTPUT safe as well would mean moving
                // the separator below the lookup -- a change to live code
                // for an input that cannot occur, so it was not made.
                match m.get(ks[i]) {
                    Some(val) => out = "${out}${quote(ks[i])}:${stringify(val)}"
                    None => out = out
                }
                i = i + 1
            }
            "${out}}"
        }
    }
}

// JSON has no NaN and no infinity, so a non-finite number cannot be rendered.
// This emits `null` instead, which is what most codecs do and which keeps
// `stringify` total over values -- depth is a separate matter, see its own
// note -- and its output always valid JSON. It is DELIBERATELY LOSSY:
// a round trip through a non-finite number does not preserve it.
//
// `n - n != 0.0` is the finiteness test. For any finite `n` the difference is
// exactly zero; for either infinity it is NaN, and for NaN it is NaN, and NaN
// compares unequal to everything including itself. This avoids needing an
// `is_nan` the standard library does not have.
fn number_to_json(n: Float) -> String {
    if n - n != 0.0 { "null" } else { "${n}" }
}

// A growable character buffer, appended to and drained once.
//
// `Vec<Char>` plus `str_from_chars` IS the growable string buffer this file's
// cost note used to say the language did not have. `Vec` grows by doubling
// (`std/collections`) so appending is amortised O(1), and `str_from_chars`
// encodes a `[Char]` in one pass, so N appends plus one drain is linear where
// `out = "${out}..."` is quadratic. Measured, this compiler, debug build, with
// a 129 ms compile baseline included: pushing n characters took 142, 135, 132
// and 142 ms at n = 8000, 16000, 32000 and 64000 -- flat across an eightfold
// range -- against 164, 249, 447 and 752 ms for interpolation.
//
// The parameter is `mut b` and not `b`. A plain `b: Vec<Char>` fails
// `E0060: Vec_T.push mutates its receiver, but b is immutable`. Records are
// heap objects passed by pointer, so the mutation reaches the caller --
// including `Vec::push`'s reassignment of its backing array when it grows,
// which is the case that would break a value-semantics assumption. Measured,
// not assumed.
fn buf_push_str(mut b: Vec<Char>, s: String) {
    let cs = s.chars()
    let mut i = 0
    while i < cs.len() {
        b.push(cs[i])
        i = i + 1
    }
}

// The buffer's contents as a `String`. The same manoeuvre `vec_to_array` runs
// for `JsonValue`: allocate an exact-length array, copy, hand it on.
//
// THE EXACT-LENGTH COPY IS LOAD-BEARING and is not redundant with the `Vec`'s
// own backing array: that array is the buffer's CAPACITY, not its length, so
// encoding it directly would append the filler character of every unused slot.
// A mutation that returns the backing array PASSES at any length that happens
// to equal capacity, and capacity is always a power of two here, so exercise
// the drain at a length that is not one.
//
// `unwrap_or(' ')` cannot take its default: `i` runs strictly below `b.len()`,
// which is exactly the range `Vec::get` answers with `Some`.
fn vec_chars_to_string(b: Vec<Char>) -> String {
    let n = b.len()
    let mut out = [' '; n]
    let mut i = 0
    while i < n {
        out[i] = b.get(i).unwrap_or(' ')
        i = i + 1
    }
    str_from_chars(out)
}

// Escape `s` as a JSON string literal, quotes included. `char_to_int` is how
// this reaches a character's scalar value -- it is `STD_ONLY`, which is why
// this helper lives here rather than in a fixture.
fn quote(s: String) -> String {
    let cs = s.chars()
    let mut out: Vec<Char> = Vec::new()
    out.push('"')
    let mut i = 0
    while i < cs.len() {
        let c = cs[i]
        let code = char_to_int(c)
        if c == '"' {
            out.push('\\')
            out.push('"')
        } else {
            if c == '\\' {
                out.push('\\')
                out.push('\\')
            } else {
                if code < 32 {
                    buf_push_str(out, escape_control(code))
                } else {
                    out.push(c)
                }
            }
        }
        i = i + 1
    }
    out.push('"')
    vec_chars_to_string(out)
}

// One hex digit, lowercase, for a nibble in `0..16`. Nova has no formatting
// width primitive, so `escape_control` builds `\u00XX` two characters at a
// time through this.
fn hex_digit(n: Int) -> String {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else if n == 10 { "a" }
    else if n == 11 { "b" }
    else if n == 12 { "c" }
    else if n == 13 { "d" }
    else if n == 14 { "e" }
    else { "f" }
}

// RFC 8259 requires every control character below `0x20` escaped. Five have
// a named short escape; every other one falls back to `\u00XX`, which is
// always exactly two hex digits because `code` is below `0x20`.
fn escape_control(code: Int) -> String {
    if code == 10 { "\\n" }
    else if code == 13 { "\\r" }
    else if code == 9 { "\\t" }
    else if code == 8 { "\\b" }
    else if code == 12 { "\\f" }
    else {
        let hi = code / 16
        let lo = code % 16
        "\\u00${hex_digit(hi)}${hex_digit(lo)}"
    }
}

// Parse `s` as JSON. `JsonError::at` is a character index -- a count of Unicode
// scalar values, matching the `[Char]` the parser walks.
//
// A JSON text is ONE value, so trailing content is an error rather than a
// stopping point: `parse` skips whitespace, parses a single value, skips
// whitespace again, and rejects anything left over.
//
// It is deliberate that the trailing-content check runs even when the value
// walk has already failed: it is the second caller of `fail` that makes
// `fail`'s first-failure-wins guard observable, and so the thing that keeps
// that guard tested rather than merely written. `err` is then inspected ONCE,
// here, which is the whole point of carrying the failure in a field.
pub fn parse(s: String) -> Result<JsonValue, JsonError> {
    let mut p = P { cs: s.chars(), pos: 0, err: None }
    p.skip_ws()
    let v = p.parse_value(0)
    p.skip_ws()
    if !p.at_end() { p.fail("trailing content") }
    match p.err {
        Some(e) => Err(e)
        None => Ok(v)
    }
}

// The parser carries its failure in a field instead of returning `Result` at
// every level. Nova has no `?` operator -- measured against this compiler, not
// assumed: `?` parses and then typeck rejects it with
// `error[E0900]: the `?` operator are not supported yet` -- so threading a
// `Result` through a recursive descent would cost a `match` at every call site
// and bury the grammar in plumbing.
//
// `err` is set at most once: the FIRST failure wins, so a downstream symptom
// cannot overwrite the real cause. Every step that could read past the end
// checks `err` first and no-ops, returning `Null` -- after a failure the
// remaining walk is inert rather than wrong.
record P { cs: [Char], pos: Int, err: Option<JsonError> }

impl P {
    // Record a failure at the cursor, unless one is already recorded.
    //
    // The guard IS "first failure wins". `parse` runs its trailing-content
    // check even after the value walk has failed, so without the guard that
    // check would overwrite the real cause with a consequence of it: `01` would
    // report `trailing content` at 1 rather than the leading zero that actually
    // stopped the scanner there.
    //
    // `01` and NOT `+1` for that example. `+1` no longer reaches `scan_number`
    // at all -- `parse_value`'s dispatch rejects a leading `+` as `expected a
    // value` before any digit is looked for -- so it no longer illustrates a
    // cause the guard protects, only one it renames. That correction was applied
    // to `parse`'s comment, `scan_number`'s comment and the fixture header in
    // the same change that made it necessary, and missed here.
    //
    // Measured, so the reach is not assumed: dropping this guard rewrites every
    // golden line whose rejection stops the cursor short of the end of the
    // input AND whose value walk had already failed. The predicate is the
    // durable part; the count is not, and this file's parse fixtures have grown
    // since it was taken. Re-measure by deleting the guard rather than citing a
    // number from here.
    //
    // Both halves of that predicate are load-bearing. Four more goldens in
    // `json_parse_values.stdout` also stop short of the end -- the
    // trailing-content cases -- and are UNCHANGED, because for them the
    // trailing-content error IS the first failure, so there is nothing for the
    // guard to keep. Reading the clause without its second half predicts 28
    // rewritten lines rather than 24.
    fn fail(mut self, m: String) {
        if self.err.is_none() {
            self.err = Some(JsonError { msg: m, at: self.pos })
        }
    }

    fn at_end(self) -> Bool { self.pos >= self.cs.len() }

    // The character at the cursor, or `'\0'` past the end.
    //
    // `'\0'` is a sentinel, not a distinguished value: a real NUL in the input
    // reads identically here. That is harmless, because NUL appears in no JSON
    // token -- it is legal only inside a string literal, and RFC 8259 requires
    // even that one escaped -- so every caller that meets a NUL rejects it,
    // exactly as it rejects the end of the input. A caller that needs the two
    // told apart asks `at_end` instead.
    fn peek(self) -> Char {
        if self.at_end() { '\0' } else { self.cs[self.pos] }
    }

    // Advance one character, never past the end, so `pos` stays a valid bound
    // for `span` below. Every caller in this module bumps only after `peek`
    // returned a real character, so today the guard is defensive rather than
    // load-bearing; it is written so that a scanner looping on `bump` cannot
    // walk off the array.
    fn bump(mut self) {
        if !self.at_end() { self.pos = self.pos + 1 }
    }

    // Characters `start..end` as a `String`, `end` exclusive.
    //
    // `std/strings` runs the same algorithm over a plain `[Char]`
    // (`chars_to_string`), but it is private to that module and Nova has no
    // cross-module access to a private item, so these five lines are a
    // deliberate duplication rather than an oversight. `[' '; n]` needs a
    // filler and a repeat literal is the only way to allocate a runtime-length
    // array; every slot is overwritten immediately below, so the space never
    // survives.
    //
    // NEITHER half of the `n <= 0` guard is reachable today -- for a stronger
    // reason than in `chars_to_string`, whose note on exactly this guard the
    // duplication above had dropped. `scan_number` is this helper's only
    // caller, `pos` never moves backwards, and the call site sits past at least
    // one consumed digit, so `n` is always 1 or more. Kept for the reason
    // `chars_to_string` keeps it: a future caller of this module-private helper
    // may not bound its own span as carefully. At `n == 0` the general path
    // would return "" unaided anyway, so that half only skips an allocation --
    // measured, not assumed: `[' '; 0]` is a legal repeat literal of length 0,
    // the `0..0` loop is vacuous, and `nova_rt_str_from_chars` of an empty
    // array builds an empty `String`.
    fn span(self, start: Int, end: Int) -> String {
        let n = end - start
        if n <= 0 { return "" }
        let mut out = [' '; n]
        for i in 0..n { out[i] = self.cs[start + i] }
        str_from_chars(out)
    }

    // Skip JSON's whitespace: space, horizontal tab, line feed, carriage
    // return. THAT IS THE ENTIRE SET -- RFC 8259 permits no others, so a
    // vertical tab, a form feed or a non-breaking space is a syntax error and
    // must not be skipped here.
    fn skip_ws(mut self) {
        let mut going = true
        while going {
            let c = self.peek()
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                self.bump()
            } else {
                going = false
            }
        }
    }

    // A JSON number: `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`.
    //
    // Validates by walking characters, then slices the matched span and hands
    // it to `str_to_float`. Validating FIRST is what makes that intrinsic's
    // `0.0`-on-rejection fallback unreachable: every span reaching it is a text
    // Rust's `f64` parser also accepts, since Rust's accepted grammar is a
    // superset of the one above.
    //
    // A magnitude no `Float` can hold is ACCEPTED, not rejected: JSON's grammar
    // sets no range, and Rust's parser saturates rather than failing. Measured
    // against this compiler: `1e999` parses to infinity, which `stringify` then
    // renders `null` via `number_to_json`'s non-finite branch, and `1e-999`
    // parses to `0`. Both are lossy round trips. No fixture pins either -- they
    // are recorded here as measured behaviour, not as tested behaviour.
    //
    // Each rejection is a shape JSON forbids that a laxer reader would take:
    // a leading zero followed by a digit (`01` is two tokens, not one number),
    // a `.` with no digit after it, and an exponent with no digits.
    //
    // `+1` and `.5` never arrive here. `parse_value` dispatches to this scanner
    // only on `-` or a digit, so neither a leading `+` (only `-` is a sign) nor
    // a bare `.` gets past the dispatch, and both are reported there as
    // `expected a value` instead. What still reaches the `expected a digit`
    // branch below is a `-` with no digit after it, which is the `-` case in
    // `json_parse_numbers.nova`.
    fn scan_number(mut self) -> JsonValue {
        if self.err.is_some() { return Null }
        let start = self.pos
        if self.peek() == '-' { self.bump() }
        if self.peek() == '0' {
            self.bump()
            if is_digit(self.peek()) {
                self.fail("a leading zero cannot be followed by another digit")
                return Null
            }
        } else if is_digit(self.peek()) {
            while is_digit(self.peek()) { self.bump() }
        } else {
            self.fail("expected a digit")
            return Null
        }
        if self.peek() == '.' {
            self.bump()
            if !is_digit(self.peek()) {
                self.fail("expected a digit after the decimal point")
                return Null
            }
            while is_digit(self.peek()) { self.bump() }
        }
        if self.peek() == 'e' || self.peek() == 'E' {
            self.bump()
            if self.peek() == '+' || self.peek() == '-' { self.bump() }
            if !is_digit(self.peek()) {
                self.fail("expected a digit in the exponent")
                return Null
            }
            while is_digit(self.peek()) { self.bump() }
        }
        Number(str_to_float(self.span(start, self.pos)))
    }

    // One JSON value, dispatched on the character at the cursor.
    //
    // The dispatch is unambiguous because JSON's six value kinds start on
    // disjoint character sets -- seven of them, since `true` and `false` are one
    // kind on two letters: `n`, `t`, `f`, `"`, `[`, `{`, and `-` or a digit.
    // Anything else is not the start of a value, which is where a leading `+`, a
    // bare `.`, a stray `]` and an empty input all land.
    //
    // `n`/`t`/`f` hand off to `keyword`, which matches the WHOLE spelling.
    // Dispatching on the first letter and then consuming a fixed count would
    // read `nxxx` as `null`.
    //
    // NESTING DEPTH IS CAPPED IN THIS DIRECTION. This recurses through
    // `scan_array` and `scan_object` back into itself, and the check above
    // bounds that recursion at `MAX_DEPTH`, reporting an ordinary `JsonError`
    // through the same channel as a syntax error. `stringify` is bounded
    // differently -- it does not recurse at all -- and says so at its own
    // header rather than here, so this file no longer states one property for
    // both directions.
    //
    // WHAT THE NUMBER COUNTS. A leaf costs a depth level and an empty
    // innermost container does not, because the empty-container fast paths in
    // `scan_array` and `scan_object` return without re-entering this function.
    // So 128 containers wrapping a leaf is accepted and 129 is not, while 129
    // containers ending empty is accepted and 130 is not. Both boundaries are
    // pinned: `json_depth_leaf.nova` and `json_depth_empty.nova`.
    //
    // RETRACTED, quoted so the retraction is legible. This paragraph used to
    // say a cap was declined deliberately because "a stack-size artefact is not
    // a budget a cap can be derived from", and that a cap "needs an API choice
    // this increment's scope did not include, namely which depth and whether
    // exceeding it is an ordinary `JsonError` or something a caller must
    // distinguish from bad syntax." The objection was right and is honoured
    // rather than overruled: `MAX_DEPTH` is a declared contract, not a number
    // read off this build's stack. Both deferred questions are answered -- the
    // counting rule is above, and the failure is an ordinary `JsonError`,
    // deliberately indistinguishable in shape from bad syntax, so a caller that
    // must tell them apart matches the message. That is a weak contract and is
    // named as one.
    //
    // The claim that no fixture could pin the threshold was true of a
    // STACK threshold -- a fixture that crashed the process would fail the
    // suite by construction -- and stops applying to a declared constant.
    fn parse_value(mut self, d: Int) -> JsonValue {
        if self.err.is_some() { return Null }
        if d > MAX_DEPTH {
            self.fail("maximum nesting depth exceeded")
            return Null
        }
        let c = self.peek()
        if c == 'n' { return self.keyword("null", Null) }
        if c == 't' { return self.keyword("true", Bool(true)) }
        if c == 'f' { return self.keyword("false", Bool(false)) }
        if c == '"' {
            let s = self.scan_str()
            return String(s)
        }
        if c == '[' { return self.scan_array(d) }
        if c == '{' { return self.scan_object(d) }
        if c == '-' || is_digit(c) { return self.scan_number() }
        self.fail("expected a value")
        Null
    }

    // A literal name -- `null`, `true` or `false` -- matched character by
    // character against `word`, returning `v` only if all of it is there.
    //
    // The mismatch is reported AT the offending character rather than at the
    // start of the name, so `nul` fails at 3 (where the fourth character should
    // be) and not at 0.
    fn keyword(mut self, word: String, v: JsonValue) -> JsonValue {
        let ws = word.chars()
        let mut i = 0
        while i < ws.len() {
            if self.peek() != ws[i] {
                self.fail("expected ${word}")
                return Null
            }
            self.bump()
            i = i + 1
        }
        v
    }

    // A JSON array, cursor on `[`.
    //
    // The empty array is checked BEFORE the element loop, which is what makes
    // `[]` legal while `[1,]` and `[,1]` are not: once the loop is entered, a
    // value is required, because RFC 8259's `array` repetition ends on a value
    // and never on a separator.
    fn scan_array(mut self, d: Int) -> JsonValue {
        self.bump()
        self.skip_ws()
        if self.peek() == ']' {
            self.bump()
            let empty: [JsonValue] = []
            return Array(empty)
        }
        let mut items: Vec<JsonValue> = Vec::new()
        let mut going = true
        while going {
            let v = self.parse_value(d + 1)
            if self.err.is_some() { return Null }
            items.push(v)
            self.skip_ws()
            let c = self.peek()
            if c == ',' {
                self.bump()
                self.skip_ws()
            } else if c == ']' {
                self.bump()
                going = false
            } else {
                self.fail("expected ',' or ']' in an array")
                return Null
            }
        }
        Array(vec_to_array(items))
    }

    // A JSON object, cursor on `{`.
    //
    // Mirrors `scan_array`, with a member in place of a value. The key check is
    // explicit here rather than left to `scan_str`, so a missing key reports
    // `expected an object key` -- RFC 8259 admits only a `string` as a member
    // name, so `{a:1}` is an error and not a laxer reader's bare word.
    //
    // A repeated key keeps the LAST value, because `Map::insert` replaces.
    // RFC 8259 section 4 sanctions no particular choice -- it calls the
    // behaviour of a non-unique name "unpredictable" and observes that many
    // implementations report the last pair only -- so this is a decision, not a
    // requirement, and `json_parse_values.nova`'s `duplicate key` case pins it.
    fn scan_object(mut self, d: Int) -> JsonValue {
        self.bump()
        self.skip_ws()
        let mut m: Map<String, JsonValue> = Map::new()
        if self.peek() == '}' {
            self.bump()
            return Object(m)
        }
        let mut going = true
        while going {
            if self.peek() != '"' {
                self.fail("expected an object key")
                return Null
            }
            let k = self.scan_str()
            if self.err.is_some() { return Null }
            self.skip_ws()
            if self.peek() != ':' {
                self.fail("expected ':' after an object key")
                return Null
            }
            self.bump()
            self.skip_ws()
            let v = self.parse_value(d + 1)
            if self.err.is_some() { return Null }
            m.insert(k, v)
            self.skip_ws()
            let c = self.peek()
            if c == ',' {
                self.bump()
                self.skip_ws()
            } else if c == '}' {
                self.bump()
                going = false
            } else {
                self.fail("expected ',' or '}' in an object")
                return Null
            }
        }
        Object(m)
    }

    // A JSON string literal, cursor on the opening `"`. Returns the DECODED
    // contents, with every escape resolved; on failure `err` is set and the
    // return value is `""` rather than meaningful.
    //
    // The three arms are exactly RFC 8259's `char`: a closing quote ends the
    // literal, a backslash starts an escape, and anything else is `unescaped`
    // -- which the grammar defines as `%x20-21 / %x23-5B / %x5D-10FFFF`. That
    // range starts at `0x20`, so a raw character below it is a SYNTAX ERROR and
    // not a character to pass through: tab and line feed are legal whitespace
    // BETWEEN tokens and still illegal unescaped inside a string. Note the
    // range runs to `10FFFF` with no upper exclusion, so `0x7f` (DEL) is
    // ordinary text here and needs no escape.
    //
    // The `peek() != '"'` guard is defensive rather than load-bearing today:
    // `parse_value` dispatches here only on `"`, and `scan_object` checks for
    // one itself. It is kept for the reason `bump`'s bounds guard is -- a
    // future caller may not position the cursor as carefully.
    //
    // `out` used to be described here as "rebuilt by interpolation on every
    // character, which is quadratic in the literal's length", with Nova
    // having "no growable string buffer to do better with". Both retracted by
    // the roster below: `out` is now a `Vec<Char>`, appended to and drained
    // once, and that buffer is exactly what the second clause said did not
    // exist. What did NOT change is why a plain slice cannot stand in for the
    // loop: a `span`-style slice still cannot replace it, because an escape
    // means the decoded text is not a contiguous run of the input, so the
    // characters still have to be assembled one at a time, only now into a
    // buffer rather than by interpolation.
    //
    // THE ACCUMULATOR ROSTER IN THIS FILE, by name rather than by count, and
    // what changed. `quote` and this function each built one string literal by
    // interpolation; `stringify`'s `Array` and `Object` arms built the whole
    // rendered document that way. `quote` and this function now append into a
    // `Vec<Char>` drained once through `str_from_chars` instead, so neither is
    // quadratic in what it emits. `stringify`'s two arms do not yet -- that
    // migration is later work in this same increment, not this task's.
    //
    // Regrep before citing the first half of that claim: `grep -n 'out =
    // "${out}'` over this file matches lines inside `stringify`'s `Array` and
    // `Object` arms and nowhere inside the BODY of `quote` or of `scan_str` --
    // those two no longer build a string that way, whatever a comment
    // (including this one) goes on to quote for illustration.
    //
    // RETRACTED, and quoted so the retraction is legible: this note used to
    // close "Neither is capped, and neither is fixable without a growable
    // string buffer the language does not have." That is true only of a
    // growable `String` TYPE, which Nova still lacks. It is false in the sense
    // the sentence was used: `Vec<Char>` plus `str_from_chars` composes into
    // exactly such a buffer, both already shipped, and both were already
    // called from this very file -- `Vec` at `vec_to_array`, `str_from_chars`
    // at `span`. The fix needed no language change.
    //
    // The measurements the old note carried described the interpolation form
    // and are superseded; `buf_push_str` above carries the buffer's numbers.
    // What did NOT change is `parse`'s cost, which was already effectively
    // flat: 279, 282 and 344 ms for an array of 4000, 8000 and 16000
    // one-character numbers.
    fn scan_str(mut self) -> String {
        if self.err.is_some() { return "" }
        if self.peek() != '"' {
            self.fail("expected a string")
            return ""
        }
        self.bump()
        let mut out: Vec<Char> = Vec::new()
        while true {
            if self.at_end() {
                self.fail("unterminated string")
                return ""
            }
            let c = self.peek()
            if c == '"' {
                self.bump()
                return vec_chars_to_string(out)
            }
            if c == '\\' {
                self.bump()
                let piece = self.scan_escape()
                if self.err.is_some() { return "" }
                buf_push_str(out, piece)
            } else if char_to_int(c) < 32 {
                self.fail("a control character must be escaped")
                return ""
            } else {
                self.bump()
                out.push(c)
            }
        }
        vec_chars_to_string(out)
    }

    // What one escape decodes to, cursor on the character AFTER the backslash.
    //
    // RFC 8259 allows exactly nine forms after a backslash, and a backslash
    // followed by anything else is an error -- there is no "unknown escapes
    // pass through" rule. The cursor is not advanced before the failure, so
    // `at` points at the offending character rather than past it.
    fn scan_escape(mut self) -> String {
        if self.at_end() {
            self.fail("unterminated string")
            return ""
        }
        let e = self.peek()
        if e == 'u' {
            self.bump()
            return self.scan_hex_escape()
        }
        match simple_escape(e) {
            Some(s) => {
                self.bump()
                s
            }
            None => {
                self.fail("unknown escape")
                ""
            }
        }
    }

    // `\uXXXX`, cursor just past the `u`, and the surrogate pairing RFC 8259
    // section 7 requires for anything above the BMP.
    //
    // There is NO Int-to-`Char` conversion in Nova, so this cannot build a
    // `Char` from a code point. It encodes the code point to UTF-8 bytes here
    // and hands them to `Bytes::to_string`, whose `Option` is the validation:
    // `to_string` checks UTF-8 and returns `None`, so a code point that is not
    // a Unicode scalar value becomes a `JsonError` instead of garbage. That is
    // why no second intrinsic was added for this. The runtime's own
    // `nova_rt_char_to_str` would have been strictly worse -- its body is
    // `char::from_u32(v as u32).unwrap_or(char::REPLACEMENT_CHARACTER)`, so it
    // silently substitutes U+FFFD for exactly the inputs that must be rejected.
    //
    // The `None` arm is therefore a SECOND line of defence, not a redundant
    // one: the explicit surrogate checks above it make every code point that
    // reaches the encoder a scalar value, so the arm cannot fire as written.
    // Deleting the LONE-SURROGATE rejection makes it fire -- measured, not
    // assumed: with that check gone, `"\udc00"` reports `an escape is not a
    // valid code point`, because a lone surrogate encodes to a three-byte
    // sequence Rust's `str::from_utf8` rejects. So the error survives the loss
    // of that check, and only its message changes.
    //
    // Deleting the LOW-SURROGATE RANGE check does NOT reach that arm, and the
    // asymmetry is why both checks are here rather than one. The
    // `high surrogate then a non-surrogate escape` case in
    // `json_parse_strings.nova` -- a high surrogate followed by an escape whose
    // value is `0x41` -- then combines to `0x11841`, a perfectly ordinary
    // character, so that input is silently ACCEPTED instead of rejected.
    // Measured on its own, with the check above this one left in place.
    fn scan_hex_escape(mut self) -> String {
        let hi = self.scan_hex4()
        if self.err.is_some() { return "" }
        if hi >= 0xDC00 && hi <= 0xDFFF {
            self.fail("a low surrogate must follow a high surrogate")
            return ""
        }
        let mut cp = hi
        if hi >= 0xD800 && hi <= 0xDBFF {
            if self.peek() != '\\' {
                self.fail("a high surrogate must be followed by a low surrogate")
                return ""
            }
            self.bump()
            if self.peek() != 'u' {
                self.fail("a high surrogate must be followed by a low surrogate")
                return ""
            }
            self.bump()
            let lo = self.scan_hex4()
            if self.err.is_some() { return "" }
            if lo < 0xDC00 || lo > 0xDFFF {
                self.fail("expected a low surrogate")
                return ""
            }
            cp = 0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00)
        }
        match bytes_from_ints(utf8_bytes(cp)).to_string() {
            Some(s) => s
            None => {
                self.fail("an escape is not a valid code point")
                ""
            }
        }
    }

    // Exactly four hexadecimal digits, as an `Int`. FOUR is the grammar's own
    // count (`%x75 4HEXDIG`), not a convenience: reading fewer would leave the
    // remaining digits to be taken as literal text, and reading more would
    // swallow the character after the escape.
    //
    // A non-hex character stops this, and so does the end of the input, since
    // `peek`'s past-the-end `'\0'` is not a hexadecimal digit.
    fn scan_hex4(mut self) -> Int {
        let mut v = 0
        let mut i = 0
        while i < 4 {
            let d = hex_value(self.peek())
            if d < 0 {
                self.fail("expected four hexadecimal digits")
                return 0
            }
            v = v * 16 + d
            self.bump()
            i = i + 1
        }
        v
    }
}

// An ASCII digit. `Char` admits `<=` and `>=` directly (`impl Ord for Char` in
// `std/core` is built on `<`), so this needs no conversion to `Int` -- which
// also keeps the past-the-end sentinel `'\0'` a non-digit for free.
fn is_digit(c: Char) -> Bool { c >= '0' && c <= '9' }

// One hexadecimal digit's value, or `-1` for anything that is not one. `-1`
// rather than `Option<Int>` because the single caller is a four-iteration loop
// and an `Option` there buys a `match` per digit and nothing else.
//
// The offsets are the ASCII arithmetic: `'0'` is 48, `'a'` is 97 and 97 - 87 is
// 10, `'A'` is 65 and 65 - 55 is 10. Both letter cases are accepted because RFC
// 8259's `HEXDIG` is `DIGIT / "A" / ... / "F"` under ABNF's case-insensitive
// rule for literals.
fn hex_value(c: Char) -> Int {
    if c >= '0' && c <= '9' { return char_to_int(c) - 48 }
    if c >= 'a' && c <= 'f' { return char_to_int(c) - 87 }
    if c >= 'A' && c <= 'F' { return char_to_int(c) - 55 }
    // `return`, not a bare `-1`: after the `if` block above, a statement
    // starting `-` parses as SUBTRACTION from that block's value. Measured.
    return -1
}

// `cp` encoded as UTF-8, one `Int` per byte. The four length classes are UTF-8's
// own: `0..0x80` in one byte, `0x80..0x800` in two, `0x800..0x10000` in three,
// and the rest in four.
//
// Nova has no `Char` built from an `Int`, so this is the only route from a
// `\uXXXX` code point to a `String`, via `bytes_from_ints` and
// `Bytes::to_string`.
//
// The out-of-range guard returns `0xFF`, which is not a legal UTF-8 byte in any
// position, so such a code point becomes a `to_string` failure at the call site
// rather than a mangled character. It is UNREACHABLE as written -- four
// hexadecimal digits cannot exceed `0xFFFF`, four of them cannot be negative,
// and the surrogate combine's own maximum is `0x10000 + 0x3FF * 0x400 + 0x3FF`,
// which is exactly `0x10FFFF`.
//
// It is here because the two arms it shields are the only expressions below
// whose result is not bounded to `0..=255` by construction: `[cp]` for a
// NEGATIVE `cp`, and the four-byte lead `0xF0 | (cp >> 18)` for an oversized
// one. Every other byte is masked or has a bounded input -- `0xC0 | (cp >> 6)`
// tops out at `0xDF`, `0xE0 | (cp >> 12)` at `0xEF`, and a continuation byte at
// `0xBF`. And the shielding matters because `bytes_from_ints` ABORTS the process
// on an element outside `0..=255` rather than returning an error.
fn utf8_bytes(cp: Int) -> [Int] {
    if cp < 0 || cp > 0x10FFFF { return [0xFF] }
    if cp < 0x80 { return [cp] }
    if cp < 0x800 { return [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)] }
    if cp < 0x10000 {
        return [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
    }
    // `return`, not a bare trailing expression: after the `if` block above, a
    // statement starting `[` parses as an INDEX into that block's value and
    // fails on the first comma. Measured, not stylistic.
    return [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
}

// A `Vec` copied into the plain `[JsonValue]` that `Array` holds.
//
// `scan_array` collects into a `Vec` because it cannot know the element count
// before it has parsed them. This used to be called "the one-way conversion
// out"; it no longer is one -- `vec_chars_to_string`, added above `quote` for
// the string buffer, drains a `Vec<Char>` the same way. `Null` is the repeat
// literal's filler -- every slot is overwritten below, so it never survives,
// and `JsonValue` having a nullary variant is why this needs no `Default`
// bound.
//
// `unwrap_or(Null)` cannot take its default: `i` runs strictly below `v.len()`,
// which is exactly the range `Vec::get` answers with `Some`.
fn vec_to_array(v: Vec<JsonValue>) -> [JsonValue] {
    let n = v.len()
    let mut out = [Null; n]
    let mut i = 0
    while i < n {
        out[i] = v.get(i).unwrap_or(Null)
        i = i + 1
    }
    out
}

// The eight one-character escapes of RFC 8259 section 7, or `None` for any other
// character after a backslash. `\u` is deliberately absent: it consumes four
// more characters and so needs the cursor, which a free function does not have.
//
// `\b` and `\f` are written as string `\u{...}` escapes because Nova's CHAR
// literal admits only `\n \t \r \\ \' \0` -- measured against this compiler:
// anything else falls through `lex_char`'s `_ => None`, so `'\u{0C}'` does not
// lex at all, while the string lexer's own `\u{...}` does.
fn simple_escape(c: Char) -> Option<String> {
    if c == '"' { return Some("\"") }
    if c == '\\' { return Some("\\") }
    if c == '/' { return Some("/") }
    if c == 'b' { return Some("\u{08}") }
    if c == 'f' { return Some("\u{0C}") }
    if c == 'n' { return Some("\n") }
    if c == 'r' { return Some("\r") }
    if c == 't' { return Some("\t") }
    None
}

// === ToJson / FromJson ===
//
// `nova-spec/20-STDLIB.md` section 7 writes both traits with `Self` in
// return position:
//
//     pub trait ToJson { fn to_json(self) -> JsonValue }
//     pub trait FromJson { fn from_json(v: JsonValue) -> Result<Self, JsonError> }
//
// An `impl`, unlike the trait declaration, writes the CONCRETE type in that
// position -- `impl Default for Int { fn default() -> Int { 0 } }` at
// `std/core/lib.nova` is what proves that compiles; every impl below follows
// that form, not `Self`.
pub trait ToJson { fn to_json(self) -> JsonValue }
pub trait FromJson { fn from_json(v: JsonValue) -> Result<Self, JsonError> }

// Every `from_json` below that returns `Err` uses `at: 0` -- see
// `JsonError`'s own doc comment above for why a fixed placeholder is
// correct here rather than an oversight.
//
// Scope stops at four primitives -- `Bool`, `String`, `Float`, `Int` -- on
// purpose. No container impl (`[T]`, `Map<String, T>`, `Option<T>`) is
// added: each one is more public API this module would then owe a fixture
// for `Array`, `Object`, `T: ToJson` would need a bound this module cannot
// express any better than by hand, and nothing this task's brief asks for
// needs one. That is exactly the "endless tail of instances" YAGNI is
// guarding against here.

// `Bool` and `JsonValue`'s `Bool` variant share a spelling; `Bool(self)`
// below constructs the variant, not the type. Proven the same way this
// module's own parser already relies on it: `parse_value` builds
// `Bool(true)`/`Bool(false)` as VALUES, not only as patterns, and that is
// measured against this compiler in this file's header comment.
impl ToJson for Bool {
    fn to_json(self) -> JsonValue { Bool(self) }
}

impl FromJson for Bool {
    // Anything but `Bool` is a decode error, never a guess -- `Number(0.0)`
    // and `Null` do NOT become `false`.
    fn from_json(v: JsonValue) -> Result<Bool, JsonError> {
        match v {
            Bool(b) => Ok(b)
            _ => Err(JsonError { msg: "expected a bool", at: 0 })
        }
    }
}

impl ToJson for String {
    fn to_json(self) -> JsonValue { String(self) }
}

impl FromJson for String {
    fn from_json(v: JsonValue) -> Result<String, JsonError> {
        match v {
            String(s) => Ok(s)
            _ => Err(JsonError { msg: "expected a string", at: 0 })
        }
    }
}

impl ToJson for Float {
    // Exact: `Number` already IS an `f64`, so nothing here can round.
    fn to_json(self) -> JsonValue { Number(self) }
}

impl FromJson for Float {
    // Every `Number` is a valid `Float` -- non-finite and fractional ones
    // included. `Float` has no narrower range to reject a `Number` into, so
    // unlike `Int` below this has nothing to decide.
    fn from_json(v: JsonValue) -> Result<Float, JsonError> {
        match v {
            Number(n) => Ok(n)
            _ => Err(JsonError { msg: "expected a number", at: 0 })
        }
    }
}

// RULE (encode): an `Int` too large for an `f64` to hold exactly converts
// anyway, rounding SILENTLY to the nearest value a `Float` can represent.
// `Int::to_json` returns `JsonValue`, not a `Result`, so there is no error
// channel here even if refusing were wanted.
//
// An `f64` mantissa carries 53 bits, so every `Int` in `-2^53..=2^53`
// survives this exactly; the first one that does not is `2^53 + 1 ==
// 9007199254740993`, which this rounds to `9007199254740992` (round half to
// even: `9007199254740992` and `9007199254740994` are its two representable
// neighbours, equally far away, and `9007199254740992` is the one with an
// even low mantissa bit). Measured against this compiler, not assumed:
// `json_traits.nova`'s "precision loss at the f64 mantissa boundary" case
// pins that exact pair colliding on one rendered JSON text.
//
// The conversion goes through `str_to_float`, the only PRIMITIVE route from
// text to `Float` this language has -- there is no `as` cast (`E0900`) and no
// Int-to-Float intrinsic anywhere in Nova today. `"${self}"` is `Int`'s own
// `Display`, exact for the full `Int` range, so all of the rounding above
// happens inside `str_to_float` and none of it in the formatting step.
impl ToJson for Int {
    fn to_json(self) -> JsonValue { Number(str_to_float("${self}")) }
}

// RULE (decode): a `Number` converts to `Int` only when its value is both
// IN RANGE for `Int` and carries no fraction. Two independent failures,
// checked in this order:
//
//   * a magnitude outside `i64::MIN..=i64::MAX`
//     (`-9223372036854775808..=9223372036854775807`) is an `Err`, never a
//     wrapped value. An earlier version of this function had no bound
//     check at all: a too-large `Number` reached the digit accumulation
//     below and wrapped silently, the same way `std/core`'s `mix64`
//     documents `Int`'s own `*` wrapping rather than trapping. That is
//     fine for `mix64`, which is mixing bits on purpose; it is not fine
//     here, decoding externally-supplied JSON, where "a fraction is a
//     decode error and never a silent truncation" (next bullet) and a
//     wrapped-away magnitude is the same failure mode applied to the
//     integer's size instead of its precision.
//   * a fraction is a decode error and never a silent truncation --
//     `Number(3.0)` decodes to `3`, `Number(3.5)` is an `Err`. This module
//     already marks `stringify`'s non-finite-to-`null` collapse
//     "DELIBERATELY LOSSY" in the encode direction, and letting
//     `from_json` throw away a fraction in the decode direction would make
//     a round trip fabricate a value instead of reporting that it could
//     not produce one.
//
// The bound check compares `n` itself, before any text exists, against
// `-9223372036854775808.0` (`i64::MIN`) and `9223372036854775808.0` (one
// past `i64::MAX`). Both are exact `Float` values -- both are powers of
// two -- which `i64::MAX` itself, `9223372036854775807`, is NOT (the
// nearest `Float` to it is `9223372036854775808.0`, the same value used
// as the rejected upper bound), so this never has to ask whether an
// inexact `Float` equals an exact `Int` edge. `NaN` fails both `<` and
// `>=` here. `<` and `==` are both `false` whenever either operand is
// `NaN`, which is what `std/core`'s own note on `impl Ord for Float`
// states -- that note names those two operators and no others. The same
// holds for `>`, `<=` and `>=` under IEEE 754, and of those the `<` and
// `>=` used right here are the ones measured below; `>` and `<=` are
// neither cited nor measured anywhere in this tree. `!=` is the
// exception and is `true`, which is exactly what `number_to_json`'s
// `n - n != 0.0` finiteness test above depends on, so "a comparison
// against `NaN` is always false" would contradict this file's own
// machinery. So `NaN` is not rejected by the range check; it is caught
// immediately after, by the fraction check,
// since `"NaN"` is not digit-shaped either. Measured against this
// compiler, not assumed: a throwaway `out_of_range(n)` returned `false`
// for `0.0 / 0.0`, and `true` for both `1.0 / 0.0` and its negation.
//
// There is no Float-to-Int intrinsic and no `as` cast (`E0900`) anywhere
// in Nova today, so getting to `Int` at all means walking decimal digits
// by hand, the way `scan_hex4` above walks hex ones -- over TWO different
// texts of `n`, not one, and this is the second decision this rule makes
// explicit rather than by accident:
//
//   * `"${n}"`, `Float`'s `Display`, checked ONLY for shape below (every
//     character but an optional leading `-` must be `0`-`9`) to decide
//     fraction-or-not. Its DIGITS are never used for the value: `Display`
//     is a SHORTEST-ROUND-TRIP rendering, not an exact one, and once a
//     `Float`'s neighbouring representable values are more than 1 apart,
//     the shortest text that round-trips can be a rounder nearby number
//     rather than the exact one. Measured, not assumed:
//     `"${-9223372036854775808.0}"` (`i64::MIN`, exactly representable,
//     being a power of two) is `"-9223372036854776000"` -- OFF BY 192 from
//     the value it names, and also outside `Int`'s own range -- exactly
//     the shape of bug this rule exists to refuse rather than launder
//     into a wrapped `Int`.
//   * `float_fixed(n, 0)` for the actual digits, which IS exact --
//     `std/fmt`'s own comment on `Float::fixed` gives the reason, that
//     Nova "cannot begin on it, having no `Float` to `Int` conversion at
//     all", and `nova_rt_float_fixed` is Rust's `format!("{:.0}", v)`, an
//     exact fixed-precision conversion rather than a shortest-round-trip
//     one. `float_fixed(-9223372036854775808.0, 0)` is
//     `"-9223372036854775808"`, the exact value. This is used ONLY for
//     the digits, never for the shape check above it -- `float_fixed`
//     ROUNDS a fraction rather than reporting one
//     (`float_fixed(3.5, 0)` is `"4"`), which would silently turn the
//     fraction rule above into the very truncation it rejects, if this
//     text were the one checked for a `.`.
impl FromJson for Int {
    fn from_json(v: JsonValue) -> Result<Int, JsonError> {
        match v {
            Number(n) => {
                if n < -9223372036854775808.0 || n >= 9223372036854775808.0 {
                    Err(JsonError { msg: "integer out of range", at: 0 })
                } else if parse_decimal_int("${n}").is_none() {
                    Err(JsonError { msg: "expected an integer", at: 0 })
                } else {
                    match parse_decimal_int(float_fixed(n, 0)) {
                        Some(i) => Ok(i)
                        None => Err(JsonError { msg: "expected an integer", at: 0 })
                    }
                }
            }
            _ => Err(JsonError { msg: "expected a number", at: 0 })
        }
    }
}

// `s`'s digits as an `Int`, or `None` if any character once an optional
// leading `-` is consumed is not `0`-`9`, or if there are no digits at all
// (an empty string, or a bare `"-"`). `from_json` above calls this twice,
// on two different texts of the same `Number` -- see its comment for why.
//
// Accumulates NEGATIVE throughout, even for a positive input, negating
// only once at the very end, rather than the more obvious positive
// accumulation negated only when `neg` is set.
//
// NOT because the positive form gives a wrong answer -- measured, not
// assumed: mutating this to positive accumulation changes not one output
// anywhere in the whole 44-target suite. The reason is `i64::MIN`'s own
// magnitude, `9223372036854775808`, being one past `i64::MAX`: a positive
// running total reaches exactly `2^63` on that value's last digit, wraps
// once there, and wraps a second time negating the wrapped result, and
// Nova's `Int` wraps CONSISTENTLY (mod `2^64`, the same arithmetic
// `std/core`'s `mix64` documents for `*`) -- so the two wraps cancel and
// the final value comes out correct either way.
//
// Negative accumulation is used anyway because its correctness does not
// need that cancellation argument at all: every partial sum stays
// DIRECTLY representable at every step, for `i64::MIN` and for everything
// smaller in magnitude, with no appeal to wraparound anywhere in the
// reasoning. "Everything smaller in magnitude" is the whole of what this
// function is ever asked to parse, but that is an invariant of its ONE
// caller, not of this function by itself: `from_json` above rejects any
// `n` outside `i64::MIN..=i64::MAX` by comparing the `Float` itself,
// before either text this function walks is ever built. This function
// does not repeat that check -- it has no way to, from a `String` alone,
// without re-deriving the same comparison from the digits it is still in
// the middle of reading -- so it stays correct for a magnitude its
// caller has already ruled out, by cancellation, for exactly the reason
// measured above; it would not stay correct for a magnitude past that,
// which is why the bound check in `from_json` is load-bearing and this
// accumulation direction, on its own, is not a substitute for it.
fn parse_decimal_int(s: String) -> Option<Int> {
    let cs = s.chars()
    let mut i = 0
    let mut neg = false
    if cs.len() > 0 && cs[0] == '-' {
        neg = true
        i = 1
    }
    if i >= cs.len() { return None }
    let mut v = 0
    while i < cs.len() {
        if !is_digit(cs[i]) { return None }
        v = v * 10 - (char_to_int(cs[i]) - 48)
        i = i + 1
    }
    if neg { Some(v) } else { Some(-v) }
}
