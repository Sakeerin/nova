// Nova standard library -- JSON.
//
// `nova-spec/20-STDLIB.md` section 7's type declaration compiles verbatim,
// including the variant names that shadow builtin type names. Measured, not
// assumed: `Bool(Bool)` and `String(String)` are accepted and `match` binds
// them unqualified.

pub type JsonValue =
    | Null
    | Bool(Bool)
    | Number(Float)
    | String(String)
    | Array([JsonValue])
    | Object(Map<String, JsonValue>)

// `at` is a character index into the input, not a byte offset -- the parser
// walks `[Char]`.
pub record JsonError { msg: String, at: Int }

// Render `v` as JSON text. Total: there is no input this cannot render.
pub fn stringify(v: JsonValue) -> String {
    match v {
        Null => "null"
        Bool(b) => if b { "true" } else { "false" }
        Number(n) => number_to_json(n)
        String(s) => quote(s)
        Array(xs) => {
            let mut out = "["
            let mut i = 0
            while i < xs.len() {
                if i > 0 { out = "${out}," }
                out = "${out}${stringify(xs[i])}"
                i = i + 1
            }
            "${out}]"
        }
        Object(m) => {
            let ks = m.keys()
            let mut out = "{"
            let mut i = 0
            while i < ks.len() {
                if i > 0 { out = "${out}," }
                match m.get(ks[i]) {
                    Some(val) => out = "${out}${quote(ks[i])}:${stringify(val)}"
                    None => out = out
                }
                i = i + 1
            }
            "${out}}"
        }
    }
}

// JSON has no NaN and no infinity, so a non-finite number cannot be rendered.
// This emits `null` instead, which is what most codecs do and which keeps
// `stringify` total and its output always valid JSON. It is DELIBERATELY LOSSY:
// a round trip through a non-finite number does not preserve it.
//
// `n - n != 0.0` is the finiteness test. For any finite `n` the difference is
// exactly zero; for either infinity it is NaN, and for NaN it is NaN, and NaN
// compares unequal to everything including itself. This avoids needing an
// `is_nan` the standard library does not have.
fn number_to_json(n: Float) -> String {
    if n - n != 0.0 { "null" } else { "${n}" }
}

// Escape `s` as a JSON string literal, quotes included. `char_to_int` is how
// this reaches a character's scalar value -- it is `STD_ONLY`, which is why
// this helper lives here rather than in a fixture.
fn quote(s: String) -> String {
    let cs = s.chars()
    let mut out = "\""
    let mut i = 0
    while i < cs.len() {
        let c = cs[i]
        let code = char_to_int(c)
        if c == '"' {
            out = "${out}\\\""
        } else {
            if c == '\\' {
                out = "${out}\\\\"
            } else {
                if code < 32 {
                    out = "${out}${escape_control(code)}"
                } else {
                    out = "${out}${c}"
                }
            }
        }
        i = i + 1
    }
    "${out}\""
}

// One hex digit, lowercase, for a nibble in `0..16`. Nova has no formatting
// width primitive, so `escape_control` builds `\u00XX` two characters at a
// time through this.
fn hex_digit(n: Int) -> String {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else if n == 10 { "a" }
    else if n == 11 { "b" }
    else if n == 12 { "c" }
    else if n == 13 { "d" }
    else if n == 14 { "e" }
    else { "f" }
}

// RFC 8259 requires every control character below `0x20` escaped. Five have
// a named short escape; every other one falls back to `\u00XX`, which is
// always exactly two hex digits because `code` is below `0x20`.
fn escape_control(code: Int) -> String {
    if code == 10 { "\\n" }
    else if code == 13 { "\\r" }
    else if code == 9 { "\\t" }
    else if code == 8 { "\\b" }
    else if code == 12 { "\\f" }
    else {
        let hi = code / 16
        let lo = code % 16
        "\\u00${hex_digit(hi)}${hex_digit(lo)}"
    }
}

// Parse `s` as JSON. `JsonError::at` is a character index -- a count of Unicode
// scalar values, matching the `[Char]` the parser walks.
//
// A JSON text is ONE value, so trailing content is an error rather than a
// stopping point: `parse` skips whitespace, parses a single value, skips
// whitespace again, and rejects anything left over.
//
// It is deliberate that the trailing-content check runs even when the value
// walk has already failed: it is the second caller of `fail` that makes
// `fail`'s first-failure-wins guard observable, and so the thing that keeps
// that guard tested rather than merely written. `err` is then inspected ONCE,
// here, which is the whole point of carrying the failure in a field.
pub fn parse(s: String) -> Result<JsonValue, JsonError> {
    let mut p = P { cs: s.chars(), pos: 0, err: None }
    p.skip_ws()
    let v = p.parse_value()
    p.skip_ws()
    if !p.at_end() { p.fail("trailing content") }
    match p.err {
        Some(e) => Err(e)
        None => Ok(v)
    }
}

// The parser carries its failure in a field instead of returning `Result` at
// every level. Nova has no `?` operator -- measured against this compiler, not
// assumed: `?` parses and then typeck rejects it with
// `error[E0900]: the `?` operator are not supported yet` -- so threading a
// `Result` through a recursive descent would cost a `match` at every call site
// and bury the grammar in plumbing.
//
// `err` is set at most once: the FIRST failure wins, so a downstream symptom
// cannot overwrite the real cause. Every step that could read past the end
// checks `err` first and no-ops, returning `Null` -- after a failure the
// remaining walk is inert rather than wrong.
record P { cs: [Char], pos: Int, err: Option<JsonError> }

impl P {
    // Record a failure at the cursor, unless one is already recorded.
    //
    // The guard IS "first failure wins". `parse` runs its trailing-content
    // check even after the scanner has failed, so without the guard that check
    // would overwrite the real cause with a consequence of it: `+1` would
    // report trailing content rather than the missing digit that stopped the
    // scanner at position 0.
    fn fail(mut self, m: String) {
        if self.err.is_none() {
            self.err = Some(JsonError { msg: m, at: self.pos })
        }
    }

    fn at_end(self) -> Bool { self.pos >= self.cs.len() }

    // The character at the cursor, or `'\0'` past the end.
    //
    // `'\0'` is a sentinel, not a distinguished value: a real NUL in the input
    // reads identically here. That is harmless, because NUL appears in no JSON
    // token -- it is legal only inside a string literal, and RFC 8259 requires
    // even that one escaped -- so every caller that meets a NUL rejects it,
    // exactly as it rejects the end of the input. A caller that needs the two
    // told apart asks `at_end` instead.
    fn peek(self) -> Char {
        if self.at_end() { '\0' } else { self.cs[self.pos] }
    }

    // Advance one character, never past the end, so `pos` stays a valid bound
    // for `span` below. Every caller in this module bumps only after `peek`
    // returned a real character, so today the guard is defensive rather than
    // load-bearing; it is written so that a scanner looping on `bump` cannot
    // walk off the array.
    fn bump(mut self) {
        if !self.at_end() { self.pos = self.pos + 1 }
    }

    // Characters `start..end` as a `String`, `end` exclusive.
    //
    // `std/strings` runs the same algorithm over a plain `[Char]`
    // (`chars_to_string`), but it is private to that module and Nova has no
    // cross-module access to a private item, so these five lines are a
    // deliberate duplication rather than an oversight. `[' '; n]` needs a
    // filler and a repeat literal is the only way to allocate a runtime-length
    // array; every slot is overwritten immediately below, so the space never
    // survives.
    //
    // NEITHER half of the `n <= 0` guard is reachable today -- for a stronger
    // reason than in `chars_to_string`, whose note on exactly this guard the
    // duplication above had dropped. `scan_number` is this helper's only
    // caller, `pos` never moves backwards, and the call site sits past at least
    // one consumed digit, so `n` is always 1 or more. Kept for the reason
    // `chars_to_string` keeps it: a future caller of this module-private helper
    // may not bound its own span as carefully. At `n == 0` the general path
    // would return "" unaided anyway, so that half only skips an allocation --
    // measured, not assumed: `[' '; 0]` is a legal repeat literal of length 0,
    // the `0..0` loop is vacuous, and `nova_rt_str_from_chars` of an empty
    // array builds an empty `String`.
    fn span(self, start: Int, end: Int) -> String {
        let n = end - start
        if n <= 0 { return "" }
        let mut out = [' '; n]
        for i in 0..n { out[i] = self.cs[start + i] }
        str_from_chars(out)
    }

    // Skip JSON's whitespace: space, horizontal tab, line feed, carriage
    // return. THAT IS THE ENTIRE SET -- RFC 8259 permits no others, so a
    // vertical tab, a form feed or a non-breaking space is a syntax error and
    // must not be skipped here.
    fn skip_ws(mut self) {
        let mut going = true
        while going {
            let c = self.peek()
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                self.bump()
            } else {
                going = false
            }
        }
    }

    // A JSON number: `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`.
    //
    // Validates by walking characters, then slices the matched span and hands
    // it to `str_to_float`. Validating FIRST is what makes that intrinsic's
    // `0.0`-on-rejection fallback unreachable: every span reaching it is a text
    // Rust's `f64` parser also accepts, since Rust's accepted grammar is a
    // superset of the one above.
    //
    // A magnitude no `Float` can hold is ACCEPTED, not rejected: JSON's grammar
    // sets no range, and Rust's parser saturates rather than failing. Measured
    // against this compiler: `1e999` parses to infinity, which `stringify` then
    // renders `null` via `number_to_json`'s non-finite branch, and `1e-999`
    // parses to `0`. Both are lossy round trips. No fixture pins either -- they
    // are recorded here as measured behaviour, not as tested behaviour.
    //
    // Each rejection is a shape JSON forbids that a laxer reader would take:
    // a leading zero followed by a digit (`01` is two tokens, not one number),
    // a `.` with no digit after it, and an exponent with no digits.
    //
    // `+1` and `.5` never arrive here. `parse_value` dispatches to this scanner
    // only on `-` or a digit, so neither a leading `+` (only `-` is a sign) nor
    // a bare `.` gets past the dispatch, and both are reported there as
    // `expected a value` instead. What still reaches the `expected a digit`
    // branch below is a `-` with no digit after it, which is the `-` case in
    // `json_parse_numbers.nova`.
    fn scan_number(mut self) -> JsonValue {
        if self.err.is_some() { return Null }
        let start = self.pos
        if self.peek() == '-' { self.bump() }
        if self.peek() == '0' {
            self.bump()
            if is_digit(self.peek()) {
                self.fail("a leading zero cannot be followed by another digit")
                return Null
            }
        } else if is_digit(self.peek()) {
            while is_digit(self.peek()) { self.bump() }
        } else {
            self.fail("expected a digit")
            return Null
        }
        if self.peek() == '.' {
            self.bump()
            if !is_digit(self.peek()) {
                self.fail("expected a digit after the decimal point")
                return Null
            }
            while is_digit(self.peek()) { self.bump() }
        }
        if self.peek() == 'e' || self.peek() == 'E' {
            self.bump()
            if self.peek() == '+' || self.peek() == '-' { self.bump() }
            if !is_digit(self.peek()) {
                self.fail("expected a digit in the exponent")
                return Null
            }
            while is_digit(self.peek()) { self.bump() }
        }
        Number(str_to_float(self.span(start, self.pos)))
    }

    // One JSON value, dispatched on the character at the cursor.
    //
    // The dispatch is unambiguous because JSON's six value kinds start on
    // disjoint character sets -- seven of them, since `true` and `false` are one
    // kind on two letters: `n`, `t`, `f`, `"`, `[`, `{`, and `-` or a digit.
    // Anything else is not the start of a value, which is where a leading `+`, a
    // bare `.`, a stray `]` and an empty input all land.
    //
    // `n`/`t`/`f` hand off to `keyword`, which matches the WHOLE spelling.
    // Dispatching on the first letter and then consuming a fixed count would
    // read `nxxx` as `null`.
    fn parse_value(mut self) -> JsonValue {
        if self.err.is_some() { return Null }
        let c = self.peek()
        if c == 'n' { return self.keyword("null", Null) }
        if c == 't' { return self.keyword("true", Bool(true)) }
        if c == 'f' { return self.keyword("false", Bool(false)) }
        if c == '"' {
            let s = self.scan_str()
            return String(s)
        }
        if c == '[' { return self.scan_array() }
        if c == '{' { return self.scan_object() }
        if c == '-' || is_digit(c) { return self.scan_number() }
        self.fail("expected a value")
        Null
    }

    // A literal name -- `null`, `true` or `false` -- matched character by
    // character against `word`, returning `v` only if all of it is there.
    //
    // The mismatch is reported AT the offending character rather than at the
    // start of the name, so `nul` fails at 3 (where the fourth character should
    // be) and not at 0.
    fn keyword(mut self, word: String, v: JsonValue) -> JsonValue {
        let ws = word.chars()
        let mut i = 0
        while i < ws.len() {
            if self.peek() != ws[i] {
                self.fail("expected ${word}")
                return Null
            }
            self.bump()
            i = i + 1
        }
        v
    }

    // A JSON array, cursor on `[`.
    //
    // The empty array is checked BEFORE the element loop, which is what makes
    // `[]` legal while `[1,]` and `[,1]` are not: once the loop is entered, a
    // value is required, because RFC 8259's `array` repetition ends on a value
    // and never on a separator.
    fn scan_array(mut self) -> JsonValue {
        self.bump()
        self.skip_ws()
        if self.peek() == ']' {
            self.bump()
            let empty: [JsonValue] = []
            return Array(empty)
        }
        let mut items: Vec<JsonValue> = Vec::new()
        let mut going = true
        while going {
            let v = self.parse_value()
            if self.err.is_some() { return Null }
            items.push(v)
            self.skip_ws()
            let c = self.peek()
            if c == ',' {
                self.bump()
                self.skip_ws()
            } else if c == ']' {
                self.bump()
                going = false
            } else {
                self.fail("expected ',' or ']' in an array")
                return Null
            }
        }
        Array(vec_to_array(items))
    }

    // A JSON object, cursor on `{`.
    //
    // Mirrors `scan_array`, with a member in place of a value. The key check is
    // explicit here rather than left to `scan_str`, so a missing key reports
    // `expected an object key` -- RFC 8259 admits only a `string` as a member
    // name, so `{a:1}` is an error and not a laxer reader's bare word.
    //
    // A repeated key keeps the LAST value, because `Map::insert` replaces.
    // RFC 8259 section 4 sanctions no particular choice -- it calls the
    // behaviour of a non-unique name "unpredictable" and observes that many
    // implementations report the last pair only -- so this is a decision, not a
    // requirement, and `json_parse_values.nova`'s `duplicate key` case pins it.
    fn scan_object(mut self) -> JsonValue {
        self.bump()
        self.skip_ws()
        let mut m: Map<String, JsonValue> = Map::new()
        if self.peek() == '}' {
            self.bump()
            return Object(m)
        }
        let mut going = true
        while going {
            if self.peek() != '"' {
                self.fail("expected an object key")
                return Null
            }
            let k = self.scan_str()
            if self.err.is_some() { return Null }
            self.skip_ws()
            if self.peek() != ':' {
                self.fail("expected ':' after an object key")
                return Null
            }
            self.bump()
            self.skip_ws()
            let v = self.parse_value()
            if self.err.is_some() { return Null }
            m.insert(k, v)
            self.skip_ws()
            let c = self.peek()
            if c == ',' {
                self.bump()
                self.skip_ws()
            } else if c == '}' {
                self.bump()
                going = false
            } else {
                self.fail("expected ',' or '}' in an object")
                return Null
            }
        }
        Object(m)
    }

    // A JSON string literal, cursor on the opening `"`. Returns the DECODED
    // contents, with every escape resolved; on failure `err` is set and the
    // return value is `""` rather than meaningful.
    //
    // The three arms are exactly RFC 8259's `char`: a closing quote ends the
    // literal, a backslash starts an escape, and anything else is `unescaped`
    // -- which the grammar defines as `%x20-21 / %x23-5B / %x5D-10FFFF`. That
    // range starts at `0x20`, so a raw character below it is a SYNTAX ERROR and
    // not a character to pass through: tab and line feed are legal whitespace
    // BETWEEN tokens and still illegal unescaped inside a string. Note the
    // range runs to `10FFFF` with no upper exclusion, so `0x7f` (DEL) is
    // ordinary text here and needs no escape.
    //
    // The `peek() != '"'` guard is defensive rather than load-bearing today:
    // `parse_value` dispatches here only on `"`, and `scan_object` checks for
    // one itself. It is kept for the reason `bump`'s bounds guard is -- a
    // future caller may not position the cursor as carefully.
    //
    // `out` is rebuilt by interpolation on every character, which is quadratic
    // in the literal's length. That is the same shape `quote` uses in the other
    // direction, and Nova has no growable string buffer to do better with; it
    // is recorded here as a known cost, not as a claim that it does not matter.
    // A `span`-style slice cannot replace it, because an escape means the
    // decoded text is not a contiguous run of the input.
    fn scan_str(mut self) -> String {
        if self.err.is_some() { return "" }
        if self.peek() != '"' {
            self.fail("expected a string")
            return ""
        }
        self.bump()
        let mut out = ""
        while true {
            if self.at_end() {
                self.fail("unterminated string")
                return ""
            }
            let c = self.peek()
            if c == '"' {
                self.bump()
                return out
            }
            if c == '\\' {
                self.bump()
                let piece = self.scan_escape()
                if self.err.is_some() { return "" }
                out = "${out}${piece}"
            } else if char_to_int(c) < 32 {
                self.fail("a control character must be escaped")
                return ""
            } else {
                self.bump()
                out = "${out}${c}"
            }
        }
        out
    }

    // What one escape decodes to, cursor on the character AFTER the backslash.
    //
    // RFC 8259 allows exactly nine forms after a backslash, and a backslash
    // followed by anything else is an error -- there is no "unknown escapes
    // pass through" rule. The cursor is not advanced before the failure, so
    // `at` points at the offending character rather than past it.
    fn scan_escape(mut self) -> String {
        if self.at_end() {
            self.fail("unterminated string")
            return ""
        }
        let e = self.peek()
        if e == 'u' {
            self.bump()
            return self.scan_hex_escape()
        }
        match simple_escape(e) {
            Some(s) => {
                self.bump()
                s
            }
            None => {
                self.fail("unknown escape")
                ""
            }
        }
    }

    // `\uXXXX`, cursor just past the `u`, and the surrogate pairing RFC 8259
    // section 7 requires for anything above the BMP.
    //
    // There is NO Int-to-`Char` conversion in Nova, so this cannot build a
    // `Char` from a code point. It encodes the code point to UTF-8 bytes here
    // and hands them to `Bytes::to_string`, whose `Option` is the validation:
    // `to_string` checks UTF-8 and returns `None`, so a code point that is not
    // a Unicode scalar value becomes a `JsonError` instead of garbage. That is
    // why no second intrinsic was added for this. The runtime's own
    // `nova_rt_char_to_str` would have been strictly worse -- its body is
    // `char::from_u32(v as u32).unwrap_or(char::REPLACEMENT_CHARACTER)`, so it
    // silently substitutes U+FFFD for exactly the inputs that must be rejected.
    //
    // The `None` arm is therefore a SECOND line of defence, not a redundant
    // one: the explicit surrogate checks above it make every code point that
    // reaches the encoder a scalar value, so the arm cannot fire as written.
    // Deleting the LONE-SURROGATE rejection makes it fire -- measured, not
    // assumed: with that check gone, `"\udc00"` reports `an escape is not a
    // valid code point`, because a lone surrogate encodes to a three-byte
    // sequence Rust's `str::from_utf8` rejects. So the error survives the loss
    // of that check, and only its message changes.
    //
    // Deleting the LOW-SURROGATE RANGE check does NOT reach that arm, and the
    // asymmetry is why both checks are here rather than one. The
    // `high surrogate then a non-surrogate escape` case in
    // `json_parse_strings.nova` -- a high surrogate followed by an escape whose
    // value is `0x41` -- then combines to `0x11841`, a perfectly ordinary
    // character, so that input is silently ACCEPTED instead of rejected.
    // Measured on its own, with the check above this one left in place.
    fn scan_hex_escape(mut self) -> String {
        let hi = self.scan_hex4()
        if self.err.is_some() { return "" }
        if hi >= 0xDC00 && hi <= 0xDFFF {
            self.fail("a low surrogate must follow a high surrogate")
            return ""
        }
        let mut cp = hi
        if hi >= 0xD800 && hi <= 0xDBFF {
            if self.peek() != '\\' {
                self.fail("a high surrogate must be followed by a low surrogate")
                return ""
            }
            self.bump()
            if self.peek() != 'u' {
                self.fail("a high surrogate must be followed by a low surrogate")
                return ""
            }
            self.bump()
            let lo = self.scan_hex4()
            if self.err.is_some() { return "" }
            if lo < 0xDC00 || lo > 0xDFFF {
                self.fail("expected a low surrogate")
                return ""
            }
            cp = 0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00)
        }
        match bytes_from_ints(utf8_bytes(cp)).to_string() {
            Some(s) => s
            None => {
                self.fail("an escape is not a valid code point")
                ""
            }
        }
    }

    // Exactly four hexadecimal digits, as an `Int`. FOUR is the grammar's own
    // count (`%x75 4HEXDIG`), not a convenience: reading fewer would leave the
    // remaining digits to be taken as literal text, and reading more would
    // swallow the character after the escape.
    //
    // A non-hex character stops this, and so does the end of the input, since
    // `peek`'s past-the-end `'\0'` is not a hexadecimal digit.
    fn scan_hex4(mut self) -> Int {
        let mut v = 0
        let mut i = 0
        while i < 4 {
            let d = hex_value(self.peek())
            if d < 0 {
                self.fail("expected four hexadecimal digits")
                return 0
            }
            v = v * 16 + d
            self.bump()
            i = i + 1
        }
        v
    }
}

// An ASCII digit. `Char` admits `<=` and `>=` directly (`impl Ord for Char` in
// `std/core` is built on `<`), so this needs no conversion to `Int` -- which
// also keeps the past-the-end sentinel `'\0'` a non-digit for free.
fn is_digit(c: Char) -> Bool { c >= '0' && c <= '9' }

// One hexadecimal digit's value, or `-1` for anything that is not one. `-1`
// rather than `Option<Int>` because the single caller is a four-iteration loop
// and an `Option` there buys a `match` per digit and nothing else.
//
// The offsets are the ASCII arithmetic: `'0'` is 48, `'a'` is 97 and 97 - 87 is
// 10, `'A'` is 65 and 65 - 55 is 10. Both letter cases are accepted because RFC
// 8259's `HEXDIG` is `DIGIT / "A" / ... / "F"` under ABNF's case-insensitive
// rule for literals.
fn hex_value(c: Char) -> Int {
    if c >= '0' && c <= '9' { return char_to_int(c) - 48 }
    if c >= 'a' && c <= 'f' { return char_to_int(c) - 87 }
    if c >= 'A' && c <= 'F' { return char_to_int(c) - 55 }
    // `return`, not a bare `-1`: after the `if` block above, a statement
    // starting `-` parses as SUBTRACTION from that block's value. Measured.
    return -1
}

// `cp` encoded as UTF-8, one `Int` per byte. The four length classes are UTF-8's
// own: `0..0x80` in one byte, `0x80..0x800` in two, `0x800..0x10000` in three,
// and the rest in four.
//
// Nova has no `Char` built from an `Int`, so this is the only route from a
// `\uXXXX` code point to a `String`, via `bytes_from_ints` and
// `Bytes::to_string`.
//
// The out-of-range guard returns `0xFF`, which is not a legal UTF-8 byte in any
// position, so such a code point becomes a `to_string` failure at the call site
// rather than a mangled character. It is UNREACHABLE as written -- four
// hexadecimal digits cannot exceed `0xFFFF`, four of them cannot be negative,
// and the surrogate combine's own maximum is `0x10000 + 0x3FF * 0x400 + 0x3FF`,
// which is exactly `0x10FFFF`.
//
// It is here because the two arms it shields are the only expressions below
// whose result is not bounded to `0..=255` by construction: `[cp]` for a
// NEGATIVE `cp`, and the four-byte lead `0xF0 | (cp >> 18)` for an oversized
// one. Every other byte is masked or has a bounded input -- `0xC0 | (cp >> 6)`
// tops out at `0xDF`, `0xE0 | (cp >> 12)` at `0xEF`, and a continuation byte at
// `0xBF`. And the shielding matters because `bytes_from_ints` ABORTS the process
// on an element outside `0..=255` rather than returning an error.
fn utf8_bytes(cp: Int) -> [Int] {
    if cp < 0 || cp > 0x10FFFF { return [0xFF] }
    if cp < 0x80 { return [cp] }
    if cp < 0x800 { return [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)] }
    if cp < 0x10000 {
        return [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
    }
    // `return`, not a bare trailing expression: after the `if` block above, a
    // statement starting `[` parses as an INDEX into that block's value and
    // fails on the first comma. Measured, not stylistic.
    return [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
}

// A `Vec` copied into the plain `[JsonValue]` that `Array` holds.
//
// `scan_array` collects into a `Vec` because it cannot know the element count
// before it has parsed them, and this is the one-way conversion out. `Null` is
// the repeat literal's filler -- every slot is overwritten below, so it never
// survives, and `JsonValue` having a nullary variant is why this needs no
// `Default` bound.
//
// `unwrap_or(Null)` cannot take its default: `i` runs strictly below `v.len()`,
// which is exactly the range `Vec::get` answers with `Some`.
fn vec_to_array(v: Vec<JsonValue>) -> [JsonValue] {
    let n = v.len()
    let mut out = [Null; n]
    let mut i = 0
    while i < n {
        out[i] = v.get(i).unwrap_or(Null)
        i = i + 1
    }
    out
}

// The eight one-letter escapes of RFC 8259 section 7, or `None` for any other
// character after a backslash. `\u` is deliberately absent: it consumes four
// more characters and so needs the cursor, which a free function does not have.
//
// `\b` and `\f` are written as string `\u{...}` escapes because Nova's CHAR
// literal admits only `\n \t \r \\ \' \0` -- measured against this compiler:
// anything else falls through `lex_char`'s `_ => None`, so `'\u{0C}'` does not
// lex at all, while the string lexer's own `\u{...}` does.
fn simple_escape(c: Char) -> Option<String> {
    if c == '"' { return Some("\"") }
    if c == '\\' { return Some("\\") }
    if c == '/' { return Some("/") }
    if c == 'b' { return Some("\u{08}") }
    if c == 'f' { return Some("\u{0C}") }
    if c == 'n' { return Some("\n") }
    if c == 'r' { return Some("\r") }
    if c == 't' { return Some("\t") }
    None
}
