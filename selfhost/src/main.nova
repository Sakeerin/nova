// N, the self-hosted Nova compiler, so far its lexer, its parser, its
// loader of programs and packages, its resolver and its type checker (spec
// docs/superpowers/specs/2026-10-30-phase-5-1-the-lexer-the-parser-and-the-ast-design.md
// §3.2 and §4.3, ADR 0051 and ADR 0052; spec
// docs/superpowers/specs/2026-11-02-phase-5-2-the-loader-and-the-resolver-design.md
// §3.4 and §4, ADRs 0053 and 0054; spec
// docs/superpowers/specs/2026-11-06-phase-5-3-the-type-checker-and-hir-design.md
// §3 and §4, ADRs 0055 and 0056).
//
//   selfhost tokens FILE...   prints each file's token dump, after a header
//                             line `== FILE`, as `nova parse --dump-tokens`
//                             does
//   selfhost ast FILE...      prints each file's AST dump, its tree and its
//                             errors, after the same header, as
//                             `nova parse --dump-ast` does
//   selfhost resolve --std DIR [--target native|wasm] [--test] FILE...
//                             prints the resolution dump of each program
//                             whose root is FILE, after the same header,
//                             as `nova check --dump-resolution` does, with
//                             std's modules read from DIR once: a loose
//                             program, or a module of the package whose
//                             `src/` or `tests/` FILE is directly in; for
//                             the WASM target, or under test mode (`nova
//                             test`'s resolution)
//   selfhost resolve --std DIR [--target native|wasm] [--test] --std-part
//                             prints std's part, as `nova check
//                             --dump-resolution --std` does
//   selfhost hir --std DIR [--target native|wasm] [--test] FILE...
//   selfhost hir --std DIR [--target native|wasm] [--test] --std-part
//                             the same, with the HIR dump, as `nova check
//                             --dump-hir` prints it: the type checker's
//                             item tables, std's collected once (§3.3,
//                             ADR 0055), then every function of the
//                             program, its body checked, std's bodies
//                             checked once (§4.3, §4.5, ADR 0056)
//   selfhost mir --std DIR [--before-async | --ll] FILE...
//                             prints the MIR dump of each program whose
//                             root is FILE, after the same header, as
//                             `nova check --dump-mir [--before-async |
//                             --ll]` does: natively, monomorphized from
//                             `main`, lowered and through the async
//                             transform, or before it with
//                             `--before-async`, std's checked functions
//                             spliced into each program (spec
//                             docs/superpowers/specs/2026-11-14-phase-5-4-mir-design.md
//                             §5, §6, ADR 0057); with `--ll`, each
//                             lowered root's `.ll` after its part (spec
//                             docs/superpowers/specs/2026-11-18-phase-5-5a-the-ll-emitter-design.md
//                             §4, §5)
//   selfhost build FILE [-o OUT] [--release] --std DIR
//                             builds FILE as S0's `nova build --release
//                             FILE -o OUT` does: its `.ll` written beside
//                             OUT, `clang` and `cc` run on it, and `built
//                             OUT` printed (spec
//                             docs/superpowers/specs/2026-11-19-phase-5-5b-the-driver-and-linking-design.md
//                             §3, driver.nova)
//
// A file with lex or parse errors is dumped with them, and the exit code
// stays 0. A file that cannot be read prints `IOERR` and its kind after its
// header; the rest are dumped, then the exit code is 2. No file is refused
// with the exit code 2 and nothing printed.

import ast_dump
import async_lower
import builtins
import diagnostic
import driver
import driver_tests
import dump
import emit_ll
import emit_ll_tests
import fixes
import hir
import hir_dump
import infer
import lexer
import lexer_tests
import loader
import loader_tests
import lower
import lower_call
import lower_match
import manifest
import mir
import mir_dump
import mir_tests
import mono
import parser_tests
import resolution_dump
import resolver
import resolver_tests
import splice
import token
import typeck
import typeck_body
import typeck_body_tests
import typeck_call
import typeck_closure
import typeck_expr
import typeck_for
import typeck_member_tests
import typeck_method
import typeck_pattern
import typeck_pattern_tests
import typeck_place
import typeck_tests
import typeck_traits
import typeck_ty
import typeck_view
import usefulness

async fn main() {
    let argv = args()
    let command = if argv.len() < 2 { "" } else { argv.at(1) }
    if command == "resolve" || command == "hir" {
        dump_command(argv, command).await
        return
    }
    if command == "mir" {
        mir_command(argv).await
        return
    }
    if command == "build" {
        build_command(argv).await
        return
    }
    // No file is refused, as S0's clap refuses it.
    let tokens = command == "tokens"
    if argv.len() < 3 || (!tokens && command != "ast") {
        eprintln("usage: selfhost tokens|ast FILE...")
        exit(2)
        return
    }
    let mut failed = false
    let mut i = 2
    while i < argv.len() {
        let path = argv.at(i)
        match read_to_string(path).await {
            Ok(source) => {
                let out = if tokens { dump_tokens(source) } else { dump_ast(source) }
                print("== ${path}\n${out}")
            }
            Err(e) => {
                print("== ${path}\nIOERR ${io_kind_name(e.kind)}\n")
                failed = true
            }
        }
        i += 1
    }
    if failed { exit(2) }
}

// `selfhost resolve --std DIR [--target native|wasm] [--test]
// (--std-part | FILE...)`: std's modules are read from DIR and parsed
// once, then std's part, or each program's part after its header, for
// the target, natively by default, under test mode with `--test`. Each
// option is taken once, and the target also as `--target=VALUE`, as
// clap takes it for S0. Without `--std DIR`, with a target other than
// `native` or `wasm`, or with neither `--std-part` nor a file, or with
// both, nothing is printed and the exit code is 2, as S0's `check
// --dump-resolution` gives; `--test` with `--target wasm` too, which S0
// refuses with one line, as `nova test` has no target. A root whose
// package's manifest N's reader refuses, or whose package graph would
// give an M-code, S0's alone, stops the run: N says why on stderr and
// exits 1, printing nothing of that root's part.
//
// `selfhost hir` takes the same arguments and refuses the same shapes, as
// S0's `check --dump-hir` shares `check --dump-resolution`'s parser, and
// prints the HIR dump in place of the resolution dump.
async fn dump_command(argv: Vec<String>, command: String) {
    let hir = command == "hir"
    let usage = "usage: selfhost ${command} --std DIR [--target native|wasm] [--test] (--std-part | FILE...)"
    let mut std_dir = ""
    let mut target_name = ""
    let mut target_given = false
    let mut test = false
    let mut std_part = false
    let mut bad = false
    let mut files: Vec<String> = Vec::new()
    let mut i = 2
    while i < argv.len() {
        let a = argv.at(i)
        if a.starts_with("--target=") {
            // `--target=VALUE`, as clap takes it for S0; an empty value or
            // a second `--target` is refused.
            if target_given { bad = true }
            target_given = true
            target_name = a.byte_slice(9, a.byte_len())
            if target_name == "" { bad = true }
            i += 1
            continue
        }
        if (a == "--std" || a == "--target") && i + 1 < argv.len() {
            let value = argv.at(i + 1)
            if a == "--std" {
                if std_dir != "" { bad = true }
                std_dir = value
            } else {
                if target_given { bad = true }
                target_given = true
                target_name = value
                if target_name == "" { bad = true }
            }
            i += 2
            continue
        }
        if a == "--std-part" {
            if std_part { bad = true }
            std_part = true
        } else if a == "--test" {
            if test { bad = true }
            test = true
        } else if a.starts_with("--test=") {
            // A flag takes no value, as clap refuses one for S0.
            bad = true
        } else if a == "--target" {
            bad = true
        } else {
            files.push(a)
        }
        i += 1
    }
    let target = if target_name == "wasm" { CompileTargetWasm } else { CompileTargetNative }
    if target_name != "" && target_name != "native" && target_name != "wasm" { bad = true }
    if bad || std_dir == "" || std_part == !files.is_empty() {
        eprintln(usage)
        exit(2)
        return
    }
    if test && target_name == "wasm" {
        eprintln("error: selfhost ${command} --test is native only, as nova test is")
        exit(2)
        return
    }
    let std_set = match load_std(std_dir, target, test).await {
        Ok(s) => s
        Err(message) => {
            eprintln(message)
            exit(2)
            return
        }
    }
    if std_part {
        let resolved = resolve_program_for(target, Vec::new(), std_set)
        if hir {
            let (labels, texts) = labels_and_texts(Vec::new(), std_set)
            let mut tables = check_items(resolved.items, resolved.definitions, labels, texts)
            tables.check_bodies(resolved.newline_splits)
            let mut diagnostics: Vec<Diagnostic> = Vec::new()
            for d in resolved.diagnostics.iter() { diagnostics.push(d) }
            for d in tables.diagnostics.iter() { diagnostics.push(d) }
            print(dump_hir_std(target, test, resolved, tables, diagnostics))
        } else {
            print(dump_std(target, test, resolved, std_set.builtins))
        }
        return
    }
    // std is resolved once, and every root reads it (ADR 0054 §9); for the
    // HIR dump std's items are collected once too, from the resolution of
    // a program of no module of its own (ADR 0055).
    let shared = share_std(target, std_set)
    let mut items: Option<SharedItems> = None
    if hir {
        let (labels, texts) = labels_and_texts(Vec::new(), std_set)
        let alone = shared.alone
        let s = share_items(alone.items, alone.definitions, labels, texts)
        if shared.shareable && s.shareable { items = Some(s) }
    }
    let mut failed = false
    for path in files.iter() {
        let dumped = if hir {
            dump_hir(path, target, test, shared, items).await
        } else {
            dump_resolution(path, target, test, shared).await
        }
        match dumped {
            DumpedText(out) => print("== ${path}\n${out}")
            DumpedIoError(e) => {
                print("== ${path}\nIOERR ${io_kind_name(e.kind)}\n")
                failed = true
            }
            DumpedRefused(why) => {
                eprintln("error: selfhost ${command} cannot dump ${path}: ${why}")
                exit(1)
                return
            }
        }
    }
    if failed { exit(2) }
}

// `selfhost mir --std DIR [--before-async | --ll] FILE...`: std's modules
// are read from DIR, parsed, resolved, their items collected and their
// bodies checked once, then each program's MIR dump after its header,
// natively, as S0's `check --dump-mir` prints it (spec 5.4 §6.3). Each
// option is taken once, and `--` before a root that starts with `-`. With
// no `--std DIR`, with a second `--std`, `--before-async` or `--ll`, with
// both `--before-async` and `--ll`, `--ll=…`, `--std-part`, `--target`,
// `--test` or another option, or with no file, nothing is printed and the
// exit code is 2, as S0's form refuses its shapes. The dump is after the
// async transform, or before it with `--before-async`; with `--ll`, each
// root that lowered has its `.ll` after its part (spec 5.5a §4).
// A root whose package's manifest N's reader refuses stops the run with
// the exit code 1, as `selfhost hir`.
async fn mir_command(argv: Vec<String>) {
    let usage = "usage: selfhost mir --std DIR [--before-async | --ll] FILE..."
    let mut std_dir = ""
    let mut before = false
    let mut ll = false
    let mut bad = false
    let mut only_files = false
    let mut files: Vec<String> = Vec::new()
    let mut i = 2
    while i < argv.len() {
        let a = argv.at(i)
        if only_files {
            files.push(a)
        } else if a == "--" {
            only_files = true
        } else if a == "--std" && i + 1 < argv.len() {
            if std_dir != "" { bad = true }
            std_dir = argv.at(i + 1)
            if std_dir == "" { bad = true }
            i += 1
        } else if a == "--before-async" {
            if before { bad = true }
            before = true
        } else if a == "--ll" {
            if ll { bad = true }
            ll = true
        } else if a.starts_with("-") {
            // `--std` with no value, `--std-part`, `--target`, `--test`,
            // `--before-async=…`, `--ll=…` and every other option.
            bad = true
        } else {
            files.push(a)
        }
        i += 1
    }
    if bad || std_dir == "" || files.is_empty() || (before && ll) {
        eprintln(usage)
        exit(2)
        return
    }
    let std_set = match load_std(std_dir, CompileTargetNative, false).await {
        Ok(s) => s
        Err(message) => {
            eprintln(message)
            exit(2)
            return
        }
    }
    // std is resolved once, its items collected and its bodies checked
    // once, and every root reads them (ADR 0055, ADR 0056); its checked
    // functions are spliced into each program (spec 5.4 §5).
    let shared = share_std(CompileTargetNative, std_set)
    let mut items: Option<SharedItems> = None
    let (labels, texts) = labels_and_texts(Vec::new(), std_set)
    let alone = shared.alone
    let s = share_items(alone.items, alone.definitions, labels, texts)
    if shared.shareable && s.shareable { items = Some(s) }
    let mut failed = false
    for path in files.iter() {
        match dump_mir(path, shared, items, before, ll).await {
            DumpedText(out) => print("== ${path}\n${out}")
            DumpedIoError(e) => {
                print("== ${path}\nIOERR ${io_kind_name(e.kind)}\n")
                failed = true
            }
            DumpedRefused(why) => {
                eprintln("error: selfhost mir cannot dump ${path}: ${why}")
                exit(1)
                return
            }
        }
    }
    if failed { exit(2) }
}

// The MIR dump of the program whose root is `path` (nova-driver's
// `MirDumps::dump`): a package's module that does not run, as `check`
// decides it (`Program::for_file_with`: a module of a package runs as its
// `src/main.nova` alone), is `runs=false`, before its root or manifests
// are read; otherwise `dump_hir`'s pipeline and check, shared when it can
// be and in full otherwise, and, when neither gave an error, the full
// check's module, std's functions spliced in, its entry `main` kept and
// the module lowered natively, through the async transform or, when
// `before`, before it; when `ll`, the lowered module's `.ll` after it.
async fn dump_mir(
    path: String,
    shared: SharedStd,
    items: Option<SharedItems>,
    before: Bool,
    ll: Bool,
) -> Dumped {
    let mut graph: Option<Graph> = None
    let mut kind = RootLoose
    match package_of(path).await {
        Some((dir, k)) => {
            let runs = match k {
                RootSrc => module_name(path) == "main"
                _ => false
            }
            if !runs { return DumpedText(dump_mir_program(ReachedNotRun)) }
            match read_graph(dir).await {
                Ok(g) => graph = Some(g)
                Err(why) => return DumpedRefused(why)
            }
            kind = k
        }
        None => ()
    }
    let load = match load_program(graph, path, kind).await {
        Ok(l) => l
        Err(e) => return DumpedIoError(e)
    }
    let modules = load.modules
    let mut failed = false
    for d in load.diagnostics.iter() { if d.is_error() { failed = true } }
    if failed { return DumpedText(dump_mir_program(ReachedNotChecked)) }
    strip_test_functions(modules, false)
    let mut sources: Vec<ModuleSource> = Vec::new()
    for m in modules.iter() {
        sources.push(
            ModuleSource {
                name: m.name,
                label: m.name,
                file: m.ast,
                imports: m.imports,
                text: Some(m.text),
                package: m.package,
                importable: m.importable,
            },
        )
    }
    if items.is_some() {
        match mir_of(sources, shared, items, before, ll) {
            Some(d) => return d
            None => ()
        }
    }
    mir_of(sources, shared, None, before, ll).unwrap()
}

// `dump_mir`'s part from the resolver on, as `hir_of`'s: with std's
// tables `items`, the program resolved with std's definitions after its
// own, its bodies alone checked and std's checked functions spliced in
// (`shared_module`); without, resolved and checked in full. An error
// before MIR is `checked=false`. `None` when the shared path cannot check
// the program, because it implements anything on a type it does not own,
// which the full path then checks (ADR 0056 §4). When `ll`, a module that
// lowered has its `.ll` part after its own (`ll_part`, spec 5.5a §4).
fn mir_of(
    sources: Vec<ModuleSource>,
    shared: SharedStd,
    items: Option<SharedItems>,
    before: Bool,
    ll: Bool,
) -> Option<Dumped> {
    let std_set = shared.std_set
    let resolved = match items {
        Some(_) => resolve_program_shared_for_check(sources, shared)
        None => resolve_program_for(CompileTargetNative, sources, std_set)
    }
    for d in resolved.diagnostics.iter() {
        if d.is_error() { return Some(DumpedText(dump_mir_program(ReachedNotChecked))) }
    }
    let (labels, texts) = labels_and_texts(sources, std_set)
    let mut tables = match items {
        Some(s) => check_items_shared(resolved.items, resolved.definitions, labels, texts, s)
        None => check_items(resolved.items, resolved.definitions, labels, texts)
    }
    if items.is_some() && tables.implements_on_a_type_it_does_not_own() { return None }
    tables.check_bodies(resolved.newline_splits)
    for d in tables.diagnostics.iter() {
        if d.is_error() { return Some(DumpedText(dump_mir_program(ReachedNotChecked))) }
    }
    let program = match items {
        Some(s) => shared_module(tables, s)
        None => full_module(tables)
    }
    keep_the_entry_main(program, resolved.definitions)
    let result = lower_module_with(program, before)
    let text = dump_mir_program(ReachedLowered(result, !before))
    if ll {
        match result {
            Ok(lowered) => return Some(DumpedText(text + ll_part(lowered)))
            Err(_) => ()
        }
    }
    Some(DumpedText(text))
}

// A lowered root's `.ll` part (nova-driver's `ll_part`, spec 5.5a §4):
// `(Ll ok)` and the emitter's text, or one line `(Ll error "…")` with the
// emitter's words, quoted as the dumps quote.
fn ll_part(program: MirModule) -> String {
    match compile_ir(program) {
        Ok(ir) => "(Ll ok)\n" + ir
        Err(e) => {
            let mut part = StringBuilder::new()
            part.push("(Ll error \"")
            push_escaped(part, e, true)
            part.push("\")\n")
            part.to_string()
        }
    }
}

// What `dump_resolution` gives for one root: its part; the error that
// kept its root from being read, `IOERR`; or why N refuses its package.
type Dumped = | DumpedText(String) | DumpedIoError(IoError) | DumpedRefused(String)

// The resolution dump of the program whose root is `path`
// (nova-driver's `ResolutionDumps::dump`): `check`'s pipeline up to the
// resolver, or under test mode `nova test`'s. A root directly in a
// package's `src/` or `tests/` is a module of that package, whose graph
// is read from the manifests first; any other root is a loose program.
// It loads the program, stops there on any error, strips the `@test`
// functions, but under test mode the root package's and a loose
// program's, and resolves; under test mode a `tests/` file's tests are
// named for it; the resolver reads std resolved once (`SharedStd`). The
// dump holds what was built and every diagnostic so far.
async fn dump_resolution(
    path: String,
    target: CompileTarget,
    test: Bool,
    shared: SharedStd,
) -> Dumped {
    let std_set = shared.std_set
    let mut graph: Option<Graph> = None
    let mut kind = RootLoose
    match package_of(path).await {
        Some((dir, k)) => {
            match read_graph(dir).await {
                Ok(g) => graph = Some(g)
                Err(why) => return DumpedRefused(why)
            }
            kind = k
        }
        None => ()
    }
    let load = match load_program(graph, path, kind).await {
        Ok(l) => l
        Err(e) => return DumpedIoError(e)
    }
    let modules = load.modules
    let mut diagnostics = load.diagnostics
    let mut failed = false
    for d in diagnostics.iter() { if d.is_error() { failed = true } }
    if !failed { strip_test_functions(modules, test) }
    let mut sources: Vec<ModuleSource> = Vec::new()
    for m in modules.iter() {
        sources.push(
            ModuleSource {
                name: m.name,
                label: m.name,
                file: m.ast,
                imports: m.imports,
                text: Some(m.text),
                package: m.package,
                importable: m.importable,
            },
        )
    }
    if failed {
        return DumpedText(dump_program(target, test, sources, None, diagnostics, std_set.builtins))
    }
    let resolved = resolve_program_shared(sources, shared)
    name_tests(resolved.tests, resolved.definitions, modules)
    for d in resolved.diagnostics.iter() { diagnostics.push(d) }
    DumpedText(dump_program(target, test, sources, Some(resolved), diagnostics, std_set.builtins))
}

// The HIR dump of the program whose root is `path` (nova-driver's
// `HirDumps::dump`): `dump_resolution`'s pipeline, then, when it stopped
// on no error, the type checker's item passes, then the program's bodies.
// With std's tables `items`,
// the program is resolved with std's definitions after its own and reads
// std's tables rebased past them; without, because std alone gave a
// diagnostic or holds a test, it is resolved and checked in full, as
// `check` does. The dump holds the item tables and every diagnostic so
// far, or, for a program that stopped before the type checker,
// `checked=false` and the diagnostics.
async fn dump_hir(
    path: String,
    target: CompileTarget,
    test: Bool,
    shared: SharedStd,
    items: Option<SharedItems>,
) -> Dumped {
    let std_set = shared.std_set
    let mut graph: Option<Graph> = None
    let mut kind = RootLoose
    match package_of(path).await {
        Some((dir, k)) => {
            match read_graph(dir).await {
                Ok(g) => graph = Some(g)
                Err(why) => return DumpedRefused(why)
            }
            kind = k
        }
        None => ()
    }
    let load = match load_program(graph, path, kind).await {
        Ok(l) => l
        Err(e) => return DumpedIoError(e)
    }
    let modules = load.modules
    let mut diagnostics = load.diagnostics
    let mut failed = false
    for d in diagnostics.iter() { if d.is_error() { failed = true } }
    if !failed { strip_test_functions(modules, test) }
    let mut sources: Vec<ModuleSource> = Vec::new()
    for m in modules.iter() {
        sources.push(
            ModuleSource {
                name: m.name,
                label: m.name,
                file: m.ast,
                imports: m.imports,
                text: Some(m.text),
                package: m.package,
                importable: m.importable,
            },
        )
    }
    if failed { return DumpedText(dump_hir_program(target, test, None, diagnostics)) }
    if items.is_some() {
        match hir_of(target, test, sources, modules, shared, items, diagnostics) {
            Some(d) => return d
            None => ()
        }
    }
    hir_of(target, test, sources, modules, shared, None, diagnostics).unwrap()
}

// `dump_hir`'s part from the resolver on, the loader's diagnostics
// `load_diagnostics`: with std's tables `items`, the program resolved with
// std's definitions after its own, reading std's tables rebased past them,
// and its bodies alone checked, std's being std's part; without, resolved
// and checked in full, as `check` does, std's bodies too. `None` when the
// shared path cannot check the program, because it implements anything on
// a type it does not own, which the full path then checks (ADR 0056 §4).
fn hir_of(
    target: CompileTarget,
    test: Bool,
    sources: Vec<ModuleSource>,
    modules: Vec<Loaded>,
    shared: SharedStd,
    items: Option<SharedItems>,
    load_diagnostics: Vec<Diagnostic>,
) -> Option<Dumped> {
    let std_set = shared.std_set
    let mut diagnostics: Vec<Diagnostic> = Vec::new()
    for d in load_diagnostics.iter() { diagnostics.push(d) }
    let resolved = match items {
        Some(_) => resolve_program_shared_for_check(sources, shared)
        None => resolve_program_for(target, sources, std_set)
    }
    name_tests(resolved.tests, resolved.definitions, modules)
    let mut failed = false
    for d in resolved.diagnostics.iter() {
        diagnostics.push(d)
        if d.is_error() { failed = true }
    }
    if failed { return Some(DumpedText(dump_hir_program(target, test, None, diagnostics))) }
    let (labels, texts) = labels_and_texts(sources, std_set)
    let mut tables = match items {
        Some(s) => check_items_shared(resolved.items, resolved.definitions, labels, texts, s)
        None => check_items(resolved.items, resolved.definitions, labels, texts)
    }
    if items.is_some() && tables.implements_on_a_type_it_does_not_own() { return None }
    tables.check_bodies(resolved.newline_splits)
    for d in tables.diagnostics.iter() { diagnostics.push(d) }
    Some(DumpedText(dump_hir_program(target, test, Some((resolved, tables)), diagnostics)))
}

// Name each test of a module of a package's `tests/`
// `<file stem>::<function>` (the driver's `name_tests`), as `nova test`'s
// inventory names it.
fn name_tests(tests: Vec<TestFn>, definitions: Definitions, modules: Vec<Loaded>) {
    for t in tests.iter() {
        if t.def_id < 0 || t.def_id >= definitions.defs.len() { continue }
        let item = match definitions.defs.at(t.def_id).kind {
            DefKindFn(i) => i
            _ => continue
        }
        let mid = definitions.item_module.at(item)
        if mid >= modules.len() { continue }
        let m = modules.at(mid)
        if m.test_file {
            let mut named = t
            named.name = "${module_name(m.path)}::${t.name}"
        }
    }
}
