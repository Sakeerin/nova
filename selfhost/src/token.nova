// The token kinds of the Nova language, and each kind's description: a
// port of crates/nova-lexer/src/token.rs, kind for kind and word for word,
// and of the `Spanned` and `Span` the Rust lexer takes from
// nova-diagnostics. A span is the byte offsets `start..end`; N lexes one
// file at a time, so it keeps no `FileId`.

/// Every token produced by the lexer (token.rs's `Token`).
pub type Token =
    // Keywords
    | Let
    | Mut
    | Const
    | Fn
    | Return
    | If
    | Else
    | While
    | For
    | In
    | Break
    | Continue
    | Match
    | Type
    | Record
    | Trait
    | Impl
    | Import
    | Module
    | Pub
    | Async
    | Await
    | Extern
    | Unsafe
    | True
    | False
    | As
    | Is
    | Where
    | With
    | SelfLower
    | SelfUpper
    // Punctuation
    | LParen
    | RParen
    | LBracket
    | RBracket
    | LBrace
    | RBrace
    | Comma
    | Semicolon
    | Colon
    | ColonColon
    | Arrow
    | FatArrow
    | Dot
    | DotDot
    | DotDotEq
    | At
    | Question
    // Comparison and assignment
    | Eq
    | EqEq
    | BangEq
    | Lt
    | LtEq
    | Gt
    | GtEq
    | AmpAmp
    | PipePipe
    | Bang
    // Arithmetic
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | PlusEq
    | MinusEq
    | StarEq
    | SlashEq
    | PercentEq
    // Bitwise
    | Amp
    | Pipe
    | Caret
    | Tilde
    | LtLt
    | GtGt
    | AmpEq
    | PipeEq
    | CaretEq
    | LtLtEq
    | GtGtEq
    // Literals
    | Int(Int)
    | Float(Float)
    | Char(Char)
    // String tokens (the state machine's output)
    | StrStart
    | StrPart(String)
    | StrEnd
    | InterpOpen
    | InterpClose
    | RawStr(String)
    // Identifiers and doc comments
    | Ident(String)
    | DocComment(String)
    // End of file
    | Eof

/// A byte range in the source: `start..end`.
pub record Span { pub start: Int, pub end: Int }

/// A token and its span (nova-diagnostics' `Spanned<Token>`).
pub record Spanned { pub value: Token, pub span: Span }

/// A token spanning `start..end`.
pub fn spanned(value: Token, start: Int, end: Int) -> Spanned {
    Spanned { value: value, span: Span { start: start, end: end } }
}

impl Token {
    /// The text the parser uses for this token in its messages
    /// (token.rs's `description`).
    pub fn description(self) -> String {
        match self {
            Let => "`let`"
            Mut => "`mut`"
            Const => "`const`"
            Fn => "`fn`"
            Return => "`return`"
            If => "`if`"
            Else => "`else`"
            While => "`while`"
            For => "`for`"
            In => "`in`"
            Break => "`break`"
            Continue => "`continue`"
            Match => "`match`"
            Type => "`type`"
            Record => "`record`"
            Trait => "`trait`"
            Impl => "`impl`"
            Import => "`import`"
            Module => "`module`"
            Pub => "`pub`"
            Async => "`async`"
            Await => "`await`"
            Extern => "`extern`"
            Unsafe => "`unsafe`"
            True => "`true`"
            False => "`false`"
            As => "`as`"
            Is => "`is`"
            Where => "`where`"
            With => "`with`"
            SelfLower => "`self`"
            SelfUpper => "`Self`"
            LParen => "`(`"
            RParen => "`)`"
            LBracket => "`[`"
            RBracket => "`]`"
            LBrace => "`{`"
            RBrace => "`}`"
            Comma => "`,`"
            Semicolon => "`;`"
            Colon => "`:`"
            ColonColon => "`::`"
            Arrow => "`->`"
            FatArrow => "`=>`"
            Dot => "`.`"
            DotDot => "`..`"
            DotDotEq => "`..=`"
            At => "`@`"
            Question => "`?`"
            Eq => "`=`"
            EqEq => "`==`"
            BangEq => "`!=`"
            Lt => "`<`"
            LtEq => "`<=`"
            Gt => "`>`"
            GtEq => "`>=`"
            AmpAmp => "`&&`"
            PipePipe => "`||`"
            Bang => "`!`"
            Plus => "`+`"
            Minus => "`-`"
            Star => "`*`"
            Slash => "`/`"
            Percent => "`%`"
            PlusEq => "`+=`"
            MinusEq => "`-=`"
            StarEq => "`*=`"
            SlashEq => "`/=`"
            PercentEq => "`%=`"
            Amp => "`&`"
            Pipe => "`|`"
            Caret => "`^`"
            Tilde => "`~`"
            LtLt => "`<<`"
            GtGt => "`>>`"
            AmpEq => "`&=`"
            PipeEq => "`|=`"
            CaretEq => "`^=`"
            LtLtEq => "`<<=`"
            GtGtEq => "`>>=`"
            Int(_) => "integer literal"
            Float(_) => "float literal"
            Char(_) => "char literal"
            StrStart => "`\"`"
            StrPart(_) => "string segment"
            StrEnd => "`\"`"
            InterpOpen => "`$" + "{`"
            InterpClose => "`}`"
            RawStr(_) => "raw string literal"
            Ident(_) => "identifier"
            DocComment(_) => "doc comment"
            Eof => "end of file"
        }
    }
}
