// The Nova server under benchmark. Not an example, and deliberately not named
// `03-http-server`: that number and name have drifted from what `examples/`
// holds, the drift is recorded as open in `nova-spec/00-MASTER-SPEC.md` and
// `nova-spec/60-EXAMPLES.md`, and taking the reserved name for something the
// spec does not describe would half-resolve it. See
// `docs/superpowers/specs/2026-09-02-phase-2-gate-benchmark-design.md` section 3.
//
// **The response bytes are built ONCE, outside the accept loop, and reused.**
// `Response::to_bytes` allocates, and hoisting it leaves the read-and-parse
// path as what a run against this server times. So any number taken against
// this server EXCLUDES response serialisation: it is a ceiling for a real
// server rather than a simulation of one. `docs/benchmarks/README.md` states
// that beside the figure.
//
// **What a run against this server does NOT settle: eager header
// materialisation.** `std/http`'s design spec
// (`docs/superpowers/specs/2026-09-01-std-http-request-parsing-design.md`
// section 7) puts that cost at "roughly 20 GC allocations for the header
// strings alone", about 18 microseconds -- but the sentence stating it is
// scoped "per request **with ten headers**", and the figure is linear in the
// header count. The generator drives one fixed request (`REQUEST` in
// `crates/nova-bench-http/src/main.rs`) carrying a single header,
// `Host: nova-bench`, so a run here pays roughly a tenth of that figure. The
// same spec section nominated "the first benchmark" as what would "confirm or
// refute it directly"; this is that benchmark, and at one header it does
// neither. **The header-materialisation risk that spec flagged is left
// exactly as unconfirmed as it was before this measurement**, and a
// header-carrying run is what would settle it.
//
// **This server never exits.** `block_on` cannot return while a task is parked,
// and the accept loop parks forever, so the benchmark procedure kills the
// process. There is no shutdown path and its absence is not an oversight.
//
// **It logs nothing per request.** Per-request output at these rates would
// become the bottleneck we accidentally measured.
//
// One task accepts and one task serves each connection, which is forced rather
// than chosen: staging two socket waits in a single poll aborts the process
// (`stage_park` in `crates/nova-runtime/src/task.rs`), so the task parked in
// `accept` cannot also read a connection.

async fn serve(conn: TcpStream, wire: Bytes) {
    // Keep-alive: one connection, requests until the peer stops or errs.
    let total = wire.len()
    while true {
        match read_request(conn, Limits::default()).await {
            Ok(req) => {
                match conn.write(wire).await {
                    Ok(n) => {
                        // `std/net`'s `write` is one non-blocking attempt, not
                        // a `write_all` loop (`write_stream`'s own doc comment
                        // in `std/net/lib.nova` says so): a short write needs
                        // a retry. `write_response` in `std/http/lib.nova`
                        // carries the same retry loop, over
                        // `wire.slice(sent, total)` -- writing `wire` whole
                        // first here, rather than going through
                        // `write_response`, is what keeps the common case
                        // allocation-free, since `wire` is pre-serialised once
                        // outside the accept loop and only a short write ever
                        // reaches the slicing below.
                        //
                        // Unexercised by this project's suite: a response
                        // this small does not get a short write on loopback,
                        // so nothing here drives this loop. It is written for
                        // correctness under Task 3's real load, not pinned by
                        // a fixture.
                        if n < total {
                            let mut sent = n
                            let mut write_ok = true
                            while sent < total {
                                match conn.write(wire.slice(sent, total)).await {
                                    Ok(m) => {
                                        // No progress must not be retried
                                        // forever -- that hangs rather than
                                        // fails.
                                        if m <= 0 {
                                            write_ok = false
                                            break
                                        }
                                        sent = sent + m
                                    }
                                    Err(e) => {
                                        write_ok = false
                                        break
                                    }
                                }
                            }
                            if !write_ok {
                                break
                            }
                        }
                    }
                    Err(e) => break
                }
            }
            Err(e) => break
        }
    }
    let _ = conn.close().await
}

async fn main() {
    let l = match bind("127.0.0.1:0") {
        Ok(l) => l
        Err(e) => panic("bind: ${e.message}")
    }
    let port = match l.local_port() {
        Ok(p) => p
        Err(e) => panic("local_port: ${e.message}")
    }
    // The one line this server prints. The benchmark procedure reads it by eye
    // and the smoke test parses it from stdout, so its shape is load-bearing.
    println("listening on 127.0.0.1:${port}")

    let wire = Response::text(200, "{\"ok\":true}").to_bytes()

    while true {
        match l.accept().await {
            Ok(conn) => {
                let h = spawn(serve(conn, wire))
            }
            Err(e) => break
        }
    }
}
