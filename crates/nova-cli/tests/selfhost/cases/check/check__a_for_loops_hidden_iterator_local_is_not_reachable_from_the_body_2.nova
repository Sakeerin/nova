trait It { type Item
 fn next(mut self) -> Option<Self::Item> }
record Once { v: Int, done: Bool }
impl It for Once { type Item = Int
fn next(mut self) -> Option<Int> { if self.done { None } else { self.done = true
 Some(self.v) } } }
fn make_once() -> Once { Once { v: 7, done: false } }
fn main() { let __it = 99
for x in make_once() { println("${x} ${__it}") }
println("${__it}") }