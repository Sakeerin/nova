record Pair<A, B> { a: A
 b: B }
trait Chain {
 type A0
 type A1
 type A2
 type A3
 type A4
 fn put(self, y: Self::A0) -> Int }
record W { v: Int }
impl Chain for W {
 type A0 = Pair<Self::A1, Self::A1>
 type A1 = Pair<Self::A2, Self::A2>
 type A2 = Pair<Self::A3, Self::A3>
 type A3 = Pair<Self::A4, Self::A4>
 type A4 = Int
fn put(self, y: Self::A0) -> Int { 1 } }
fn main() { }