record Point { x: Int, y: Int }
type Shape =
  | Dot
  | Line(Int)
const LIMIT: Int = 3
fn measure(s: Shape) -> Int {
    match s {
        Shap::Dot => 0
        Shape::Lin(n) => n
        _ => 1
    }
}
