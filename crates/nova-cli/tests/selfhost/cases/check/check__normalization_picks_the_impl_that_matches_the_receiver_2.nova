trait It { type Item
 fn get_item(self) -> Self::Item }
record W<T> { v: T }
record K { k: Bool }
impl<T> It for W<T> { type Item = T
fn get_item(self) -> Self::Item { self.v } }
impl It for K { type Item = Bool
fn get_item(self) -> Self::Item { self.k } }
fn main() { let w = W { v: 7 }
let b: Bool = w.get_item()
 println("${b}") }