type Opt<T> =
  | Yes(T)
  | No
type Res<T, E> =
  | Win(T)
  | Fail(E)
type Tok =
  | Ident(String)
  | Num(Int)
  | Sym(Char)
  | Eof
type Wrap =
  | Wrap(Int, String)
fn f() -> Int {
    let (a, (b, _)) = (1, (2, "x"))
    let Wrap(n, s) = Wrap(3, "y")
    let mut (c, d) = (4, 5)
    c += d
    a + b + n + c + s.len()
}
fn main() {}
