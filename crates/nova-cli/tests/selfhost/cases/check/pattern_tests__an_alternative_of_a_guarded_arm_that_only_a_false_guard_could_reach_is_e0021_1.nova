type Opt<T> =
  | Yes(T)
  | No
type Res<T, E> =
  | Win(T)
  | Fail(E)
type Tok =
  | Ident(String)
  | Num(Int)
  | Sym(Char)
  | Eof
type Wrap =
  | Wrap(Int, String)
fn f(p: (Int, Int)) -> String {
    match p {
        (a, _) | (_, a) if a > 5 => "big"
        _ => "small"
    }
}
fn main() {}
