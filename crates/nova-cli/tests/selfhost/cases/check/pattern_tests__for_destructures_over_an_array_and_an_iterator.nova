type Opt<T> =
  | Yes(T)
  | No
type Res<T, E> =
  | Win(T)
  | Fail(E)
type Tok =
  | Ident(String)
  | Num(Int)
  | Sym(Char)
  | Eof
type Wrap =
  | Wrap(Int, String)
fn f(xs: [(Int, String)]) -> Int {
    let mut n = 0
    for (i, s) in xs {
        n += i + s.len()
    }
    for x in [1, 2, 3] {
        n += x
    }
    for _ in xs {
        n += 1
    }
    n
}
fn main() {}
