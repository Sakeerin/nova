fn main() {
    block_on(go())
}

async fn go() {
    let p = "${temp_dir()}/nova_fs_write_then_read_8a41.txt"
    match write_string(p, "hello\nworld").await {
        Ok(_) => println("wrote")
        Err(e) => println("write failed: ${e.message}")
    }
    match read_to_string(p).await {
        Ok(s) => println(s)
        Err(e) => println("read failed: ${e.message}")
    }
}
