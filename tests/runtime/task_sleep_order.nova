async fn slow() {
    sleep(Duration::from_millis(200)).await
    println("slow")
}

async fn quick() {
    sleep(Duration::from_millis(20)).await
    println("quick")
}

fn main() {
    block_on(both())
}

async fn both() {
    let a = spawn(slow())
    let b = spawn(quick())
    a.join().await
    b.join().await
}
