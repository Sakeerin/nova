// The portable failure modes `open` reaches: `create_new` against a path
// that already exists is `AlreadyExists`, and a path under a missing parent
// directory is `NotFound`. Both asserted unconditionally, on every CI
// platform this project targets.
//
// The directory-open-for-reading check used to live here too, but it is
// genuinely platform-divergent (Windows-measured `PermissionDenied`; very
// plausibly a POSIX success at the `open` step itself, per
// `file_open_dir.nova`'s own doc comment) -- bundling it with these two
// portable checks in one golden `.stdout` meant the whole fixture, portable
// checks included, ran on Windows only (review, fix round 1, Important 1).
// Moved out to `file_open_dir.nova` so these two run everywhere.
//
// `message` is platform text, so only `kind` is asserted -- the same
// treatment `fs_io_types.nova` already applies.
fn kind_name(k: IoErrorKind) -> String {
    match k {
        NotFound => "NotFound"
        PermissionDenied => "PermissionDenied"
        AlreadyExists => "AlreadyExists"
        InvalidData => "InvalidData"
        Interrupted => "Interrupted"
        TimedOut => "TimedOut"
        ConnectionRefused => "ConnectionRefused"
        Other => "Other"
    }
}

async fn main() {
    let base = "${temp_dir()}/nova_file_errors_probe"
    let _ = remove_dir_all(base).await
    let _ = create_dir_all(base).await

    // `create_new` has no named constructor, since it is an exotic
    // combination none of `reading`/`writing`/`appending` is -- built with
    // `OpenOptions::default()` plus field assignment instead.
    let existing = "${base}/exists.txt"
    let _ = write_string(existing, "x").await
    let mut create_new_opts = OpenOptions::default()
    create_new_opts.write = true
    create_new_opts.create_new = true
    match open(existing, create_new_opts).await {
        Ok(_) => println("create_new: unexpectedly ok")
        Err(e) => println("create_new: ${kind_name(e.kind)}")
    }

    let missing_parent = "${base}/nonexistent_subdir/inner.txt"
    match open(missing_parent, OpenOptions::writing()).await {
        Ok(_) => println("missing_parent: unexpectedly ok")
        Err(e) => println("missing_parent: ${kind_name(e.kind)}")
    }

    let _ = remove_dir_all(base).await
}
