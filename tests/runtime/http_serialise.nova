// Round trip: parse a request, build a response, and compare the serialised
// bytes to a golden.
//
// The golden is the response text with its CRLFs written as `\r\n` escapes in
// this file, the same decision every fixture in this group makes: HTTP is
// CRLF-delimited, this working copy is CRLF, and byte-exactness is
// load-bearing here, so git's line-ending handling is given nothing to
// rewrite. The printed output below is ordinary LF text.

fn main() {
    let raw = bytes_from_string("GET /hi HTTP/1.1\r\nHost: a.example\r\nContent-Length: 0\r\n\r\n")
    match parse_request_head(raw, Limits::default()) {
        // Two levels of `match`, not one: `Ok(Some(req))` is
        // `E0900: nested patterns inside variants are not supported yet`.
        // Measured on this tree; no std module uses a nested pattern either.
        Ok(maybe) => match maybe {
            Some(req) => {
                println("path ${req.path}")
                println("host ${header_or(req, "host", "<missing>")}")
                println("content-length ${header_or(req, "content-length", "<missing>")}")
                // Sent as `Host:`, looked up as `host`: HTTP field names are
                // case-insensitive and this module lower-cases on insert.
                let resp = Response::text(200, "hi")
                let wire = resp.to_bytes()
                // `Response::text` sets two headers, and two headers' relative
                // order on the wire is `Map`'s per-process bucket order (see
                // `Response`'s own doc comment in std/http/lib.nova) --
                // measured directly: repeated runs of this fixture, as plain
                // separate processes, printed `wire matches false` about as
                // often as `true` when this compared the whole buffer against
                // one fixed ordering with a single `.eq()`. `matches` below
                // checks the parts a header order cannot change instead: the
                // exact status line, the exact tail, that both complete
                // header lines occur somewhere between them, and the exact
                // total length. All five terms are needed, not just the
                // first four: `contains` does not care what else is in the
                // buffer and the two edge `.eq()`s only look at the
                // fixed-size ends, so without `length_ok` those four would
                // still pass if `wire` carried extra bytes somewhere in the
                // middle alongside the two real header lines.
                //
                // `tail` is six bytes, not four: `"\r\n\r\nhi"` is the blank
                // line and the body, but its own leading `\r\n` belongs to
                // whichever header line lands last. `to_bytes` writes each
                // header line's own trailing CRLF and then appends one more
                // CRLF for the blank line, so the last header's CRLF and the
                // blank line's CRLF sit back to back -- `tail` captures both.
                // `length_ok` below accounts for that by subtracting 2 from
                // the two header lines' own lengths: they are 19 and 41 bytes
                // name-to-CRLF inclusive, but one of those two CRLFs is
                // already charged to `tail`, not to the header line itself.
                //
                // This has zero slack only for this exact response -- these
                // two header values and this two-byte body. If
                // `Response::text`'s headers or the body text here ever
                // change, `head_line`, `tail`, the two header-line literals
                // below, and `length_ok`'s arithmetic all need re-deriving
                // together, not just the golden.
                let head_line = bytes_from_string("HTTP/1.1 200 OK\r\n")
                let tail = bytes_from_string("\r\n\r\nhi")
                let length_header_line = bytes_from_string("content-length: 2\r\n")
                let type_header_line = bytes_from_string("content-type: text/plain; charset=utf-8\r\n")
                let starts_right = wire.slice(0, head_line.len()).eq(head_line)
                let ends_right = wire.slice(wire.len() - tail.len(), wire.len()).eq(tail)
                let has_length_header = wire.contains(length_header_line)
                let has_type_header = wire.contains(type_header_line)
                let expected_len = head_line.len() + length_header_line.len() + type_header_line.len() + tail.len() - 2
                let length_ok = wire.len() == expected_len
                let matches = starts_right && ends_right && has_length_header && has_type_header && length_ok
                println("wire matches ${matches}")
                println("wire len ${wire.len()}")

                // `Response::ok` sets exactly one header, so -- unlike
                // `Response::text` above -- there is no second header to land
                // in a different order, and a plain whole-buffer `.eq()` is
                // exhaustive on its own with no parts-checking needed. This
                // is the fixture's one byte-exact check on a full response;
                // `Response::text` above cannot have one, for the reason
                // explained there.
                let ok_wire = Response::ok(bytes_from_string("hi")).to_bytes()
                let ok_expected = bytes_from_string("HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nhi")
                println("ok wire matches ${ok_wire.eq(ok_expected)}")

                let nf = Response::not_found().to_bytes()
                println("not_found len ${nf.len()}")
            }
            None => println("unexpectedly partial")
        }
        Err(e) => println("unexpectedly rejected")
    }
}

fn header_or(req: Request, name: String, fallback: String) -> String {
    match req.headers.get(name) {
        Some(v) => v
        None => fallback
    }
}
