const MAX: Int = 100
const GREETING: String = "hello"
const DOUBLE_MAX: Int = MAX * 2
const PI_APPROX: Float = 3.14

fn scaled(n: Int) -> Int {
    n * MAX
}

fn main() {
    println("MAX = ${MAX}")
    println("GREETING = ${GREETING}")
    println("DOUBLE_MAX = ${DOUBLE_MAX}")
    println("PI_APPROX = ${PI_APPROX}")
    println("scaled(3) = ${scaled(3)}")

    // A constant used in an expression and a condition.
    let mut total = 0
    for i in 0..5 {
        total = total + MAX
    }
    println("total = ${total}")

    if total > DOUBLE_MAX {
        println("total exceeds double max")
    }
}
