// Known-vector fixture for `std/crypto`'s digests.
//
// **Provenance:** every expected value here was cross-checked against
// Python's `hashlib`/`hmac` before being written down. The SHA-256 of "abc"
// and the HMAC case are also widely published, as FIPS 180-4's worked
// example and RFC 4231's first case; **this project has verified the
// cross-check, not the documents**, and states which claim it is making so a
// later reader can upgrade it.
//
// This fixture is what pins the operation constants. The roster duplicated
// between `std/crypto/lib.nova` and `crates/nova-runtime/src/crypto.rs` is
// `OP_SHA256`, `OP_SHA512`, `OP_HMAC_SHA256` and `OP_HMAC_SHA256_VERIFY`, and
// every one of them has known-vector lines of its own below: `OP_SHA256` the
// two `sha256` lines, `OP_SHA512` the two `sha512` lines, `OP_HMAC_SHA256` the
// `hmac` line, `OP_HMAC_SHA256_VERIFY` the four `verify` lines. That mapping
// is read off the dispatch rather than sampled -- one `op ==
// OP_HMAC_SHA256_VERIFY` branch ahead of a three-arm `match` and a wildcard --
// so it is the check to re-derive per constant, not a count to trust.
//
// **What a swap costs is not always a digest.** Trading `OP_HMAC_SHA256` with
// `OP_HMAC_SHA256_VERIFY` sends `hmac_sha256` into the tag-check branch, which
// stashes no payload at all, so the `hmac` line prints an *empty* digest; and
// it sends `hmac_sha256_verify` into the signing arm, whose status is 0
// whatever the tag was, so every `verify` line reads `true` and the three
// expecting `false` go wrong. That pair was run on each side of the boundary
// in turn and the output was identical both times. The `OP_SHA256`/`OP_SHA512`
// pair moves the four digest lines. No claim is made here about every pair a
// reader could form from the roster -- the mapping above is what says which
// lines any given swap would move.
//
// **Hex, not `to_ints()`.** `String::char_at` returns `Option<Char>`, not
// `Char`, so it cannot sit directly in an interpolation the way a hex digit
// needs to. `String::slice(self, start, end)` returns a plain `String`, so
// `digits.slice(v / 16, v / 16 + 1)` is the one-character hex digit with no
// `Option` to unwrap and no extra `match` in the loop below.

fn hex(b: Bytes) -> String {
    let digits = "0123456789abcdef"
    let ints = b.to_ints()
    let mut out = ""
    let mut i = 0
    while i < ints.len() {
        let v = ints[i]
        out = "${out}${digits.slice(v / 16, v / 16 + 1)}${digits.slice(v % 16, v % 16 + 1)}"
        i = i + 1
    }
    out
}

fn main() {
    println("sha256 empty ${hex(sha256(bytes_from_string("")))}")
    println("sha256 abc ${hex(sha256(bytes_from_string("abc")))}")
    println("sha512 abc len ${sha512(bytes_from_string("abc")).len()}")
    println("sha512 abc head ${hex(sha512(bytes_from_string("abc")).slice(0, 8))}")

    let key = bytes_from_ints([11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11])
    let data = bytes_from_string("Hi There")
    let tag = hmac_sha256(key, data)
    println("hmac ${hex(tag)}")
    println("verify good ${hmac_sha256_verify(key, data, tag)}")
    println("verify wrong data ${hmac_sha256_verify(key, bytes_from_string("Hi there"), tag)}")
    println("verify truncated ${hmac_sha256_verify(key, data, tag.slice(0, 31))}")
    println("verify empty tag ${hmac_sha256_verify(key, data, bytes_from_ints([]))}")
}
