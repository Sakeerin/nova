// A short sleep well inside a long timeout: the inner future wins the race,
// so `timeout` reports `Ok` and this prints which branch ran, not an
// ordering -- an order-only assertion is scale-invariant and could not fail
// on a unit error.
async fn work() -> Int {
    sleep(Duration::from_millis(20)).await
    1
}

async fn main() {
    match timeout(Duration::from_secs(30), work()).await {
        Ok(_) => println("ok")
        Err(_) => println("elapsed")
    }
}
