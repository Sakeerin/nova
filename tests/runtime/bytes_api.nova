fn main() {
    let b = bytes_from_ints([104, 105, 255])
    println("${b.len()}")
    match b.to_string() {
        Some(s) => println("unexpectedly utf8: ${s}")
        None => println("not utf8")
    }
    println("${b.byte_at(2).unwrap_or(0)}")
    println("${b.byte_at(3).is_none()}")
    let hi = b.slice(0, 2)
    match hi.to_string() {
        Some(s) => println(s)
        None => println("slice not utf8")
    }
    let joined = hi.concat(bytes_from_string("!"))
    match joined.to_string() {
        Some(s) => println(s)
        None => println("joined not utf8")
    }
    // `slice`'s two bounds clamp independently. An `end` past the buffer's
    // length must clamp to the buffer's own length rather than reading past
    // it: on a 3-byte buffer, a missing clamp there is a native Rust
    // slice-index PANIC inside the intrinsic, not merely a wrong value --
    // and the intrinsic is reachable from async code, so that panic would
    // cross a generated poll boundary.
    println("${b.slice(1, 100).eq(bytes_from_ints([105, 255]))}")
    // A `start` past the length must clamp too, independently of `end` --
    // here `end` is past the length as well, exercising the same
    // missing-clamp hazard from a different `start`.
    println("${b.slice(100, 200).len()}")
    println("${bytes_from_ints(b.to_ints()).eq(b)}")
    // Two equal-length buffers differing in exactly one byte: a length-only
    // `eq` (comparing `len` alone, never the bytes) would wrongly call these
    // equal, unlike the line above, where the reconstructed buffer is also
    // byte-for-byte identical and so cannot tell a real comparison from one
    // that only checks length.
    println("${bytes_from_ints([1, 2, 3]).eq(bytes_from_ints([1, 2, 4]))}")
    println("${b.index_of(bytes_from_string("i")).unwrap_or(-1)}")
    // A repeated, overlapping needle: the byte-domain mirror of
    // tests/runtime/strings.nova's "aaa".index_of("aa") (expects 0). "aa"
    // also matches at index 1 in "aaa", so this is what would catch an
    // `index_of` that returned the LAST match rather than the first.
    println("${bytes_from_ints([97, 97, 97]).index_of(bytes_from_ints([97, 97])).unwrap_or(-1)}")
    println("${b.contains(bytes_from_string("z"))}")
}
