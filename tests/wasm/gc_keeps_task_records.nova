// A record only a task reaches survives the collections around it (spec
// docs/superpowers/specs/2026-10-15-phase-4-1-the-language-on-wasm-design.md
// §9.3). Run under NOVA_GC_STRESS, the collector runs at the end of every
// turn, while `holder` keeps its record across 50 of them and `main` makes
// garbage.

record Kept { v: Int, name: String, parts: [Int] }

fn churn(n: Int) -> Int {
    let mut sum = 0
    let mut i = 0
    while i < n {
        let parts = [i, i + 1, i + 2]
        sum = sum + parts[2] - parts[0]
        i = i + 1
    }
    sum
}

async fn holder(v: Int) -> Int {
    let kept = Kept { v: v, name: "kept ${v * 2}", parts: [v, v + 1, v + 2] }
    let mut turn = 0
    while turn < 50 {
        sleep(Duration::from_millis(1)).await
        turn = turn + 1
    }
    println("${kept.name} ${kept.parts[0] + kept.parts[1] + kept.parts[2]}")
    kept.v
}

async fn main() {
    let h = spawn(holder(21))
    let mut junk = 0
    let mut turn = 0
    while turn < 50 {
        junk = junk + churn(500)
        sleep(Duration::from_millis(1)).await
        turn = turn + 1
    }
    let v = h.join().await
    println("joined ${v}, junk ${junk}")
}
