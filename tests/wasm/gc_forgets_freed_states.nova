// A freed state names no old task (spec
// docs/superpowers/specs/2026-10-15-phase-4-1-the-language-on-wasm-design.md
// §4.2): the WASM counterpart of `tests/runtime/recycled_task_state.nova`.
// Two hundred spawned tasks finish and are released; under NOVA_GC_STRESS
// the turns' collections free their states, and a future built after them
// takes one of those addresses. Joining it without spawning it must abort
// with "never spawned", as natively, and not find an old task there.

async fn one() -> Int { 1 }

async fn main() {
    let mut i = 0
    let mut sum = 0
    while i < 200 {
        let h = spawn(one())
        sum = sum + h.join().await
        i = i + 1
    }
    sleep(Duration::from_millis(1)).await
    sleep(Duration::from_millis(1)).await
    let g = JoinHandle { fut: one() }
    let v = g.join().await
    println("misresolved value ${v} sum ${sum}")
}
